 </div> </section> <style> .lumi-rs,.lumi-rs *,.lumi-rs *::before,.lumi-rs *::after{box-sizing:border-box !important;} /* ===== NEUTRALISE old override's inset so the 100vw breakout centres correctly ===== */ .shop-product-layout .shop-product-info, .product__info-wrapper{padding-left:0 !important;padding-right:0 !important;} /* mobile — the old override also insets the grid wrapper; zero it so this full-width band centres (desktop untouched) */ @media (max-width:749px){ .product.grid, .product__info-container, .product__info-wrapper, .shop-product-layout, .shop-product-info{padding-left:0 !important;padding-right:0 !important;} } .lumi-rs{ --lumi-font:'Lato','Calibri',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; width:100vw !important;max-width:100vw !important; margin-left:calc(50% - 50vw) !important;margin-right:calc(50% - 50vw) !important; margin-top:0 !important;margin-bottom:0 !important;padding:16px 0 0 !important; background:#fff !important;font-family:var(--lumi-font) !important;-webkit-font-smoothing:antialiased !important;overflow:hidden !important; } .lumi-rs img{display:block !important;max-width:100% !important;} .lumi-rs *{font-family:var(--lumi-font) !important;} .lumi-rs__head{text-align:center !important;padding:0 16px !important;margin:0 0 18px !important;} .lumi-rs__stars{display:flex !important;justify-content:center !important;gap:2px !important;margin:0 0 10px !important;} .lumi-rs__title{margin:0 0 8px !important;font-size:29px !important;font-weight:700 !important;color:#23232a !important;-webkit-text-fill-color:#23232a !important;line-height:1.2 !important;} .lumi-rs__title span{color:#2f2f86 !important;-webkit-text-fill-color:#2f2f86 !important;} .lumi-rs__sub{margin:0 !important;font-size:16px !important;color:#55535e !important;-webkit-text-fill-color:#55535e !important;} /* ===== MARQUEE — square + more spaced ===== */ .lumi-rs__marquee{position:relative !important;width:100% !important;overflow:hidden !important;margin:0 0 24px !important;} .lumi-rs__track{display:flex !important;width:max-content !important;animation:lumiRsScroll 46s linear infinite !important;will-change:transform !important;backface-visibility:hidden !important;-webkit-backface-visibility:hidden !important;} .lumi-rs__group{display:flex !important;flex-shrink:0 !important;} .lumi-rs__cell{flex:0 0 auto !important;width:190px !important;height:190px !important;padding:0 16px !important;} .lumi-rs__cell img{width:100% !important;height:100% !important;aspect-ratio:1/1 !important;object-fit:cover !important;border-radius:12px !important;} @keyframes lumiRsScroll{0%{transform:translate3d(0,0,0);}100%{transform:translate3d(-50%,0,0);}} @media (prefers-reduced-motion:reduce){.lumi-rs__track{animation:none !important;}} /* ===== REVIEWS ===== */ .lumi-rs__reviews-wrap{max-width:1200px !important;margin:0 auto !important;padding:0 16px 20px !important;} .lumi-rs__reviews{display:flex !important;gap:20px !important;overflow-x:auto !important;scroll-snap-type:x mandatory !important;scrollbar-width:none !important;-webkit-overflow-scrolling:touch !important;padding:4px !important;} .lumi-rs__reviews::-webkit-scrollbar{display:none !important;} .lumi-rs__review{flex:0 0 100% !important;scroll-snap-align:start !important;background:#f9f9fb !important;border:1px solid #eef0f4 !important;border-radius:6px !important;padding:22px !important;display:flex !important;flex-direction:column !important;} .lumi-rs__rstars{display:flex !important;gap:1px !important;margin:0 0 12px !important;} .lumi-rs__rtitle{margin:0 0 10px !important;font-size:19px !important;font-weight:700 !important;color:#23232a !important;-webkit-text-fill-color:#23232a !important;} .lumi-rs__rbody{margin:0 0 18px !important;font-size:15px !important;line-height:1.55 !important;color:#55535e !important;-webkit-text-fill-color:#55535e !important;font-weight:400 !important;} .lumi-rs__rname{margin-top:auto !important;background:#fff !important;border-radius:8px !important;padding:9px 13px !important;box-shadow:0 1px 4px rgba(0,0,0,.06) !important;display:inline-flex !important;flex-direction:column !important;align-self:flex-start !important;} .lumi-rs__rname b{font-size:15px !important;font-weight:700 !important;color:#23232a !important;-webkit-text-fill-color:#23232a !important;} .lumi-rs__rname span{font-size:12px !important;color:#6f6d78 !important;-webkit-text-fill-color:#6f6d78 !important;} /* ===== NAV — wider + bigger ===== */ .lumi-rs__nav{display:flex !important;align-items:center !important;justify-content:center !important;gap:22px !important;margin:20px 0 0 !important;} .lumi-rs__arrow{width:46px !important;height:46px !important;display:flex !important;align-items:center !important;justify-content:center !important;border:1px solid #e2e2ea !important;background:#fff !important;color:#23232a !important;cursor:pointer !important;border-radius:50% !important;transition:background .2s ease !important;} .lumi-rs__arrow:hover{background:#f4f5f9 !important;} .lumi-rs__dots{display:flex !important;gap:9px !important;} .lumi-rs__dots button{width:10px !important;height:10px !important;border:0 !important;border-radius:50% !important;background:#d4d7e2 !important;cursor:pointer !important;padding:0 !important;} .lumi-rs__dots button.is-active{background:#2f6fed !important;} @media (min-width:750px){ .lumi-rs__title{font-size:38px !important;} .lumi-rs__sub{font-size:17px !important;} .lumi-rs__cell{width:215px !important;height:215px !important;padding:0 18px !important;} .lumi-rs__review{flex:0 0 calc((100% - 40px) / 3) !important;} .lumi-rs__rtitle{font-size:20px !important;} .lumi-rs__rbody{font-size:15px !important;} .lumi-rs__arrow{width:50px !important;height:50px !important;} .lumi-rs__nav{gap:26px !important;} } </style> <script> (function(){ function init(root){ if(root.hasAttribute('data-rs-ready'))return; root.setAttribute('data-rs-ready',''); var track=root.querySelector('[data-rs-track]'); var reviews=Array.prototype.slice.call(root.querySelectorAll('.lumi-rs__review')); var dotsWrap=root.querySelector('[data-rs-dots]'); var prev=root.querySelector('[data-rs-prev]'), next=root.querySelector('[data-rs-next]'); if(!track||!reviews.length)return; function perView(){return window.matchMedia('(min-width:750px)').matches?3:1;} function pages(){return Math.max(1,reviews.length-perView()+1);} function step(){var r=reviews[0].getBoundingClientRect().width;var cs=getComputedStyle(track);var gap=parseFloat(cs.columnGap||cs.gap||'20')||20;return r+gap;} function buildDots(){ dotsWrap.innerHTML=''; for(var i=0;i<pages();i++){var b=document.createElement('button');if(i===0)b.className='is-active';(function(idx){b.addEventListener('click',function(){track.scrollTo({left:Math.round(step()*idx),behavior:'smooth'});});})(i);dotsWrap.appendChild(b);} } function updateDots(){var s=step()||1;var idx=Math.round(track.scrollLeft/s);var ds=dotsWrap.children;for(var i=0;i<ds.length;i++)ds[i].className=(i===idx?'is-active':'');} buildDots(); var ticking=false; track.addEventListener('scroll',function(){if(ticking)return;ticking=true;requestAnimationFrame(function(){updateDots();ticking=false;});},{passive:true}); if(prev)prev.addEventListener('click',function(){track.scrollBy({left:-step(),behavior:'smooth'});}); if(next)next.addEventListener('click',function(){track.scrollBy({left:step(),behavior:'smooth'});}); window.addEventListener('resize',function(){buildDots();updateDots();}); } function boot(){document.querySelectorAll('[data-lumi-rs]').forEach(init);} if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',boot);}else{boot();} })(); </script>