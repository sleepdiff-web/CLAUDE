{%- comment -%}
  "Why Trust" card: heading, four small badge boxes and a two-column tick list, over a photo with a colour fade.
  EDIT YOUR CONTENT BELOW. mb_badges = the four badge boxes and mb_list = the tick list, put @@ on its own line between entries.
  mb_bg_img = the background photo and mb_icon_1 to mb_icon_4 = the four badge icons. They start as Metabolae's own files so the card is an exact copy straight away.
  Before you go live, download them, upload them to your own store (Content > Files) and paste your links here instead, so they keep working and are yours. Leave '' for a plain colour card and built-in icons.
  mb_bg_color = card colour behind the photo. mb_grad_top / mb_grad_bottom = the red tint over the photo (top to bottom). Both are #943434: solid at the top, 60% at the bottom so the photo shows through. Lower the last number in mb_grad_bottom to show more photo, raise it to show less. mb_text_color = all text and icons.
  The tint and photo layering are locked with inline !important, so theme CSS cannot hide the tint.
  The card is square on phones and on desktop (at least as tall as it is wide; a card wider than 720px stops growing taller) and everything inside scales with the card width.
  mb_animate = true for the fade-in-on-scroll effect, false to show everything straight away.
  mb_respect_motion = false so the fade-in always plays (like Metabolae); set it to true to skip it for people whose device has animations turned off.
  mb_top / mb_bottom = space above and below (merges with neighbouring blocks, never doubled).
  Do not use a straight apostrophe (') in the text, use &#39; instead.
{%- endcomment -%}
{%- assign mb_heading = 'Why Trust Metabolae' -%}
{%- assign mb_bg_img = 'https://metabolae.com/cdn/shop/files/metabolae-doctor-information-product.webp?v=1773614626' -%}
{%- assign mb_bg_color = '#943434' -%}
{%- assign mb_grad_top = 'rgba(148, 52, 52, 1)' -%}
{%- assign mb_grad_bottom = 'rgba(148, 52, 52, .6)' -%}
{%- assign mb_text_color = '#ffffff' -%}
{%- assign mb_icon_1 = 'https://metabolae.com/cdn/shop/files/metabolae-clinically-backed-icon.webp?v=1784799253' -%}
{%- assign mb_icon_2 = 'https://metabolae.com/cdn/shop/files/metabolae-3rdparty-icon.webp?v=1784799253' -%}
{%- assign mb_icon_3 = 'https://metabolae.com/cdn/shop/files/metabolae-clean-assets-icon.webp?v=1784799252' -%}
{%- assign mb_icon_4 = 'https://metabolae.com/cdn/shop/files/metabolae-globally-icon.webp?v=1784799252' -%}
{%- assign mb_animate = true -%}
{%- assign mb_respect_motion = false -%}
{%- assign mb_top = '12px' -%}
{%- assign mb_bottom = '12px' -%}
{%- capture mb_badges -%}
Clinically Backed Formulas
@@
Third-Party Tested
@@
Clean Formulas
@@
Globally Trusted Facilities
{%- endcapture -%}
{%- capture mb_list -%}
True Ceylon Cinnamon
@@
12:1 Concentrated Extract
@@
MCT Oil Delivery System
@@
Gentle on the Stomach
@@
Non-GMO &amp; Gluten-Free
@@
Third-Party Tested
{%- endcapture -%}
{%- assign mb_badge_items = mb_badges | split: '@@' -%}
{%- assign mb_list_items = mb_list | split: '@@' -%}
{%- assign mb_icons = mb_icon_1 | append: '@@' | append: mb_icon_2 | append: '@@' | append: mb_icon_3 | append: '@@' | append: mb_icon_4 | split: '@@' -%}
{%- assign q = '?' -%}{%- if mb_bg_img contains '?' -%}{%- assign q = '&amp;' -%}{%- endif -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.mb-wt{margin:var(--mb-wt-mt,12px) 0 var(--mb-wt-mb,12px);font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:500;line-height:1.8;letter-spacing:.6px;text-align:left}
.mb-wt__card{position:relative;box-sizing:border-box;border-radius:12px;overflow:hidden;background:var(--mb-wt-bg,#8e5539)}
.mb-wt__bg{position:absolute;inset:0;display:block;width:100%;height:100%;max-width:none;object-fit:cover;object-position:center center;z-index:0}
.mb-wt__ov{position:absolute;inset:0;z-index:1}
.mb-wt__in{position:relative;z-index:2;box-sizing:border-box;padding:48px 24px;text-align:center}
.mb-wt__h{margin:0 0 24px;padding:0;font-family:Poppins,sans-serif;font-size:32px;font-style:normal;font-weight:400;line-height:1.2;letter-spacing:.5px;text-transform:none;word-break:break-word}
.mb-wt__row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin:32px 0 40px}
.mb-wt__bc{display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;padding:24px 12px;border:1px solid rgba(255,255,255,.4);border-radius:12px;background-color:rgba(255,255,255,.04);text-align:center}
.mb-wt__bc:hover{background-color:rgba(255,255,255,.08);border-color:rgba(255,255,255,.8);transform:translateY(-2px)!important}
.mb-wt__bi{display:flex;align-items:center;justify-content:center;width:44px;height:44px;margin-bottom:12px}
.mb-wt__bi svg,.mb-wt__bi img{display:block!important;width:100%!important;height:100%!important}
.mb-wt__bi img{object-fit:contain!important}
.mb-wt__bt{font-size:11px;font-weight:500;line-height:1.35;letter-spacing:.8px;text-transform:uppercase}
.mb-wt__g{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:0 0 16px;text-align:left}
.mb-wt__it{display:flex;align-items:center;gap:12px}
.mb-wt__ic{flex-shrink:0;width:20px;height:20px}
.mb-wt__tx{font-size:18px;line-height:1.25;font-weight:500}
.mb-wt .mb-wt__h,.mb-wt .mb-wt__bt,.mb-wt .mb-wt__tx,.mb-wt .mb-wt__bi,.mb-wt .mb-wt__ic{color:var(--mb-wt-tx,#fff)!important;-webkit-text-fill-color:var(--mb-wt-tx,#fff)!important}
.mb-wt--js .mb-wt__h,.mb-wt--js .mb-wt__bc,.mb-wt--js .mb-wt__it{opacity:0;transform:translateY(20px);transition:opacity .8s cubic-bezier(.2,.8,.2,1),transform .8s cubic-bezier(.2,.8,.2,1)!important}
.mb-wt--on .mb-wt__h,.mb-wt--on .mb-wt__bc,.mb-wt--on .mb-wt__it{opacity:1;transform:translateY(0)}
.mb-wt--on .mb-wt__bc:nth-child(1){transition-delay:.1s!important}
.mb-wt--on .mb-wt__bc:nth-child(2){transition-delay:.2s!important}
.mb-wt--on .mb-wt__bc:nth-child(3){transition-delay:.3s!important}
.mb-wt--on .mb-wt__bc:nth-child(4){transition-delay:.4s!important}
.mb-wt--on .mb-wt__it:nth-child(1){transition-delay:.4s!important}
.mb-wt--on .mb-wt__it:nth-child(2){transition-delay:.48s!important}
.mb-wt--on .mb-wt__it:nth-child(3){transition-delay:.56s!important}
.mb-wt--on .mb-wt__it:nth-child(4){transition-delay:.64s!important}
.mb-wt--on .mb-wt__it:nth-child(5){transition-delay:.72s!important}
.mb-wt--on .mb-wt__it:nth-child(6){transition-delay:.8s!important}
@media screen and (min-width:750px){
.mb-wt{font-size:16px}
.mb-wt__g{max-width:620px;margin-left:auto;margin-right:auto;column-gap:48px;row-gap:20px}
}
@media screen and (max-width:749px){
.mb-wt__in{padding:40px 15px}
.mb-wt__h{margin-bottom:16px;font-size:26px}
.mb-wt__row{gap:6px;margin:16px 0 24px}
.mb-wt__bc{padding:10px 4px;border-radius:6px}
.mb-wt__bi{width:24px;height:24px;margin-bottom:6px}
.mb-wt__bt{font-size:12px;line-height:1.25;letter-spacing:.1px}
.mb-wt__it{gap:6px}
.mb-wt__tx{font-size:14px;line-height:1.3}
}
@supports (width:1cqw){
@media screen and (min-width:750px){
.mb-wt{display:block;width:100%;container-type:inline-size}
.mb-wt__card{--u:min(1px,calc(100cqw / 550));display:flex;flex-direction:column;justify-content:center;min-height:min(100cqw,720px)}
.mb-wt__in{width:100%;padding:max(20px,calc(48 * var(--u))) max(12px,calc(24 * var(--u)))}
.mb-wt__h{font-size:max(20px,calc(32 * var(--u)));margin-bottom:max(10px,calc(24 * var(--u)))}
.mb-wt__row{gap:max(6px,calc(16 * var(--u)));margin:max(10px,calc(32 * var(--u))) 0 max(14px,calc(40 * var(--u)))}
.mb-wt__bc{padding:max(8px,calc(24 * var(--u))) max(4px,calc(12 * var(--u)))}
.mb-wt__bi{width:max(22px,calc(44 * var(--u)));height:max(22px,calc(44 * var(--u)));margin-bottom:max(5px,calc(12 * var(--u)))}
.mb-wt__bt{font-size:max(8.5px,calc(11 * var(--u)))}
.mb-wt__g{column-gap:max(12px,calc(48 * var(--u)));row-gap:max(8px,calc(20 * var(--u)));margin-bottom:max(4px,calc(16 * var(--u)))}
.mb-wt__ic{width:max(14px,calc(20 * var(--u)));height:max(14px,calc(20 * var(--u)))}
.mb-wt__tx{font-size:max(11.5px,calc(18 * var(--u)))}
}
@media screen and (max-width:749px){
.mb-wt{display:block;width:100%;container-type:inline-size}
.mb-wt__card{--u:min(1px,calc(100cqw / 376));display:flex;flex-direction:column;justify-content:center;min-height:min(100cqw,420px)}
.mb-wt__in{width:100%;padding:max(22px,calc(30 * var(--u))) max(10px,calc(15 * var(--u)))}
.mb-wt__h{font-size:max(20px,calc(26 * var(--u)));margin-bottom:max(10px,calc(16 * var(--u)))}
.mb-wt__row{gap:max(4px,calc(6 * var(--u)));margin:max(8px,calc(14 * var(--u))) 0 max(12px,calc(20 * var(--u)))}
.mb-wt__bc{min-height:calc((100cqw - 2 * max(10px,calc(15 * var(--u))) - 3 * max(4px,calc(6 * var(--u)))) / 4);padding:calc(10 * var(--u)) 2px}
.mb-wt__bi{width:max(18px,calc(24 * var(--u)));height:max(18px,calc(24 * var(--u)));margin-bottom:calc(6 * var(--u))}
.mb-wt__bt{font-size:max(8.5px,calc(12 * var(--u)))}
.mb-wt__g{gap:max(10px,calc(16 * var(--u)));margin-bottom:max(4px,calc(8 * var(--u)))}
.mb-wt__ic{width:max(16px,calc(20 * var(--u)));height:max(16px,calc(20 * var(--u)))}
.mb-wt__tx{font-size:max(11.5px,calc(14 * var(--u)))}
}
}
</style>

<div class="mb-wt" data-rm="{{ mb_respect_motion }}" style="--mb-wt-mt:{{ mb_top }};--mb-wt-mb:{{ mb_bottom }};--mb-wt-bg:{{ mb_bg_color }};--mb-wt-tx:{{ mb_text_color }}">
<div class="mb-wt__card" style="position:relative!important;overflow:hidden!important;isolation:isolate">
{%- if mb_bg_img != blank -%}<img src="{{ mb_bg_img }}{{ q }}width=1400" alt="" srcset="{{ mb_bg_img }}{{ q }}width=400 400w, {{ mb_bg_img }}{{ q }}width=600 600w, {{ mb_bg_img }}{{ q }}width=800 800w, {{ mb_bg_img }}{{ q }}width=1000 1000w, {{ mb_bg_img }}{{ q }}width=1200 1200w, {{ mb_bg_img }}{{ q }}width=1400 1400w" width="1400" height="933" loading="lazy" class="mb-wt__bg" sizes="(min-width: 750px) 50vw, 100vw" style="position:absolute!important;top:0!important;left:0!important;width:100%!important;height:100%!important;z-index:0!important;object-fit:cover!important;opacity:1!important;filter:none!important;mix-blend-mode:normal!important">{%- endif -%}
<div class="mb-wt__ov" style="position:absolute!important;top:0!important;right:0!important;bottom:0!important;left:0!important;z-index:1!important;display:block!important;visibility:visible!important;opacity:1!important;pointer-events:none!important;background:linear-gradient(to bottom,{{ mb_grad_top }},{{ mb_grad_bottom }})!important"></div>
<div class="mb-wt__in" style="position:relative!important;z-index:2!important">
<h2 class="mb-wt__h">{{ mb_heading }}</h2>
<div class="mb-wt__row">
{%- for b in mb_badge_items -%}
{%- assign ico = mb_icons[forloop.index0] | strip -%}
<div class="mb-wt__bc"><div class="mb-wt__bi">
{%- assign iq = '?' -%}{%- if ico contains '?' -%}{%- assign iq = '&amp;' -%}{%- endif -%}
{%- if ico != blank -%}<img src="{{ ico }}{{ iq }}width=88" alt="{{ b | strip }}" srcset="{{ ico }}{{ iq }}width=88 88w" width="88" height="83" loading="lazy">
{%- elsif forloop.index == 1 -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6v28a5 5 0 0 0 10 0V6M7 6h16M10 22h10"/><path d="M32 6v12L25.5 31a3 3 0 0 0 2.7 4.3h13.6a3 3 0 0 0 2.7-4.3L38 18V6M30 6h10"/><circle cx="33.5" cy="29" r="1.4"/><circle cx="38.5" cy="31.5" r="1"/></svg>
{%- elsif forloop.index == 2 -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 9l5-2 5 12-5 2zM18 21l4 10M12 41h24M14 36h14"/><path d="M26 22c6 1 9 5 8 11-.6 3-3 3.5-6 3.5"/><circle cx="37" cy="12" r="6.5"/><path d="M34 12l2.2 2.2L40.2 9.8"/></svg>
{%- elsif forloop.index == 3 -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 5h10M21 5v14L11 37a4 4 0 0 0 3.5 6h19a4 4 0 0 0 3.5-6L27 19V5M15 32h18"/><circle cx="21" cy="37" r="1.6"/><circle cx="27.5" cy="35.5" r="1.2"/><circle cx="24.5" cy="40.5" r="1"/></svg>
{%- else -%}<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="18"/><path d="M6 24h36M8.5 15h31M8.5 33h31M24 6c-7.5 8-7.5 28 0 36M24 6c7.5 8 7.5 28 0 36"/></svg>
{%- endif -%}
</div><div class="mb-wt__bt">{{ b | strip }}</div></div>
{%- endfor -%}
</div>
<div class="mb-wt__g">
{%- for t in mb_list_items -%}
<div class="mb-wt__it"><svg class="mb-wt__ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M23 12l-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.7 3.1 5.51l.34 3.69L1 12l2.44 2.79-.34 3.69 3.61.82 1.89 3.2 3.4-1.46 3.4 1.46 1.89-3.2 3.61-.82-.34-3.69L23 12z" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="mb-wt__tx">{{ t | strip }}</span></div>
{%- endfor -%}
</div>
</div>
</div>
</div>
{%- if mb_animate %}
<script>
(function(){
function init(w){
if(w.getAttribute('data-on'))return;
w.setAttribute('data-on','1');
if(w.getAttribute('data-rm')==='true'&&window.matchMedia&&matchMedia('(prefers-reduced-motion:reduce)').matches)return;
w.classList.add('mb-wt--js');
function show(){w.classList.add('mb-wt--on')}
function seen(){var b=w.getBoundingClientRect(),h=window.innerHeight||document.documentElement.clientHeight;return b.height>0&&Math.min(b.bottom,h)-Math.max(b.top,0)>=b.height*.15}
if(!('IntersectionObserver' in window)){show();return}
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){show();io.disconnect()}})},{threshold:.15});
io.observe(w);
function sc(){if(seen()){show();io.disconnect();document.removeEventListener('scroll',sc,true);removeEventListener('resize',sc)}}
document.addEventListener('scroll',sc,true);addEventListener('resize',sc);addEventListener('load',sc);
setTimeout(sc,300);
}
document.querySelectorAll('.mb-wt').forEach(init);
document.addEventListener('shopify:section:load',function(){document.querySelectorAll('.mb-wt').forEach(init)});
})();
</script>
{%- endif %}
