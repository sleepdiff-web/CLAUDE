<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.page-width:has(>.count-wrapper){max-width:none;padding:0}
.count-wrapper{display:flex;align-items:center;justify-content:center;gap:32px;box-sizing:border-box;width:100%;padding:4px 15px;background:#C47245;font-family:'Plus Jakarta Sans',system-ui,sans-serif}
.count-wrapper .left-text{text-align:center}
.count-wrapper h2{margin:0;padding:0;font-family:Poppins,system-ui,sans-serif;font-size:25px;font-weight:600;line-height:28px;letter-spacing:0;text-transform:none;color:#fff}
.count-wrapper p{margin:0;padding:0;font-size:15px;font-weight:400;line-height:20px;letter-spacing:0;color:#F9F1ED}
.count-wrapper .right-timer{display:flex;gap:16px}
.count-wrapper .right-timer>div{display:flex;flex-direction:column;align-items:center}
.count-wrapper span{font-size:26px;font-weight:700;line-height:24px;letter-spacing:0;color:#F9F1ED}
.count-wrapper label{margin:0;padding:0;font-size:12px;font-weight:500;line-height:10px;letter-spacing:0;text-transform:none;color:#F9F1ED}
@media screen and (max-width:749px){
.count-wrapper{gap:14px;padding:6px 12px}
.count-wrapper h2{font-size:18px;line-height:22px}
.count-wrapper p{font-size:12px;line-height:16px}
.count-wrapper .right-timer{gap:10px}
.count-wrapper span{font-size:20px;line-height:20px}
.count-wrapper label{font-size:10px;line-height:9px}
}
@media screen and (max-width:359px){
.count-wrapper{gap:10px;padding:6px 8px}
.count-wrapper h2{font-size:16px;line-height:20px}
.count-wrapper p{font-size:11px;line-height:15px}
.count-wrapper .right-timer{gap:8px}
.count-wrapper span{font-size:18px;line-height:18px}
.count-wrapper label{font-size:9px;line-height:8px}
}
</style>

<div class="count-wrapper"><div class="left-text"><h2>SUMMER SALE</h2><p>Shop Now and Get Up To 70% Off</p></div><div class="right-timer"><div class="hrs-main"><span id="hrs">01</span><label>Hrs</label></div><div class="min-main"><span id="mins">59</span><label>Mins</label></div><div class="secs-main"><span id="secs">53</span><label>Secs</label></div></div></div>

<script>
(function(){
var h=document.getElementById('hrs'),m=document.getElementById('mins'),s=document.getElementById('secs');
if(!h||!m||!s)return;
var D=72e5,K='summer_sale_timer_end',end=0,t,ph,pm,ps;
try{end=+localStorage.getItem(K)||0}catch(e){}
function reset(){end=Date.now()+D;try{localStorage.setItem(K,end)}catch(e){}}
function p(n){return n<10?'0'+n:''+n}
function tick(){
clearTimeout(t);
if(!h.isConnected)return;
var left=end-Date.now();
if(left<=0){reset();left=D-1}
var q=left/1e3|0,a=p(q/3600|0),b=p(q%3600/60|0),c=p(q%60);
if(a!==ph)h.textContent=ph=a;
if(b!==pm)m.textContent=pm=b;
if(c!==ps)s.textContent=ps=c;
if(!document.hidden)t=setTimeout(tick,left%1e3+5);
}
if(end<=Date.now())reset();
document.addEventListener('visibilitychange',tick);
tick();
})();
</script>
