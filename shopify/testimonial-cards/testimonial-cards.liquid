<style>
.mb-tc{container-type:inline-size;box-sizing:border-box;width:100%;max-width:var(--mb-tc-mw);margin:var(--mb-tc-top) auto var(--mb-tc-bottom);padding:0;font-family:'Nunito Sans','Avenir Next',Avenir,'Helvetica Neue',Arial,sans-serif;text-align:left;color:var(--mb-tc-tx)}
.mb-tc *{box-sizing:border-box}
.mb-tc .mb-tc__box{margin:0;padding:var(--mb-tc-pt) 0 calc(var(--mb-tc-u)*20) calc(var(--mb-tc-u)*10);overflow:hidden;border:1px solid var(--mb-tc-cb);border-radius:calc(var(--mb-tc-u)*6);background:var(--mb-tc-cg)}
.mb-tc .mb-tc__vp{display:flex;align-items:stretch;margin:0;padding:0;list-style:none;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;-webkit-tap-highlight-color:transparent}
.mb-tc .mb-tc__vp::-webkit-scrollbar{display:none}
.mb-tc .mb-tc__vp::after{content:"";flex:0 0 calc(var(--mb-tc-u)*9)}
.mb-tc .mb-tc__vp.is-drag{scroll-snap-type:none;cursor:grabbing;user-select:none;-webkit-user-select:none}
.mb-tc .mb-tc__vp:focus-visible{outline:2px solid var(--mb-tc-ac);outline-offset:2px}
.mb-tc .mb-tc__sd{display:flex;flex:0 0 calc(100% - var(--mb-tc-u)*18);width:calc(100% - var(--mb-tc-u)*18);min-width:0;margin:0 calc(var(--mb-tc-u)*9) 0 0;padding:0;list-style:none;scroll-snap-align:start;scroll-snap-stop:always}
.mb-tc--flat .mb-tc__box,.mb-tc--one .mb-tc__box{padding-right:calc(var(--mb-tc-u)*10)}
.mb-tc--flat .mb-tc__vp::after,.mb-tc--one .mb-tc__vp::after{display:none}
.mb-tc--flat .mb-tc__sd,.mb-tc--one .mb-tc__sd{flex-basis:100%;width:100%;margin-right:0}
.mb-tc--one .mb-tc__box{padding-bottom:calc(var(--mb-tc-u)*12)}
.mb-tc .mb-tc__cd{display:flex;flex-direction:column;width:100%;min-width:0;margin:0;padding:0}
.mb-tc .mb-tc__im{position:relative;flex:none;width:100%;margin:0;padding:0;overflow:hidden;border:1px solid var(--mb-tc-ib);border-radius:0;aspect-ratio:var(--mb-tc-ratio);background:#efe7d6}
.mb-tc .mb-tc__im img{position:absolute;inset:0;display:block;width:100%!important;height:100%!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;filter:none;opacity:1;transform:none;object-fit:cover;object-position:var(--mb-tc-pos);-webkit-user-drag:none;user-select:none}
.mb-tc--auto .mb-tc__im{aspect-ratio:auto}
.mb-tc--auto .mb-tc__im img{position:static;height:auto!important}
.mb-tc .mb-tc__pd{display:flex;align-items:center;gap:calc(var(--mb-tc-u)*3.5);margin:calc(var(--mb-tc-u)*13) 0 0;padding:0 0 calc(var(--mb-tc-u)*9);border-bottom:1px solid var(--mb-tc-dv)}
.mb-tc .mb-tc__pc{flex:none;margin:0;padding:0;font-family:'Libre Caslon Display','Libre Caslon Text',Georgia,'Times New Roman',serif;font-size:26px;font-size:max(26px,calc(var(--mb-tc-u)*29));line-height:1.05;font-weight:400;font-style:normal;letter-spacing:0;text-transform:none;white-space:nowrap;color:var(--mb-tc-nm)!important;-webkit-text-fill-color:var(--mb-tc-nm)!important;-webkit-text-stroke:.35px var(--mb-tc-nm)}
.mb-tc .mb-tc__pc span{margin:0;padding:0;font:inherit;letter-spacing:0;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-tc .mb-tc__pt{min-width:0;margin:0;padding:0;font-size:12px;font-size:max(12px,calc(var(--mb-tc-u)*12.1));line-height:1.25;font-weight:500;font-style:normal;letter-spacing:0;text-transform:none;color:var(--mb-tc-tx)!important;-webkit-text-fill-color:var(--mb-tc-tx)!important}
.mb-tc .mb-tc__q{margin:calc(var(--mb-tc-u)*7.5) 0 0;padding:0;font-size:12px;font-size:max(12px,calc(var(--mb-tc-u)*12.4));line-height:1.37;font-weight:500;font-style:italic;letter-spacing:0;text-transform:none;color:var(--mb-tc-tx)!important;-webkit-text-fill-color:var(--mb-tc-tx)!important}
.mb-tc .mb-tc__by{display:flex;align-items:center;gap:calc(var(--mb-tc-u)*5);margin:calc(var(--mb-tc-u)*10.5) 0 0;padding:0;font-size:12px;font-size:max(12px,calc(var(--mb-tc-u)*12.1));line-height:1.4;font-weight:500;font-style:normal;letter-spacing:0;text-transform:none;color:var(--mb-tc-tx)!important;-webkit-text-fill-color:var(--mb-tc-tx)!important}
.mb-tc .mb-tc__by svg{display:block;flex:none;width:9px!important;width:max(9px,calc(var(--mb-tc-u)*8))!important;height:8.3px!important;height:max(8.3px,calc(var(--mb-tc-u)*7.4))!important;margin:0!important;padding:0!important}
.mb-tc .mb-tc__by span{margin:0;padding:0;font-size:inherit;font-weight:inherit;font-style:normal;letter-spacing:0;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-tc .mb-tc__dots{display:flex;align-items:center;justify-content:center;flex-wrap:nowrap;gap:calc(var(--mb-tc-u)*7);margin:calc(var(--mb-tc-u)*20) 0 0;padding:0;list-style:none}
.mb-tc--flat .mb-tc__dots{margin-right:0}
.mb-tc .mb-tc__dots[hidden]{display:none!important}
.mb-tc .mb-tc__dots li{display:flex;margin:0;padding:0;list-style:none}
.mb-tc .mb-tc__dots button{-webkit-appearance:none;appearance:none;position:relative;display:block;width:14px;width:max(14px,calc(var(--mb-tc-u)*22));height:18px;margin:0;padding:0;border:0;border-radius:0;background:transparent;cursor:pointer;font-size:0;line-height:0;transition:width .25s ease}
.mb-tc .mb-tc__dots button.is-on{width:26px;width:max(26px,calc(var(--mb-tc-u)*41))}
.mb-tc .mb-tc__dots button::before{content:"";position:absolute;left:0;right:0;top:50%;height:2px;height:max(2px,calc(var(--mb-tc-u)*2));transform:translateY(-50%);background:var(--mb-tc-dc);transition:background-color .25s ease}
.mb-tc .mb-tc__dots button.is-on::before{background:var(--mb-tc-ac)}
.mb-tc .mb-tc__dots button::after{content:"";position:absolute;inset:-6px -4px}
.mb-tc .mb-tc__dots button:focus-visible{outline:2px solid var(--mb-tc-ac);outline-offset:1px}
/* on narrow boxes (phones) the text keeps a comfortable minimum size instead of shrinking further */
@container (max-width:419px){
.mb-tc .mb-tc__pt,.mb-tc .mb-tc__by{font-size:max(13px,calc(var(--mb-tc-u)*12.1))}
.mb-tc .mb-tc__q{font-size:max(13.5px,calc(var(--mb-tc-u)*12.4))}
.mb-tc .mb-tc__pc{font-size:max(28px,calc(var(--mb-tc-u)*29))}
.mb-tc .mb-tc__pd{gap:7px}
}
</style>

<div class="mb-tc{% if mb_ratio == 'auto' %} mb-tc--auto{% endif %}{% if mb_peek == 'false' %} mb-tc--flat{% endif %}{% if mb_count < 2 %} mb-tc--one{% endif %}" role="region" aria-roledescription="carousel" aria-label="Customer results" style="--mb-tc-u:calc(100cqw / 443 * {{ mb_scale }});--mb-tc-tx:{{ mb_color_text }};--mb-tc-nm:{{ mb_color_num }};--mb-tc-ac:{{ mb_color_accent }};--mb-tc-dc:{{ mb_color_dot }};--mb-tc-cg:{{ mb_card_bg }};--mb-tc-cb:{{ mb_card_border }};--mb-tc-ib:{{ mb_img_border }};--mb-tc-dv:{{ mb_color_divider }};--mb-tc-ratio:{{ mb_ratio }};--mb-tc-pos:{{ mb_img_pos }};--mb-tc-mw:{{ mb_max_w }};--mb-tc-pt:{{ mb_pad_top }};--mb-tc-top:{{ mb_top }};--mb-tc-bottom:{{ mb_bottom }}">
<div class="mb-tc__box">
<ul class="mb-tc__vp" tabindex="0" data-vp>
{%- for mb_it in mb_items -%}
{%- assign mb_chk = mb_it | strip -%}
{%- if mb_chk != blank -%}
{%- assign mb_f = mb_it | split: '|||' -%}
{%- assign mb_im = mb_f[0] | strip -%}
{%- assign mb_num = mb_f[1] | strip | remove: '%' -%}
{%- assign mb_ln = mb_f[2] | strip -%}
{%- assign mb_q = mb_f[3] | strip -%}
{%- assign mb_nm = mb_f[4] | strip -%}
{%- if mb_im contains '?' -%}{%- assign mb_sep = '&amp;' -%}{%- else -%}{%- assign mb_sep = '?' -%}{%- endif -%}
<li class="mb-tc__sd"><div class="mb-tc__cd">
{%- if mb_im != blank -%}<div class="mb-tc__im"><img src="{{ mb_im }}{{ mb_sep }}width=600" srcset="{{ mb_im }}{{ mb_sep }}width=400 400w, {{ mb_im }}{{ mb_sep }}width=600 600w, {{ mb_im }}{{ mb_sep }}width=900 900w, {{ mb_im }}{{ mb_sep }}width=1200 1200w" sizes="(max-width: 600px) 100vw, 560px" width="600" height="262" alt="" loading="lazy" decoding="async" draggable="false"></div>{%- endif -%}
{%- if mb_num != blank or mb_ln != blank -%}<div class="mb-tc__pd">{%- if mb_num != blank -%}<span class="mb-tc__pc"><span class="mb-tc__cnt" data-target="{{ mb_num }}">{{ mb_num }}</span>%</span>{%- endif -%}{%- if mb_ln != blank -%}<p class="mb-tc__pt">{{ mb_ln }}</p>{%- endif -%}</div>{%- endif -%}
{%- if mb_q != blank -%}<p class="mb-tc__q">{{ mb_q }}</p>{%- endif -%}
{%- if mb_nm != blank -%}<p class="mb-tc__by"><svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.79995 11.8499C10.0308 11.8499 12.65 9.23077 12.65 5.9999C12.65 2.76904 10.0308 0.149902 6.79995 0.149902C3.56909 0.149902 0.949951 2.76904 0.949951 5.9999C0.949951 9.23077 3.56909 11.8499 6.79995 11.8499ZM6.19394 8.91323L6.64902 8.36636L9.89902 4.46597L8.90098 3.63394L6.10703 6.98647L4.65977 5.54018L3.74082 6.45913L5.69004 8.40933L6.19394 8.91323Z" fill="{{ mb_color_check }}"></path></svg><span>{{ mb_nm }}{%- if mb_verified != blank %} | {{ mb_verified }}{%- endif -%}</span></p>{%- endif -%}
</div></li>
{%- endif -%}
{%- endfor -%}
</ul>
<ul class="mb-tc__dots" data-dots hidden></ul>
</div>
</div>

<script>
(function(){
function init(root){
if(root.getAttribute('data-on'))return;
root.setAttribute('data-on','1');
var vp=root.querySelector('[data-vp]'),dotsBox=root.querySelector('[data-dots]');
if(!vp)return;
var real=[].slice.call(vp.children),n=real.length;
if(!n)return;
var loop=n>1,dots=[],cur=0,moving=false,quietUntil=0,touching=false,drag=null,st=0,lastW=0;
/* the row loops round forever: a copy of the last card sits before the first and a copy of the first after the last */
if(loop){
var cl=real[n-1].cloneNode(true),cf=real[0].cloneNode(true);
cl.setAttribute('aria-hidden','true');
cf.setAttribute('aria-hidden','true');
vp.insertBefore(cl,real[0]);
vp.appendChild(cf);
}
function w(){return vp.clientWidth}
/* one step = the distance from one card to the next (a little less than the row width, because the next card peeks in) */
function step(){var a=vp.children[0],b=vp.children[1];if(a&&b){var d=b.getBoundingClientRect().left-a.getBoundingClientRect().left;if(d>0)return d}return w()}
function at(k,smooth){vp.scrollTo({left:k*step(),behavior:smooth?'smooth':'auto'})}
function dom(){var x=step();return x?Math.round(vp.scrollLeft/x):0}
function ridx(){var d=dom();return loop?(((d-1)%n)+n)%n:0}
function quiet(f){
quietUntil=Date.now()+200;
vp.style.scrollSnapType='none';
f();
requestAnimationFrame(function(){requestAnimationFrame(function(){vp.style.scrollSnapType=''})});
}
/* the counting numbers: the original script, one for one (starts at -2, goes up one step per screen frame) */
function animateCounter(counter){
var target=+counter.getAttribute('data-target'),count=-2,id=(counter.__id=(counter.__id||0)+1);
function updateCount(){
if(counter.__id!==id)return;
var increment=Math.ceil(target/200);
if(count<target){
count+=increment;
counter.textContent=count>target?target:count;
requestAnimationFrame(updateCount);
}else{
counter.textContent=target;
}
}
updateCount();
}
function showFinal(counter){counter.__id=(counter.__id||0)+1;counter.textContent=counter.getAttribute('data-target')}
function eachIn(el,f){var l=el.querySelectorAll('.mb-tc__cnt'),i;for(i=0;i<l.length;i++)f(l[i])}
function runCurrent(){eachIn(real[cur],animateCounter)}
/* the dots */
function mark(){
var c=ridx(),i;
for(i=0;i<dots.length;i++){var on=i===c;dots[i].classList.toggle('is-on',on);if(on)dots[i].setAttribute('aria-current','true');else dots[i].removeAttribute('aria-current')}
}
function go(k){at(k+1,true)}
if(loop){
for(var i=0;i<n;i++){
(function(k){
var li=document.createElement('li'),b=document.createElement('button');
b.type='button';
b.textContent=String(k+1);
b.setAttribute('aria-label',(k+1)+' of '+n);
b.addEventListener('click',function(){go(k)});
li.appendChild(b);
dotsBox.appendChild(li);
dots.push(b);
})(i);
}
dotsBox.hidden=false;
mark();
}
/* when a slide has settled: jump from a copy to the real card, update dots, count up the new card's number */
function settle(){
st=0;
if(touching||drag)return;
var d=dom();
if(loop&&(d===0||d===n+1)){
d=d===0?n:1;
quiet(function(){at(d,false)});
}
var k=loop?d-1:0;
if(moving){
moving=false;
if(k!==cur){cur=k;mark();runCurrent()}else{mark()}
}else{mark()}
}
/* the moment a slide starts to move every number shows its real value again, then the new card counts up when it has settled */
vp.addEventListener('scroll',function(){
mark();
if(!moving&&Date.now()>quietUntil){moving=true;eachIn(root,showFinal)}
clearTimeout(st);
st=setTimeout(settle,110);
},{passive:true});
if('onscrollend' in window)vp.addEventListener('scrollend',function(){clearTimeout(st);settle()});
vp.addEventListener('touchstart',function(){touching=true},{passive:true});
function touchDone(){touching=false;clearTimeout(st);st=setTimeout(settle,110)}
vp.addEventListener('touchend',touchDone,{passive:true});
vp.addEventListener('touchcancel',touchDone,{passive:true});
vp.addEventListener('keydown',function(e){
if(!loop)return;
if(e.key==='ArrowRight'){e.preventDefault();at(Math.min(n+1,dom()+1),true)}
else if(e.key==='ArrowLeft'){e.preventDefault();at(Math.max(0,dom()-1),true)}
});
/* mouse dragging, like the original slider (touch and trackpad already scroll natively) */
vp.addEventListener('pointerdown',function(e){
if(!loop||e.pointerType!=='mouse'||e.button!==0)return;
drag={x:e.clientX,s:vp.scrollLeft};
vp.classList.add('is-drag');
try{vp.setPointerCapture(e.pointerId)}catch(x){}
});
vp.addEventListener('pointermove',function(e){
if(!drag)return;
vp.scrollLeft=drag.s-(e.clientX-drag.x);
});
function drop(){
if(!drag)return;
var k=Math.round(vp.scrollLeft/(step()||1));
drag=null;
vp.classList.remove('is-drag');
at(k,true);
clearTimeout(st);
st=setTimeout(settle,350);
}
vp.addEventListener('pointerup',drop);
vp.addEventListener('pointercancel',drop);
/* keep the same card in view whenever the width changes (and put the row on the first real card at the start) */
function relayout(){
var x=w();
if(!x||x===lastW)return;
lastW=x;
quiet(function(){at(loop?cur+1:0,false)});
}
if(window.ResizeObserver)new ResizeObserver(relayout).observe(vp);
else{window.addEventListener('resize',relayout);relayout()}
/* like the original: the first card counts when the page loads, and every number counts again once the first card is half on screen */
runCurrent();
if('IntersectionObserver' in window){
var animated=false,watch=real[0].querySelector('.mb-tc__pd')||real[0];
new IntersectionObserver(function(en){
for(var i=0;i<en.length;i++){
if(en[i].isIntersecting&&!animated){animated=true;eachIn(root,animateCounter)}
}
},{threshold:0.5}).observe(watch);
}
}
function all(){document.querySelectorAll('.mb-tc').forEach(init)}
all();
document.addEventListener('shopify:section:load',all);
})();
</script>
