<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Libre+Caslon+Text:wght@400&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Libre+Caslon+Text:wght@400&display=swap"></noscript>

<style>
.mb-tc{box-sizing:border-box;width:100%;max-width:var(--mb-tc-mw);margin:var(--mb-tc-top) auto var(--mb-tc-bottom);padding:0;font-family:'Plus Jakarta Sans',sans-serif;text-align:left;color:var(--mb-tc-tx)}
.mb-tc *{box-sizing:border-box}
.mb-tc .mb-tc__vp{display:flex;align-items:stretch;margin:0;padding:0;list-style:none;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;-webkit-tap-highlight-color:transparent}
.mb-tc .mb-tc__vp::-webkit-scrollbar{display:none}
.mb-tc .mb-tc__vp.is-drag{scroll-snap-type:none;cursor:grabbing;user-select:none;-webkit-user-select:none}
.mb-tc .mb-tc__vp:focus-visible{outline:2px solid var(--mb-tc-ac);outline-offset:2px}
.mb-tc .mb-tc__sd{display:flex;flex:0 0 100%;width:100%;min-width:0;margin:0;padding:0;list-style:none;scroll-snap-align:start;scroll-snap-stop:always}
.mb-tc .mb-tc__cd{display:flex;flex-direction:column;width:100%;margin:0;padding:0;overflow:hidden;border:1px solid var(--mb-tc-cb);border-radius:var(--mb-tc-rd);background:var(--mb-tc-cg)}
.mb-tc .mb-tc__im{position:relative;flex:none;width:100%;margin:0;padding:0;overflow:hidden;aspect-ratio:var(--mb-tc-ratio);background:#efe7d6}
.mb-tc .mb-tc__im img{position:absolute;inset:0;display:block;width:100%!important;height:100%!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;filter:none;opacity:1;transform:none;object-fit:cover;-webkit-user-drag:none;user-select:none}
.mb-tc .mb-tc__bd{display:flex;flex:1 1 auto;flex-direction:column;margin:0;padding:var(--mb-tc-pd)}
.mb-tc .mb-tc__pd{display:flex;align-items:center;gap:14px;margin:0 0 14px;padding:0}
.mb-tc .mb-tc__pc{flex:none;margin:0;padding:0;font-family:'Libre Caslon Text',Georgia,serif;font-size:var(--mb-tc-ns);line-height:1;font-weight:400;font-style:normal;letter-spacing:0;text-transform:none;white-space:nowrap;color:var(--mb-tc-nm)!important;-webkit-text-fill-color:var(--mb-tc-nm)!important}
.mb-tc .mb-tc__pc span{margin:0;padding:0;font:inherit;letter-spacing:0;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-tc .mb-tc__pt{margin:0;padding:0;font-size:var(--mb-tc-ts);line-height:1.35;font-weight:700;font-style:normal;letter-spacing:0;text-transform:none;color:var(--mb-tc-tx)!important;-webkit-text-fill-color:var(--mb-tc-tx)!important}
.mb-tc .mb-tc__q{margin:0 0 14px;padding:0;font-size:var(--mb-tc-ts);line-height:1.65;font-weight:500;font-style:normal;letter-spacing:0;text-transform:none;color:var(--mb-tc-tx)!important;-webkit-text-fill-color:var(--mb-tc-tx)!important}
.mb-tc .mb-tc__by{display:flex;align-items:center;gap:6px;margin:auto 0 0;padding:0;font-size:calc(var(--mb-tc-ts) - 2px);line-height:1.35;font-weight:600;font-style:normal;letter-spacing:0;text-transform:none;color:var(--mb-tc-tx)!important;-webkit-text-fill-color:var(--mb-tc-tx)!important}
.mb-tc--auto .mb-tc__im{aspect-ratio:auto}
.mb-tc--auto .mb-tc__im img{position:static;height:auto!important}
.mb-tc .mb-tc__by svg{display:block;flex:none;width:13px!important;height:12px!important;margin:0!important;padding:0!important}
.mb-tc .mb-tc__by span{margin:0;padding:0;font-size:inherit;font-weight:inherit;font-style:normal;letter-spacing:0;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-tc .mb-tc__dots{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:4px;margin:14px 0 0;padding:0;list-style:none}
.mb-tc .mb-tc__dots[hidden]{display:none!important}
.mb-tc .mb-tc__dots li{display:flex;margin:0;padding:0;list-style:none}
.mb-tc .mb-tc__dots button{-webkit-appearance:none;appearance:none;display:block;width:22px;height:22px;margin:0;padding:0;border:0;background:transparent;cursor:pointer;position:relative;font-size:0;line-height:0}
.mb-tc .mb-tc__dots button::before{content:"";position:absolute;left:50%;top:50%;width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:50%;background:var(--mb-tc-ac);opacity:.28;transition:opacity .2s ease,transform .2s ease}
.mb-tc .mb-tc__dots button.is-on::before{opacity:1;transform:scale(1.15)}
.mb-tc .mb-tc__dots button:focus-visible{outline:2px solid var(--mb-tc-ac);outline-offset:0;border-radius:50%}
</style>

<div class="mb-tc{% if mb_ratio == 'auto' %} mb-tc--auto{% endif %}" role="region" aria-roledescription="carousel" aria-label="Customer results" style="--mb-tc-tx:{{ mb_color_text }};--mb-tc-nm:{{ mb_color_num }};--mb-tc-ac:{{ mb_color_accent }};--mb-tc-cg:{{ mb_card_bg }};--mb-tc-cb:{{ mb_card_border }};--mb-tc-ratio:{{ mb_ratio }};--mb-tc-rd:{{ mb_radius }};--mb-tc-pd:{{ mb_pad }};--mb-tc-ns:{{ mb_num_size }};--mb-tc-ts:{{ mb_text_size }};--mb-tc-mw:{{ mb_max_w }};--mb-tc-top:{{ mb_top }};--mb-tc-bottom:{{ mb_bottom }}">
<ul class="mb-tc__vp" tabindex="0" data-vp>
{%- for mb_it in mb_items -%}
{%- assign mb_chk = mb_it | strip -%}
{%- if mb_chk != blank -%}
{%- assign mb_f = mb_it | split: '|||' -%}
{%- assign mb_im = mb_f[0] | strip -%}
{%- assign mb_num = mb_f[1] | strip | remove: '%' -%}
{%- assign mb_ln = mb_f[2] | strip -%}
{%- assign mb_q = mb_f[3] | strip -%}
{%- assign mb_nm = mb_f[4] | strip -%}
{%- if mb_im contains '?' -%}{%- assign mb_sep = '&amp;' -%}{%- else -%}{%- assign mb_sep = '?' -%}{%- endif -%}
<li class="mb-tc__sd"><div class="mb-tc__cd">
{%- if mb_im != blank -%}<div class="mb-tc__im"><img src="{{ mb_im }}{{ mb_sep }}width=600" srcset="{{ mb_im }}{{ mb_sep }}width=400 400w, {{ mb_im }}{{ mb_sep }}width=600 600w, {{ mb_im }}{{ mb_sep }}width=900 900w, {{ mb_im }}{{ mb_sep }}width=1200 1200w" sizes="(max-width: 600px) 100vw, 560px" width="600" height="600" alt="" loading="lazy" decoding="async" draggable="false"></div>{%- endif -%}
<div class="mb-tc__bd">
{%- if mb_num != blank or mb_ln != blank -%}<div class="mb-tc__pd">{%- if mb_num != blank -%}<span class="mb-tc__pc"><span class="mb-tc__cnt" data-target="{{ mb_num }}">{{ mb_num }}</span>%</span>{%- endif -%}{%- if mb_ln != blank -%}<p class="mb-tc__pt">{{ mb_ln }}</p>{%- endif -%}</div>{%- endif -%}
{%- if mb_q != blank -%}<p class="mb-tc__q">{{ mb_q }}</p>{%- endif -%}
{%- if mb_nm != blank -%}<p class="mb-tc__by"><svg width="13" height="12" viewBox="0 0 13 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M6.79995 11.8499C10.0308 11.8499 12.65 9.23077 12.65 5.9999C12.65 2.76904 10.0308 0.149902 6.79995 0.149902C3.56909 0.149902 0.949951 2.76904 0.949951 5.9999C0.949951 9.23077 3.56909 11.8499 6.79995 11.8499ZM6.19394 8.91323L6.64902 8.36636L9.89902 4.46597L8.90098 3.63394L6.10703 6.98647L4.65977 5.54018L3.74082 6.45913L5.69004 8.40933L6.19394 8.91323Z" fill="{{ mb_color_check }}"></path></svg><span>{{ mb_nm }}{%- if mb_verified != blank %} | {{ mb_verified }}{%- endif -%}</span></p>{%- endif -%}
</div>
</div></li>
{%- endif -%}
{%- endfor -%}
</ul>
<ul class="mb-tc__dots" data-dots hidden></ul>
</div>

<script>
(function(){
function init(root){
if(root.getAttribute('data-on'))return;
root.setAttribute('data-on','1');
var vp=root.querySelector('[data-vp]'),dotsBox=root.querySelector('[data-dots]');
if(!vp)return;
var real=[].slice.call(vp.children),n=real.length;
if(!n)return;
var loop=n>1,dots=[],cur=0,moving=false,quietUntil=0,touching=false,drag=null,st=0,lastW=0;
/* the row loops round forever: a copy of the last card sits before the first and a copy of the first after the last */
if(loop){
var cl=real[n-1].cloneNode(true),cf=real[0].cloneNode(true);
cl.setAttribute('aria-hidden','true');
cf.setAttribute('aria-hidden','true');
vp.insertBefore(cl,real[0]);
vp.appendChild(cf);
}
function w(){return vp.clientWidth}
function at(k,smooth){vp.scrollTo({left:k*w(),behavior:smooth?'smooth':'auto'})}
function dom(){var x=w();return x?Math.round(vp.scrollLeft/x):0}
function ridx(){var d=dom();return loop?(((d-1)%n)+n)%n:0}
function quiet(f){
quietUntil=Date.now()+200;
vp.style.scrollSnapType='none';
f();
requestAnimationFrame(function(){requestAnimationFrame(function(){vp.style.scrollSnapType=''})});
}
/* the counting numbers: the original script, one for one (starts at -2, goes up one step per screen frame) */
function animateCounter(counter){
var target=+counter.getAttribute('data-target'),count=-2,id=(counter.__id=(counter.__id||0)+1);
function updateCount(){
if(counter.__id!==id)return;
var increment=Math.ceil(target/200);
if(count<target){
count+=increment;
counter.textContent=count>target?target:count;
requestAnimationFrame(updateCount);
}else{
counter.textContent=target;
}
}
updateCount();
}
function showFinal(counter){counter.__id=(counter.__id||0)+1;counter.textContent=counter.getAttribute('data-target')}
function eachIn(el,f){var l=el.querySelectorAll('.mb-tc__cnt'),i;for(i=0;i<l.length;i++)f(l[i])}
function runCurrent(){eachIn(real[cur],animateCounter)}
/* the dots */
function mark(){
var c=ridx(),i;
for(i=0;i<dots.length;i++){var on=i===c;dots[i].classList.toggle('is-on',on);if(on)dots[i].setAttribute('aria-current','true');else dots[i].removeAttribute('aria-current')}
}
function go(k){at(k+1,true)}
if(loop){
for(var i=0;i<n;i++){
(function(k){
var li=document.createElement('li'),b=document.createElement('button');
b.type='button';
b.textContent=String(k+1);
b.setAttribute('aria-label',(k+1)+' of '+n);
b.addEventListener('click',function(){go(k)});
li.appendChild(b);
dotsBox.appendChild(li);
dots.push(b);
})(i);
}
dotsBox.hidden=false;
mark();
}
/* when a slide has settled: jump from a copy to the real card, update dots, count up the new card's number */
function settle(){
st=0;
if(touching||drag)return;
var d=dom();
if(loop&&(d===0||d===n+1)){
d=d===0?n:1;
quiet(function(){at(d,false)});
}
var k=loop?d-1:0;
if(moving){
moving=false;
if(k!==cur){cur=k;mark();runCurrent()}else{mark()}
}else{mark()}
}
/* the moment a slide starts to move every number shows its real value again, then the new card counts up when it has settled */
vp.addEventListener('scroll',function(){
mark();
if(!moving&&Date.now()>quietUntil){moving=true;eachIn(root,showFinal)}
clearTimeout(st);
st=setTimeout(settle,110);
},{passive:true});
if('onscrollend' in window)vp.addEventListener('scrollend',function(){clearTimeout(st);settle()});
vp.addEventListener('touchstart',function(){touching=true},{passive:true});
function touchDone(){touching=false;clearTimeout(st);st=setTimeout(settle,110)}
vp.addEventListener('touchend',touchDone,{passive:true});
vp.addEventListener('touchcancel',touchDone,{passive:true});
vp.addEventListener('keydown',function(e){
if(!loop)return;
if(e.key==='ArrowRight'){e.preventDefault();at(Math.min(n+1,dom()+1),true)}
else if(e.key==='ArrowLeft'){e.preventDefault();at(Math.max(0,dom()-1),true)}
});
/* mouse dragging, like the original slider (touch and trackpad already scroll natively) */
vp.addEventListener('pointerdown',function(e){
if(!loop||e.pointerType!=='mouse'||e.button!==0)return;
drag={x:e.clientX,s:vp.scrollLeft};
vp.classList.add('is-drag');
try{vp.setPointerCapture(e.pointerId)}catch(x){}
});
vp.addEventListener('pointermove',function(e){
if(!drag)return;
vp.scrollLeft=drag.s-(e.clientX-drag.x);
});
function drop(){
if(!drag)return;
var k=Math.round(vp.scrollLeft/(w()||1));
drag=null;
vp.classList.remove('is-drag');
at(k,true);
clearTimeout(st);
st=setTimeout(settle,350);
}
vp.addEventListener('pointerup',drop);
vp.addEventListener('pointercancel',drop);
/* keep the same card in view whenever the width changes (and put the row on the first real card at the start) */
function relayout(){
var x=w();
if(!x||x===lastW)return;
lastW=x;
quiet(function(){at(loop?cur+1:0,false)});
}
if(window.ResizeObserver)new ResizeObserver(relayout).observe(vp);
else{window.addEventListener('resize',relayout);relayout()}
/* like the original: the first card counts when the page loads, and every number counts again once the first card is half on screen */
runCurrent();
if('IntersectionObserver' in window){
var animated=false,watch=real[0].querySelector('.mb-tc__pd')||real[0];
new IntersectionObserver(function(en){
for(var i=0;i<en.length;i++){
if(en[i].isIntersecting&&!animated){animated=true;eachIn(root,animateCounter)}
}
},{threshold:0.5}).observe(watch);
}
}
function all(){document.querySelectorAll('.mb-tc').forEach(init)}
all();
document.addEventListener('shopify:section:load',all);
})();
</script>
