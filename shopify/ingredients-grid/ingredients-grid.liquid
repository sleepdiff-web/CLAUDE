<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap"></noscript>

<style>
.mb-ig{box-sizing:border-box;width:100%;margin:var(--mb-ig-top) 0 var(--mb-ig-bottom);padding:var(--mb-ig-pd);background:var(--mb-ig-bg);font-family:'Libre Caslon Text',Georgia,serif;font-weight:400;text-align:left;color:var(--mb-ig-tx)}
.mb-ig--bleed{width:100vw;max-width:none;margin-left:calc(50% - 50vw);margin-right:0}
.mb-ig *{box-sizing:border-box}
.mb-ig p,.mb-ig div,.mb-ig span,.mb-ig em{letter-spacing:0;text-transform:none;font-style:normal}
.mb-ig__in{max-width:1500px;margin:0 auto;padding:0 20px}
.mb-ig__hd{margin:0 0 36px;padding:0;text-align:center}
.mb-ig .mb-ig__t{margin:0;padding:0;font-family:'Libre Caslon Text',Georgia,serif;font-size:36px;line-height:1;font-weight:400;font-style:normal;letter-spacing:0;text-transform:none;text-align:center;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
.mb-ig .mb-ig__t em{font-family:inherit;font-size:inherit;line-height:inherit;font-weight:inherit;font-style:italic;letter-spacing:0;text-transform:none;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-ig .mb-ig__st{margin:8px 0 0;padding:0;font-size:16px;line-height:1.25;font-weight:400;text-align:center;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
.mb-ig__grid{display:flex;gap:var(--mb-ig-gap);margin:0;padding:0 0 24px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.mb-ig__grid::-webkit-scrollbar{display:none}
.mb-ig--drag .mb-ig__grid{cursor:grab}
.mb-ig--drag .mb-ig__grid.is-drag{cursor:grabbing;scroll-snap-type:none;user-select:none;-webkit-user-select:none}
.mb-ig__card{flex:0 0 var(--mb-ig-cw);scroll-snap-align:start;margin:0;background:var(--mb-ig-cbg);border-radius:12px;padding:15px 12px;text-align:center;overflow:hidden}
.mb-ig .mb-ig__img{display:block;width:100%;max-width:100%;height:auto;aspect-ratio:1/1;margin:0;padding:0;object-fit:cover;border:0;border-radius:8px;box-shadow:none;filter:none;opacity:1;transform:none;-webkit-user-drag:none;user-select:none}
.mb-ig .mb-ig__img--ph{background:#ebe5d8}
.mb-ig .mb-ig__cn{margin:18px 0 12px;padding:0;font-size:20px;line-height:1.1;font-weight:700;text-align:center;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
.mb-ig .mb-ig__cd{margin:0;padding:0 8px 0;font-size:12px;line-height:1.25;font-weight:400;text-align:center;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
.mb-ig .mb-ig__cd p{margin:0;padding:0;font-size:inherit;line-height:inherit;font-weight:inherit;text-align:center;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-ig__va{margin:0;padding:0;text-align:center}
.mb-ig .mb-ig__btn{display:inline-flex;align-items:center;gap:12px;width:auto;min-height:0;margin:0;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none;-webkit-appearance:none;appearance:none;font-family:inherit;font-size:14px;line-height:normal;font-weight:700;font-style:normal;letter-spacing:0;text-transform:none;text-decoration:underline;text-underline-offset:3px;cursor:pointer;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
.mb-ig .mb-ig__btn span{font:inherit;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-ig__btn svg{display:block;flex:none;width:18px;height:18px;transition:transform .25s ease}
.mb-ig__btn.expanded svg{transform:rotate(180deg)}
.mb-ig__ex{display:grid;grid-template-rows:0fr;overflow:hidden;transition:grid-template-rows .3s ease}
.mb-ig__ex.expanded{grid-template-rows:1fr}
.mb-ig__exc{min-height:0}
.mb-ig .mb-ig__list{margin:18px 0 0;padding:0;font-size:12px;line-height:1.5;font-weight:400;text-align:center;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
@media screen and (max-width:749px){
.mb-ig{padding:var(--mb-ig-pm)}
.mb-ig__hd{margin-bottom:24px}
.mb-ig .mb-ig__t{font-size:25px}
.mb-ig .mb-ig__st{font-size:14px}
.mb-ig__card{flex:0 0 75%}
.mb-ig .mb-ig__cn{font-size:18px}
.mb-ig .mb-ig__cd{font-size:12px;line-height:18px}
}
@media (prefers-reduced-motion:reduce){
.mb-ig__ex,.mb-ig__btn svg{transition:none}
}
</style>
<noscript><style>.mb-ig__ex{grid-template-rows:1fr}</style></noscript>

<div class="mb-ig{% if mb_bleed %} mb-ig--bleed{% endif %}{% if mb_drag %} mb-ig--drag{% endif %}" data-bleed="{{ mb_bleed }}" data-drag="{{ mb_drag }}" style="--mb-ig-bg:{{ mb_bg }};--mb-ig-cbg:{{ mb_card_bg }};--mb-ig-tx:{{ mb_color_text }};--mb-ig-cw:{{ mb_card_w }};--mb-ig-gap:{{ mb_gap }};--mb-ig-pd:{{ mb_pad_d }};--mb-ig-pm:{{ mb_pad_m }};--mb-ig-top:{{ mb_top }};--mb-ig-bottom:{{ mb_bottom }}">
<div class="mb-ig__in">
{%- if mb_title != blank or mb_subtitle != blank -%}
<div class="mb-ig__hd">
{%- if mb_title != blank -%}<h2 class="mb-ig__t"><em>{{ mb_title }}</em></h2>{%- endif -%}
{%- if mb_subtitle != blank -%}<p class="mb-ig__st">{{ mb_subtitle }}</p>{%- endif -%}
</div>
{%- endif -%}
<div class="mb-ig__grid">
{%- for mb_it in mb_items -%}
{%- assign mb_chk = mb_it | strip -%}
{%- if mb_chk != blank -%}
{%- assign mb_f = mb_it | split: '|||' -%}
{%- assign mb_u = mb_f[0] | strip -%}
{%- assign mb_nm = mb_f[1] | strip -%}
{%- assign mb_ds = mb_f[2] | strip | replace: '[br]', '<br>' -%}
{%- if mb_u contains '?' -%}{%- assign mb_sep = '&amp;' -%}{%- else -%}{%- assign mb_sep = '?' -%}{%- endif -%}
<div class="mb-ig__card">{%- if mb_u != blank -%}<img class="mb-ig__img" src="{{ mb_u }}{{ mb_sep }}width=700" srcset="{{ mb_u }}{{ mb_sep }}width=352 352w, {{ mb_u }}{{ mb_sep }}width=700 700w" sizes="(min-width: 750px) 251px, calc((100vw - 40px) * .75 - 24px)" alt="" width="700" height="700" loading="lazy" decoding="async" draggable="false">{%- else -%}<div class="mb-ig__img mb-ig__img--ph"></div>{%- endif -%}{%- if mb_nm != blank -%}<div class="mb-ig__cn">{{ mb_nm }}</div>{%- endif -%}{%- if mb_ds != blank -%}<div class="mb-ig__cd"><p>{{ mb_ds }}</p></div>{%- endif -%}</div>
{%- endif -%}
{%- endfor -%}
</div>
{%- if mb_list != blank -%}
<div class="mb-ig__va">
<button class="mb-ig__btn" type="button" aria-expanded="false"><span>{{ mb_btn }}</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
<div class="mb-ig__ex"><div class="mb-ig__exc"><div class="mb-ig__list">{{ mb_list }}</div></div></div>
</div>
{%- endif -%}
</div>
</div>

<script>
(function(){
function init(root){
if(root.getAttribute('data-on'))return;
root.setAttribute('data-on','1');
/* stretch edge to edge exactly, whatever the page column is */
function bleed(){
if(root.getAttribute('data-bleed')!=='true')return;
root.style.marginLeft='0px';
root.style.width=document.documentElement.clientWidth+'px';
var l=root.getBoundingClientRect().left;
root.style.marginLeft=(-l)+'px';
}
bleed();
window.addEventListener('resize',bleed);
window.addEventListener('load',function(){bleed();setTimeout(bleed,400)});
/* the "View all ingredients" button */
var btn=root.querySelector('.mb-ig__btn'),ex=root.querySelector('.mb-ig__ex');
if(btn&&ex){
btn.addEventListener('click',function(){
var open=!ex.classList.contains('expanded');
ex.classList.toggle('expanded',open);
btn.classList.toggle('expanded',open);
btn.setAttribute('aria-expanded',open?'true':'false');
});
}
/* click and drag the row with a mouse (touch screens already swipe) */
var g=root.querySelector('.mb-ig__grid');
if(g&&root.getAttribute('data-drag')==='true'){
var down=false,moved=false,sx=0,sl=0;
g.addEventListener('pointerdown',function(e){
if(e.pointerType!=='mouse'||e.button!==0)return;
down=true;moved=false;sx=e.clientX;sl=g.scrollLeft;
});
g.addEventListener('pointermove',function(e){
if(!down)return;
var dx=e.clientX-sx;
if(!moved){
if(Math.abs(dx)<4)return;
moved=true;g.classList.add('is-drag');
try{g.setPointerCapture(e.pointerId)}catch(x){}
}
g.scrollLeft=sl-dx;
});
var end=function(e){
if(!down)return;
down=false;
if(moved){g.classList.remove('is-drag');try{g.releasePointerCapture(e.pointerId)}catch(x){}}
};
g.addEventListener('pointerup',end);
g.addEventListener('pointercancel',end);
}
}
function all(){document.querySelectorAll('.mb-ig').forEach(init)}
all();
document.addEventListener('shopify:section:load',all);
})();
</script>
