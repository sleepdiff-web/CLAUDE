{%- assign mb_subtitle = 'Every ingredient in the Botanical Body Oil earns its spot by smoothing, firming or rebuilding crepey skin.' -%}
{%- assign mb_btn = 'View all ingredients' -%}
{%- assign mb_list = 'Caprylic/Capric Triglyceride, Prunus Amygdalus Dulcis (Sweet Almond) Oil, Simmondsia Chinensis (Jojoba) Seed Oil, Oryza Sativa (Rice) Bran Oil, Squalane, Rosa Canina (Rosehip) Fruit Oil, Bertholletia Excelsa (Brazil Nut) Seed Oil, Camellia Japonica Seed Oil, Argania Spinosa (Argan) Kernel Oil, Passiflora Edulis (Passionflower) Seed Oil, Helianthus Annuus (Sunflower) Seed Oil, Undaria Pinnatifida (Wakame) Extract, Tocopherol (Vitamin E), Ascorbyl Tetraisopalmitate (Vitamin C), Bisabolol, Vanilla Planifolia Fruit Extract.' -%}
{%- assign mb_cols_d = 3 -%}
{%- assign mb_cols_t = 3 -%}
{%- assign mb_cols_m = 2 -%}
{%- assign mb_breaks_m = true -%}
{%- assign mb_bg = '#ffffff' -%}
{%- assign mb_color_title = '#000000' -%}
{%- assign mb_color_text = '#2a110a' -%}
{%- assign mb_radius = '12px' -%}
{%- assign mb_pad_d = '64px' -%}
{%- assign mb_pad_m = '40px' -%}
{%- assign mb_bleed = true -%}
{%- assign mb_top = '0px' -%}
{%- assign mb_bottom = '0px' -%}
{%- assign mb_items = mb_cards | split: '@@' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&display=swap"></noscript>

<style>
.mb-ig{box-sizing:border-box;width:100%;margin:var(--mb-ig-top) 0 var(--mb-ig-bottom);background:var(--mb-ig-bg);font-family:'Plus Jakarta Sans',sans-serif;text-align:center}
.mb-ig--bleed{width:100vw;max-width:none;margin-left:calc(50% - 50vw);margin-right:0}
.mb-ig *{box-sizing:border-box}
.mb-ig p,.mb-ig div,.mb-ig span,.mb-ig em{letter-spacing:0;text-transform:none;font-style:normal}
.mb-ig__in{max-width:1200px;margin:0 auto;padding:var(--mb-ig-pdm) 20px}
.mb-ig__hd{margin:0 0 32px;padding:0}
.mb-ig .mb-ig__t{margin:0 0 12px;padding:0;font-family:'Libre Caslon Text',Georgia,serif;font-size:28px;line-height:34px;font-weight:400;font-style:italic;letter-spacing:0;text-transform:none;text-align:center;color:var(--mb-ig-ti)!important;-webkit-text-fill-color:var(--mb-ig-ti)!important}
.mb-ig .mb-ig__t em{font-family:inherit;font-size:inherit;line-height:inherit;font-weight:inherit;font-style:italic;letter-spacing:0;text-transform:none;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-ig .mb-ig__st{max-width:560px;margin:0 auto;padding:0;font-size:15px;line-height:24px;font-weight:400;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
.mb-ig__grid{display:grid;grid-template-columns:repeat(var(--mb-ig-cm),minmax(0,1fr));gap:28px 14px;margin:0;padding:0}
.mb-ig__card{display:flex;flex-direction:column;align-items:center;min-width:0;margin:0;padding:0}
.mb-ig__im{width:100%;aspect-ratio:1/1;margin:0;padding:0;overflow:hidden;border-radius:var(--mb-ig-rad);background:#ebe5d8}
.mb-ig__im img{display:block;width:100%;max-width:100%;height:100%;margin:0;padding:0;object-fit:cover;border:0;border-radius:0;box-shadow:none;filter:none;opacity:1;transform:none}
.mb-ig .mb-ig__cn{margin:14px 0 6px;padding:0;font-size:16px;line-height:22px;font-weight:700;text-align:center;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
.mb-ig .mb-ig__cd{margin:0;padding:0;font-size:14px;line-height:21px;font-weight:400;text-align:center;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
@media screen and (max-width:749px){
.mb-ig--nobrm .mb-ig__br{display:none}
}
.mb-ig__va{display:flex;flex-direction:column;align-items:center;margin:32px 0 0;padding:0}
.mb-ig .mb-ig__btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;width:auto;min-height:0;margin:0;padding:12px 24px;border:1px solid var(--mb-ig-tx);border-radius:999px;background:transparent;box-shadow:none;font-family:inherit;font-size:15px;line-height:20px;font-weight:600;letter-spacing:0;text-transform:none;text-decoration:none;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important;-webkit-appearance:none;appearance:none;cursor:pointer}
.mb-ig .mb-ig__btn span{font:inherit;color:inherit!important;-webkit-text-fill-color:inherit!important}
.mb-ig__btn svg{display:block;flex:none;width:16px;height:16px;transition:transform .25s ease}
.mb-ig__btn[aria-expanded="true"] svg{transform:rotate(180deg)}
.mb-ig__ex{display:grid;grid-template-rows:0fr;width:100%;visibility:hidden;transition:grid-template-rows .35s ease,visibility 0s linear .35s}
.mb-ig__ex.is-open{grid-template-rows:1fr;visibility:visible;transition-delay:0s}
.mb-ig__exc{min-height:0;overflow:hidden}
.mb-ig .mb-ig__list{max-width:900px;margin:0 auto;padding:24px 0 0;font-size:13px;line-height:20px;font-weight:400;text-align:center;opacity:.8;color:var(--mb-ig-tx)!important;-webkit-text-fill-color:var(--mb-ig-tx)!important}
@media screen and (min-width:750px){
.mb-ig__in{padding-left:24px;padding-right:24px}
.mb-ig__grid{grid-template-columns:repeat(var(--mb-ig-ct),minmax(0,1fr));gap:36px 24px}
.mb-ig .mb-ig__st{font-size:16px}
}
@media screen and (min-width:1024px){
.mb-ig__in{padding-top:var(--mb-ig-pdd);padding-bottom:var(--mb-ig-pdd)}
.mb-ig__hd{margin-bottom:48px}
.mb-ig .mb-ig__t{font-size:36px;line-height:42px}
.mb-ig__grid{grid-template-columns:repeat(var(--mb-ig-cd),minmax(0,1fr));gap:44px 32px}
.mb-ig .mb-ig__cn{font-size:18px;line-height:24px}
.mb-ig .mb-ig__cd{font-size:15px;line-height:22px}
}
@media (prefers-reduced-motion:reduce){
.mb-ig__ex,.mb-ig__btn svg{transition:none}
}
</style>
<noscript><style>.mb-ig__ex{grid-template-rows:1fr;visibility:visible}</style></noscript>

<div class="mb-ig{% if mb_bleed %} mb-ig--bleed{% endif %}{% unless mb_breaks_m %} mb-ig--nobrm{% endunless %}" data-bleed="{{ mb_bleed }}" style="--mb-ig-bg:{{ mb_bg }};--mb-ig-ti:{{ mb_color_title }};--mb-ig-tx:{{ mb_color_text }};--mb-ig-rad:{{ mb_radius }};--mb-ig-cd:{{ mb_cols_d }};--mb-ig-ct:{{ mb_cols_t }};--mb-ig-cm:{{ mb_cols_m }};--mb-ig-pdd:{{ mb_pad_d }};--mb-ig-pdm:{{ mb_pad_m }};--mb-ig-top:{{ mb_top }};--mb-ig-bottom:{{ mb_bottom }}">
<div class="mb-ig__in">
{%- if mb_title != blank or mb_subtitle != blank -%}
<div class="mb-ig__hd">
{%- if mb_title != blank -%}<h2 class="mb-ig__t"><em>{{ mb_title }}</em></h2>{%- endif -%}
{%- if mb_subtitle != blank -%}<p class="mb-ig__st">{{ mb_subtitle }}</p>{%- endif -%}
</div>
{%- endif -%}
<div class="mb-ig__grid">
{%- for mb_it in mb_items -%}
{%- assign mb_chk = mb_it | strip -%}
{%- if mb_chk != blank -%}
{%- assign mb_f = mb_it | split: '|||' -%}
{%- assign mb_u = mb_f[0] | strip -%}
{%- assign mb_nm = mb_f[1] | strip -%}
{%- assign mb_ds = mb_f[2] | strip | replace: '[br]', ' <br class="mb-ig__br">' -%}
{%- if mb_u contains '?' -%}{%- assign mb_sep = '&amp;' -%}{%- else -%}{%- assign mb_sep = '?' -%}{%- endif -%}
<div class="mb-ig__card"><div class="mb-ig__im">{%- if mb_u != blank -%}<img src="{{ mb_u }}{{ mb_sep }}width=700" srcset="{{ mb_u }}{{ mb_sep }}width=352 352w, {{ mb_u }}{{ mb_sep }}width=700 700w" sizes="(min-width: 1224px) 365px, (min-width: 750px) 33vw, 50vw" alt="" width="700" height="700" loading="lazy" decoding="async">{%- endif -%}</div>{%- if mb_nm != blank -%}<div class="mb-ig__cn">{{ mb_nm }}</div>{%- endif -%}{%- if mb_ds != blank -%}<p class="mb-ig__cd">{{ mb_ds }}</p>{%- endif -%}</div>
{%- endif -%}
{%- endfor -%}
</div>
{%- if mb_list != blank -%}
<div class="mb-ig__va">
<button class="mb-ig__btn" type="button" aria-expanded="false"><span>{{ mb_btn }}</span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
<div class="mb-ig__ex"><div class="mb-ig__exc"><div class="mb-ig__list">{{ mb_list }}</div></div></div>
</div>
{%- endif -%}
</div>
</div>

<script>
(function(){
function init(root){
if(root.getAttribute('data-on'))return;
root.setAttribute('data-on','1');
/* stretch edge to edge exactly, whatever the page column is */
function bleed(){
if(root.getAttribute('data-bleed')!=='true')return;
root.style.marginLeft='0px';
root.style.width=document.documentElement.clientWidth+'px';
var l=root.getBoundingClientRect().left;
root.style.marginLeft=(-l)+'px';
}
bleed();
window.addEventListener('resize',bleed);
window.addEventListener('load',function(){bleed();setTimeout(bleed,400)});
/* the "View all ingredients" button */
var btn=root.querySelector('.mb-ig__btn'),ex=root.querySelector('.mb-ig__ex');
if(btn&&ex){
btn.addEventListener('click',function(){
var open=ex.classList.toggle('is-open');
btn.setAttribute('aria-expanded',open?'true':'false');
});
}
}
function all(){document.querySelectorAll('.mb-ig').forEach(init)}
all();
document.addEventListener('shopify:section:load',all);
})();
</script>
