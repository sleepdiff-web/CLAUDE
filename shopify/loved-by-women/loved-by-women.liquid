.mb-ln .mb-ln__nv{display:none;align-items:center;justify-content:center;gap:16px;margin:24px 0 0;padding:0}
.mb-ln.has-nav .mb-ln__nv{display:flex}
.mb-ln .mb-ln__ar{-webkit-appearance:none;appearance:none;display:flex;align-items:center;justify-content:center;flex:none;width:52px;height:52px;margin:0;padding:0;border:0;border-radius:50%;background:transparent;box-shadow:none;cursor:pointer;line-height:0;transition:opacity .15s ease}
.mb-ln .mb-ln__ar:hover{opacity:.75}
.mb-ln .mb-ln__ar:focus-visible{outline:2px solid var(--mb-ln-ac);outline-offset:2px}
.mb-ln .mb-ln__ar svg{display:block;width:52px;height:52px;margin:0;padding:0;overflow:visible}
.mb-ln .mb-ln__ar circle{stroke:var(--mb-ln-ac)}
.mb-ln .mb-ln__ar path{fill:var(--mb-ln-ak)}
.mb-ln .mb-ln__dots{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:4px;margin:0;padding:0;list-style:none}
.mb-ln .mb-ln__dots li{display:flex;margin:0;padding:0;list-style:none}
.mb-ln .mb-ln__dots button{-webkit-appearance:none;appearance:none;display:block;width:22px;height:22px;margin:0;padding:0;border:0;background:transparent;cursor:pointer;position:relative;font-size:0;line-height:0}
.mb-ln .mb-ln__dots button::before{content:"";position:absolute;left:50%;top:50%;width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:50%;background:var(--mb-ln-ac);opacity:.28;transition:opacity .2s ease,transform .2s ease}
.mb-ln .mb-ln__dots button.is-on::before{opacity:1;transform:scale(1.15)}
.mb-ln .mb-ln__dots button:focus-visible{outline:2px solid var(--mb-ln-ac);outline-offset:0;border-radius:50%}
.mb-ln__bt{width:100%;margin:32px 0 0;padding:0;display:flex;justify-content:center}
.mb-ln .mb-ln__btn{display:inline-flex;align-items:center;justify-content:center;width:100%;max-width:var(--mb-ln-bw);height:var(--mb-ln-bh);margin:0;padding:0 20px;border:0;border-radius:var(--mb-ln-br);background:var(--mb-ln-bb)!important;box-shadow:none;font-family:'Plus Jakarta Sans',sans-serif;font-size:14.5px;line-height:1;font-weight:700;font-style:normal;letter-spacing:0;text-transform:none;text-decoration:none;text-align:center;color:var(--mb-ln-bc)!important;-webkit-text-fill-color:var(--mb-ln-bc)!important;cursor:pointer;transition:opacity .15s ease}
.mb-ln .mb-ln__btn:hover,.mb-ln .mb-ln__btn:focus-visible{opacity:.88;text-decoration:none}
.mb-ln__gt{display:flex;align-items:center;justify-content:center;gap:6px;margin:12px 0 0;padding:0}
.mb-ln__ck{display:block;flex:none;width:15px;height:15.6px;margin:0;padding:0}
.mb-ln .mb-ln__gx{margin:0;padding:0;font-size:12px;line-height:20px;font-weight:500;font-style:normal;letter-spacing:0;text-transform:none;color:var(--mb-ln-tx)!important;-webkit-text-fill-color:var(--mb-ln-tx)!important}
@media screen and (min-width:750px){
