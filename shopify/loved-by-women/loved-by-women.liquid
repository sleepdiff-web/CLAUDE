<script>
(function(){
function init(root){
if(root.getAttribute('data-on'))return;
root.setAttribute('data-on','1');
/* stretch edge to edge exactly, whatever the page column is */
function bleed(){
if(root.getAttribute('data-bleed')!=='true')return;
root.style.marginLeft='0px';
root.style.width=document.documentElement.clientWidth+'px';
var l=root.getBoundingClientRect().left;
root.style.marginLeft=(-l)+'px';
}
bleed();
window.addEventListener('resize',bleed);
window.addEventListener('load',function(){bleed();setTimeout(bleed,400)});
/* the review row: native scrolling, round arrows and dots only when there are more cards than fit */
var tr=root.querySelector('[data-tr]'),slides=tr?tr.children:[],n=slides.length,prev=root.querySelector('[data-prev]'),next=root.querySelector('[data-next]'),dotsBox=root.querySelector('[data-dots]'),dots=[],raf=0,max=0,drag=null;
function per(){var v=parseInt(getComputedStyle(root).getPropertyValue('--mb-ln-per'),10);return v>0?v:1}
function sw(){return n?slides[0].getBoundingClientRect().width:0}
function cur(){var w=sw();return w?Math.max(0,Math.min(max,Math.round(tr.scrollLeft/w))):0}
function mark(){
var c=cur(),i;
for(i=0;i<dots.length;i++){var on=i===c;dots[i].classList.toggle('is-on',on);if(on)dots[i].setAttribute('aria-current','true');else dots[i].removeAttribute('aria-current')}
}
function go(i){
if(i>max)i=0;
if(i<0)i=max;
tr.scrollTo({left:i*sw(),behavior:'smooth'});
}
function build(){
max=Math.max(0,n-per());
dotsBox.innerHTML='';
dots=[];
if(max<1){root.classList.remove('has-nav');tr.scrollLeft=0;return}
for(var i=0;i<=max;i++){
(function(k){
var li=document.createElement('li'),b=document.createElement('button');
b.type='button';
b.textContent=String(k+1);
b.setAttribute('aria-label',(k+1)+' of '+(max+1));
b.addEventListener('click',function(){go(k)});
li.appendChild(b);
dotsBox.appendChild(li);
dots.push(b);
})(i);
}
root.classList.add('has-nav');
mark();
}
if(tr&&n){
build();
if(prev)prev.addEventListener('click',function(){go(cur()-1)});
if(next)next.addEventListener('click',function(){go(cur()+1)});
tr.addEventListener('scroll',function(){if(raf)return;raf=requestAnimationFrame(function(){raf=0;mark()})},{passive:true});
tr.addEventListener('keydown',function(e){
if(!root.classList.contains('has-nav'))return;
if(e.key==='ArrowRight'){e.preventDefault();go(cur()+1)}
else if(e.key==='ArrowLeft'){e.preventDefault();go(cur()-1)}
});
/* mouse dragging, like the original slider (touch and trackpad already scroll natively) */
tr.addEventListener('pointerdown',function(e){
if(e.pointerType!=='mouse'||e.button!==0||!root.classList.contains('has-nav'))return;
drag={x:e.clientX,s:tr.scrollLeft,id:e.pointerId};
tr.classList.add('is-drag');
try{tr.setPointerCapture(e.pointerId)}catch(x){}
});
tr.addEventListener('pointermove',function(e){
if(!drag)return;
tr.scrollLeft=drag.s-(e.clientX-drag.x);
});
function drop(){
if(!drag)return;
var c=Math.max(0,Math.min(max,Math.round(tr.scrollLeft/(sw()||1))));
drag=null;
tr.classList.remove('is-drag');
tr.scrollTo({left:c*sw(),behavior:'smooth'});
}
tr.addEventListener('pointerup',drop);
tr.addEventListener('pointercancel',drop);
var last=per(),rt=0;
window.addEventListener('resize',function(){
clearTimeout(rt);
rt=setTimeout(function(){
var p=per(),c=cur();
if(p!==last){last=p;build()}
tr.scrollTo({left:Math.min(c,max)*sw(),behavior:'auto'});
mark();
},120);
});
}
/* the button: a #link scrolls smoothly to that spot, or else to the Add to cart form */
var btn=root.querySelector('.mb-ln__btn');
if(btn){
btn.addEventListener('click',function(e){
var h=btn.getAttribute('href')||'';
if(h.charAt(0)!=='#'||h.length<2)return;
var t=null;
try{t=document.getElementById(h.slice(1))}catch(x){}
if(!t){
var fs=document.querySelectorAll('form[action*="/cart/add"]');
for(var i=0;i<fs.length;i++){if(fs[i].offsetParent!==null&&!root.contains(fs[i])){t=fs[i];break}}
}
if(!t)return;
e.preventDefault();
t.scrollIntoView({behavior:'smooth',block:'center'});
});
}
}
function all(){document.querySelectorAll('.mb-ln').forEach(init)}
all();
document.addEventListener('shopify:section:load',all);
})();
</script>
