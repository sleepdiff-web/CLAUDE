<style>
.mb-ln{--mb-ln-per:3;box-sizing:border-box;width:100%;margin:var(--mb-ln-top) 0 var(--mb-ln-bottom);background:var(--mb-ln-bg);font-family:'Plus Jakarta Sans',sans-serif;text-align:center;color:var(--mb-ln-tx)}
.mb-ln--bleed{width:100vw;max-width:none;margin-left:calc(50% - 50vw);margin-right:0}
.mb-ln *{box-sizing:border-box}
.mb-ln__c{max-width:1200px;margin:0 auto;padding:var(--mb-ln-pdm)}
.mb-ln .mb-ln__h{margin:0 0 10px;padding:0;font-family:'Libre Caslon Text',Georgia,serif;font-size:var(--mb-ln-thm);line-height:1.2;font-weight:400;font-style:normal;letter-spacing:0;text-transform:none;text-align:center;color:var(--mb-ln-hd)!important;-webkit-text-fill-color:var(--mb-ln-hd)!important}
.mb-ln .mb-ln__sub{max-width:640px;margin:0 auto;padding:0;font-size:15px;line-height:1.55;font-weight:400;font-style:normal;letter-spacing:0;text-transform:none;text-align:center;color:var(--mb-ln-hd)!important;-webkit-text-fill-color:var(--mb-ln-hd)!important}
.mb-ln__sl{position:relative;margin:28px -10px 0}
.mb-ln .mb-ln__tr{display:flex;align-items:stretch;margin:0;padding:0;list-style:none;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;-webkit-tap-highlight-color:transparent}
.mb-ln .mb-ln__tr::-webkit-scrollbar{display:none}
.mb-ln .mb-ln__tr.is-drag{scroll-snap-type:none;cursor:grabbing;user-select:none;-webkit-user-select:none}
.mb-ln .mb-ln__tr:focus-visible{outline:2px solid var(--mb-ln-ac);outline-offset:-2px}
.mb-ln .mb-ln__sd{display:flex;flex:0 0 calc(100% / var(--mb-ln-per));min-width:0;margin:0;padding:0 10px;list-style:none;scroll-snap-align:start}
.mb-ln .mb-ln__sd:first-child{margin-left:auto}
.mb-ln .mb-ln__sd:last-child{margin-right:auto}
.mb-ln .mb-ln__cd{display:flex;flex-direction:column;width:100%;margin:0;padding:0;overflow:hidden;border:1px solid var(--mb-ln-cb);border-radius:14px;background:var(--mb-ln-cg);text-align:left}
.mb-ln .mb-ln__im{position:relative;flex:none;width:100%;margin:0;padding:0;overflow:hidden;aspect-ratio:var(--mb-ln-ratio);background:#efe7d6}
.mb-ln .mb-ln__im img{position:absolute;inset:0;display:block;width:100%!important;height:100%!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;filter:none;opacity:1;transform:none;object-fit:cover;-webkit-user-drag:none;user-select:none}
.mb-ln .mb-ln__bd{display:flex;flex:1 1 auto;flex-direction:column;margin:0;padding:16px 18px 18px}
.mb-ln .mb-ln__st{display:block;flex:none;width:104px;height:19px;margin:0 0 12px;padding:0}
.mb-ln .mb-ln__st path{fill:var(--mb-ln-sr)}
.mb-ln .mb-ln__q{margin:0 0 14px;padding:0;font-size:15px;line-height:1.6;font-weight:500;font-style:normal;letter-spacing:0;text-transform:none;text-align:left;color:var(--mb-ln-tx)!important;-webkit-text-fill-color:var(--mb-ln-tx)!important}
.mb-ln .mb-ln__by{display:flex;align-items:center;gap:7px;margin:0 0 14px;padding:0;font-size:13px;line-height:1.35;font-weight:500;font-style:normal;letter-spacing:0;text-transform:none;text-align:left;color:var(--mb-ln-tx)!important;-webkit-text-fill-color:var(--mb-ln-tx)!important}
.mb-ln .mb-ln__by span,.mb-ln .mb-ln__by strong{margin:0;padding:0;font-size:inherit;font-style:normal;letter-spacing:0;text-transform:none;color:var(--mb-ln-tx)!important;-webkit-text-fill-color:var(--mb-ln-tx)!important}
.mb-ln .mb-ln__by strong{font-weight:700}
.mb-ln .mb-ln__vi{display:block;flex:none;width:16px!important;height:16px!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important}
.mb-ln .mb-ln__tg{display:flex;flex-wrap:wrap;gap:6px;margin:auto 0 0;padding:0;list-style:none}
