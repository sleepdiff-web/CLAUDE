{%- comment -%}
  "Feel Better. Every Day." feature section: orange gradient, heading + line, a 2 x 2 grid of icon boxes on the left and the product pack picture on the right (sitting on the bottom edge of the section). Phones: everything stacks, grid first, picture under it.
  EDIT YOUR FEATURES BELOW. One box = icon link ||| title. Put @@ on its own line between boxes.
  The picture links start as Metabolae's own files so the section is an exact copy straight away.
  Before you go live, download them, upload them to your own store (Content > Files) and paste your links here instead, so they keep working and are yours. Also replace the heading and text, because they describe Metabolae's product.
  mb_bg_top / mb_bg_bottom = the gradient (Metabolae's orange; for your red use #943434 and #612229). mb_text_color = all the text. mb_pt = space above the heading.
  These colours are locked, so the theme cannot turn them black.
  Do not use a straight apostrophe (') in the text, use &#39; or &rsquo; instead. Do not type three | in a row inside a box except as the separator.
{%- endcomment -%}
{%- assign mb_title = 'Feel Better. Every Day.' -%}
{%- assign mb_text = 'From steady metabolic support to effortless daily use, here&rsquo;s what makes Metabolae Ceylon Cinnamon different.' -%}
{%- assign mb_bg_top = '#d27f52' -%}
{%- assign mb_bg_bottom = '#a55328' -%}
{%- assign mb_text_color = '#ffffff' -%}
{%- assign mb_pt = '36px' -%}
{%- assign mb_pack = 'https://metabolae.com/cdn/shop/files/metabolae-3-pack-pdp.webp?v=1784819489&width=800' -%}
{%- capture mb_boxes -%}
https://metabolae.com/cdn/shop/files/metabolae-icon-blood-sugar-support.webp?v=1773663519&width=100 ||| Blood Sugar Support
@@
https://metabolae.com/cdn/shop/files/metabolae-better-daily-absorption.webp?v=1773663519&width=100 ||| Better Daily Absorption
@@
https://metabolae.com/cdn/shop/files/metabolae-gentle-on-stomach.webp?v=1773663520&width=100 ||| Gentle on the Stomach
@@
https://metabolae.com/cdn/shop/files/metabolae-liver-friendly-formulav2.webp?v=1773663752&width=100 ||| Liver-Friendly Formula
{%- endcapture -%}
{%- assign mb_items = mb_boxes | split: '@@' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.page-width:has(>.mb-fb){max-width:none;padding:0}
.mb-fb,.mb-fb *,.mb-fb *::before,.mb-fb *::after{box-sizing:border-box}
.mb-fb{--mb-fb-c:#fff;display:block;width:100%;margin:0;padding:var(--mb-fb-pt,36px) 0 0;overflow:hidden;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:16px;font-weight:500;line-height:1.8;letter-spacing:.02em;text-align:center;color:var(--mb-fb-c)!important}
.mb-fb__top{max-width:1240px;margin:0 auto;padding:0 20px}
.mb-fb__h{margin:0;padding:0;font-family:Poppins,system-ui,sans-serif;font-size:clamp(28px,2.25vw,45px);font-style:normal;font-weight:400!important;line-height:1.45;letter-spacing:0;text-align:center;text-transform:none;color:var(--mb-fb-c)!important;-webkit-text-fill-color:var(--mb-fb-c)!important}
.mb-fb__p{margin:16px 0 0;padding:0;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:clamp(14px,1vw,20px);font-weight:500;line-height:1.5;letter-spacing:.02em;text-align:center;color:var(--mb-fb-c)!important;-webkit-text-fill-color:var(--mb-fb-c)!important}
.mb-fb__wrap{display:flex;align-items:flex-end;justify-content:space-between;max-width:2000px;margin:10px auto 0;padding:0 8% 0 6.9%}
.mb-fb__grid{display:grid;grid-template-columns:1fr 1fr;row-gap:clamp(30px,2.9vw,58px);flex:0 0 38.5%;max-width:656px;padding:0 0 clamp(40px,4.6vw,92px)}
.mb-fb__box{display:flex;flex-direction:column;align-items:center;padding:0 clamp(8px,1.2vw,24px);text-align:center}
.mb-fb__ic{display:block;width:clamp(64px,5vw,100px);height:auto;margin:0 auto clamp(13px,1.05vw,21px);max-width:none;border:0;border-radius:0}
.mb-fb__t{margin:0;padding:0;font-family:Poppins,system-ui,sans-serif;font-size:clamp(17px,1.48vw,29.6px);font-style:normal;font-weight:400!important;line-height:1.15;letter-spacing:0;text-align:center;text-transform:none;color:var(--mb-fb-c)!important;-webkit-text-fill-color:var(--mb-fb-c)!important}
.mb-fb__pic{flex:0 0 38.5%;max-width:656px;line-height:0}
.mb-fb__pic img{display:block;width:100%;height:auto;margin:0;border:0;border-radius:0}
@media screen and (max-width:989px){
.mb-fb__wrap{display:block;margin-top:24px;padding:0 16px}
.mb-fb__grid{max-width:560px;margin:0 auto;padding-bottom:32px;row-gap:28px}
.mb-fb__box{padding:0 8px}
.mb-fb__ic{width:72px;margin-bottom:14px}
.mb-fb__t{font-size:19px}
.mb-fb__p{font-size:16px}
.mb-fb__pic{max-width:560px;margin:0 auto}
}
@media screen and (max-width:749px){
.mb-fb__p{font-size:15px}
.mb-fb__t{font-size:18px}
}
</style>

<section class="mb-fb" style="--mb-fb-c:{{ mb_text_color }};--mb-fb-pt:{{ mb_pt }};background:linear-gradient(180deg,{{ mb_bg_top }} 0%,{{ mb_bg_bottom }} 100%)!important;color:{{ mb_text_color }}!important">
  <div class="mb-fb__top">
    <h2 class="mb-fb__h" style="color:{{ mb_text_color }}!important;-webkit-text-fill-color:{{ mb_text_color }}!important">{{ mb_title }}</h2>
    <p class="mb-fb__p" style="color:{{ mb_text_color }}!important;-webkit-text-fill-color:{{ mb_text_color }}!important">{{ mb_text }}</p>
  </div>
  <div class="mb-fb__wrap">
    <div class="mb-fb__grid">
      {%- for mb_item in mb_items -%}
        {%- assign mb_f = mb_item | split: '|||' -%}
        {%- assign mb_icon = mb_f[0] | strip -%}
        {%- assign mb_name = mb_f[1] | strip -%}
        <div class="mb-fb__box">
          <img class="mb-fb__ic" src="{{ mb_icon }}" width="100" height="100" alt="" loading="lazy" decoding="async">
          <h4 class="mb-fb__t" style="color:{{ mb_text_color }}!important;-webkit-text-fill-color:{{ mb_text_color }}!important">{{ mb_name }}</h4>
        </div>
      {%- endfor -%}
    </div>
    <div class="mb-fb__pic"><img src="{{ mb_pack }}" width="800" height="800" alt="" loading="lazy" decoding="async"></div>
  </div>
</section>
