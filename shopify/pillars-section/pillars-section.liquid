{%- comment -%}
  EDIT YOUR CONTENT BELOW. One card = image URL | headline | text
  Put @@ on its own line between cards. Leave the image URL empty to show a plain tinted box.
  Image URL: Content > Files > copy link. Add as many cards as you like.
{%- endcomment -%}
{%- assign mb_eyebrow = '3 Reasons why' -%}
{%- assign mb_heading = 'Your section heading' -%}
{%- capture mb_data -%}
 | Reason one headline | Replace this with a short explanation of your first reason.
@@
 | Reason two headline | Replace this with a short explanation of your second reason.
@@
 | Reason three headline | Replace this with a short explanation of your third reason.
{%- endcapture -%}
{%- assign mb_cards = mb_data | split: '@@' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.page-width:has(>.mb-pl){max-width:none;padding:0}
.mb-pl{background:#faf7f4;overflow:hidden;padding:24px 0 56px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:15px;font-weight:500;line-height:1.8;letter-spacing:.6px;color:rgba(18,18,18,.75);content-visibility:auto;contain-intrinsic-size:auto 720px}
.mb-pl__wrap{box-sizing:border-box;max-width:1400px;margin:0 auto;padding:0 10px}
.mb-pl__head{text-align:center;margin-bottom:40px}
.mb-pl__eyebrow{display:inline-block;margin-bottom:12px;font-size:14px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#c47245}
.mb-pl__title{margin:0;padding:0;font-family:Poppins,system-ui,sans-serif;font-size:26px;font-weight:500;line-height:1.15;letter-spacing:0;text-transform:none;word-break:break-word;color:#2b2118}
.mb-pl__grid{display:flex;gap:20px;overflow-x:scroll;margin:0 -16px;padding:0 16px;scroll-padding-left:16px;scroll-snap-type:x mandatory;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.mb-pl__grid::-webkit-scrollbar{display:none}
.mb-pl__card{position:relative;flex:0 0 82%;overflow:hidden;box-sizing:border-box;padding:16px;border:1px solid #ede0d4;border-radius:16px;background:#fff;scroll-snap-align:start}
.mb-pl__card::before{content:'';display:block;position:absolute;top:0;left:0;right:0;height:4px;border-radius:16px 16px 0 0;background:#c47245}
.mb-pl__img{height:200px;margin-bottom:20px;overflow:hidden;border-radius:8px;background:#f3e6da;line-height:0}
.mb-pl__img img{display:block;width:100%;height:100%;object-fit:cover}
.mb-pl__num{display:inline-block;margin-bottom:12px;font-size:14px;font-weight:700;letter-spacing:.08em;color:#c47245}
.mb-pl__h{margin:0 0 10px;padding:0;font-family:Poppins,system-ui,sans-serif;font-size:20px;font-weight:600;line-height:1.3;letter-spacing:.6px;text-transform:none;word-break:break-word;color:#2b2118}
.mb-pl__text{margin:0;font-size:14px;line-height:1.6;color:#5c4b3a}
.mb-pl__dots{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:20px}
.mb-pl__dot{flex-shrink:0;width:8px;height:8px;padding:0;border:0;border-radius:50%;background:#ede0d4;cursor:pointer;-webkit-appearance:none;appearance:none;transition:background-color .2s ease,transform .2s ease}
.mb-pl__dot.is-active{background:#c47245;transform:scale(1.4)}
@media screen and (min-width:750px){
.mb-pl{padding:40px 0 96px;font-size:16px}
.mb-pl__wrap{padding:0 50px}
.mb-pl__head{margin-bottom:56px}
.mb-pl__eyebrow{margin-bottom:16px;font-size:16px}
.mb-pl__title{font-size:32px}
.mb-pl__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;overflow:visible;margin:0;padding:0;scroll-snap-type:none}
.mb-pl__card{flex:none;padding:40px 36px;border-radius:20px}
.mb-pl__card::before{border-radius:20px 20px 0 0}
.mb-pl__img{height:240px}
.mb-pl__num{margin-bottom:16px;font-size:15px}
.mb-pl__h{margin-bottom:12px;font-size:22px}
.mb-pl__text{font-size:16px}
.mb-pl__dots{display:none}
}
</style>

<section class="mb-pl" aria-label="{{ mb_heading | escape }}"><div class="mb-pl__wrap">
<div class="mb-pl__head"><span class="mb-pl__eyebrow">{{ mb_eyebrow }}</span><h2 class="mb-pl__title">{{ mb_heading }}</h2></div>
<div class="mb-pl__grid">
{%- for c in mb_cards -%}
{%- assign f = c | split: '|' -%}
{%- assign src = f[0] | strip -%}
{%- assign q = '?' -%}{%- if src contains '?' -%}{%- assign q = '&amp;' -%}{%- endif -%}
<div class="mb-pl__card"><div class="mb-pl__img">{%- if src != blank -%}<img src="{{ src }}{{ q }}width=800" srcset="{{ src }}{{ q }}width=300 300w, {{ src }}{{ q }}width=500 500w, {{ src }}{{ q }}width=800 800w, {{ src }}{{ q }}width=1200 1200w" sizes="(min-width:1400px) 340px, (min-width:750px) calc((100vw - 156px) / 3 - 74px), calc(82vw - 50px)" width="800" height="533" alt="" loading="lazy" decoding="async">{%- endif -%}</div><span class="mb-pl__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><h3 class="mb-pl__h">{{ f[1] | strip }}</h3><p class="mb-pl__text">{{ f[2] | strip }}</p></div>
{%- endfor -%}
</div>
<div class="mb-pl__dots" aria-hidden="true">{%- for c in mb_cards -%}<button type="button" class="mb-pl__dot{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}" tabindex="-1"></button>{%- endfor -%}</div>
</div></section>

<script>
(function(){
var r=document.currentScript.previousElementSibling;
if(!r||!r.classList.contains('mb-pl'))return;
var t=r.querySelector('.mb-pl__grid'),d=r.querySelectorAll('.mb-pl__dot'),k=t.children,raf=0,on=0;
if(k.length<2)return;
function step(){return k[0].offsetWidth+(parseInt(getComputedStyle(t).columnGap)||0)}
function set(i){if(i===on||!d[i])return;d[on].classList.remove('is-active');d[i].classList.add('is-active');on=i}
t.addEventListener('scroll',function(){if(!raf)raf=requestAnimationFrame(function(){raf=0;set(Math.round(t.scrollLeft/step()))})},{passive:true});
r.querySelector('.mb-pl__dots').addEventListener('click',function(e){var b=e.target.closest('.mb-pl__dot');if(b)t.scrollTo({left:step()*(+b.getAttribute('data-i')),behavior:'smooth'})});
})();
</script>
