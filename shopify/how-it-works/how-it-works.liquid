{%- comment -%}
  "How it works" section (layout cloned from evorabody.com): a two-line title (the second line in italics), a looping video next to a short paragraph, then three stat items underneath.
  Desktop = video left, text right, three stats in a row. Phone = everything stacked, stats as a list.
  WHERE: best as its own section: Online Store > Themes > Customize > Product page > Add section > Custom Liquid, drag it where you want it, paste this in.
  EDIT YOUR CONTENT BELOW. Do not use a straight apostrophe (') in the text, use &#39; instead.
  mb_title_1 = first title line. mb_title_2 = second title line (shown in italics). Leave mb_title_2 empty for a one-line title.
  mb_video = link to YOUR video file (an .mp4 uploaded in Shopify admin > Content > Files). It plays silently on a loop, only while it is on screen. Leave empty to show a placeholder.
  THE VIDEO AND PICTURE BELOW ARE LINKED FROM evorabody.com SO YOU CAN SEE THE SECTION WORKING. For a live store, download the video (open the mp4 link in your browser, right-click the video, Save video as) and the picture, upload both in Shopify admin > Content > Files, then paste your own two links in place. That keeps the section working if the original files ever change.
  mb_poster = the still picture shown before the video plays (a link to a picture). mb_video_ratio = shape of the video box, for example 4 / 5 or 1 / 1 or 16 / 9.
  mb_text = the paragraph. Put [b] before and [/b] after any words you want in bold.
  mb_stats = the three stat items, separated by @@ and each one written as   NUMBER ||| TEXT ||| OPTIONAL PICTURE LINK
  The NUMBER (write 94 for 94%) is drawn inside a ring that fills to that percentage. If you give a picture link instead, your picture is shown in place of the ring.
  IMPORTANT: only use figures that come from your own real customer survey.
  mb_color_num = ring and number colour. mb_color_text = all text. mb_bg = background colour of the section. mb_radius = corner roundness of the video.
  mb_pad_d / mb_pad_m = space above and below inside the section on desktop / phone. mb_top / mb_bottom = space above and below the block.
{%- endcomment -%}
{%- assign mb_title_1 = 'How Our Body Oil' -%}
{%- assign mb_title_2 = 'works on your Skin' -%}
{%- assign mb_video = 'https://evorabody.com/cdn/shop/videos/c/vp/515db52b11954a9fb9c8088e367f4684/515db52b11954a9fb9c8088e367f4684.HD-1080p-2.5Mbps-85576897.mp4?v=0' -%}
{%- assign mb_poster = 'https://evorabody.com/cdn/shop/files/Screenshot_2026-06-08_210430.png?v=1780934686' -%}
{%- assign mb_video_ratio = '4 / 5' -%}
{%- assign mb_text = 'After menopause, water-based lotions cannot penetrate and simply evaporate. A cold-pressed botanical oil [b]matches the skin&#39;s lipid barrier[/b] and absorbs instead of sitting on top, so it can [b]restore softness where it is actually lost[/b].' -%}
{%- capture mb_stats -%}
94 ||| Said dry, crepey texture felt visibly smoother within the first two weeks
@@
91 ||| Said their skin stayed soft and hydrated past lunchtime for the first time
@@
88 ||| Said it absorbed completely with no greasy residue
{%- endcapture -%}
{%- assign mb_color_num = '#dea431' -%}
{%- assign mb_color_text = '#5e4312' -%}
{%- assign mb_bg = 'transparent' -%}
{%- assign mb_radius = '16px' -%}
{%- assign mb_pad_d = '56px' -%}
{%- assign mb_pad_m = '36px' -%}
{%- assign mb_top = '0px' -%}
{%- assign mb_bottom = '0px' -%}
{%- assign mb_text_html = mb_text | replace: '[b]', '<strong>' | replace: '[/b]', '</strong>' -%}
{%- if mb_poster contains '?' -%}{%- assign mb_poster_src = mb_poster | append: '&amp;width=1200' -%}{%- else -%}{%- assign mb_poster_src = mb_poster | append: '?width=1200' -%}{%- endif -%}
{%- assign mb_items = mb_stats | split: '@@' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Libre+Caslon+Text:ital,wght@0,400;1,400&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Libre+Caslon+Text:ital,wght@0,400;1,400&display=swap"></noscript>

<style>
.mb-hw{box-sizing:border-box;width:100%;margin:var(--mb-hw-top) 0 var(--mb-hw-bottom);padding:var(--mb-hw-pdm) 16px;background:var(--mb-hw-bg);font-family:'Plus Jakarta Sans',sans-serif;text-align:center}
.mb-hw *{box-sizing:border-box}
.mb-hw p,.mb-hw strong,.mb-hw em,.mb-hw span{letter-spacing:0;text-transform:none;font-style:normal;color:var(--mb-hw-tx)!important;-webkit-text-fill-color:var(--mb-hw-tx)!important}
.mb-hw__in{max-width:1100px;margin:0 auto}
.mb-hw .mb-hw__t{margin:0 0 26px;padding:0;font-family:'Libre Caslon Text',Georgia,serif;font-size:29px;font-weight:400;line-height:1.2}
.mb-hw .mb-hw__t em{font-family:inherit;font-style:italic;font-size:inherit;font-weight:inherit}
.mb-hw__cw{display:grid;grid-template-columns:minmax(0,1fr);gap:22px;align-items:center;text-align:left}
.mb-hw__vw{position:relative;width:100%;margin:0;overflow:hidden;border-radius:var(--mb-hw-r);aspect-ratio:var(--mb-hw-ratio);background:#efe7d6}
.mb-hw__v{position:absolute;inset:0;display:block;width:100%;height:100%;margin:0;padding:0;object-fit:cover;border:0;border-radius:0;box-shadow:none;filter:none;opacity:1;transform:none;background:transparent}
.mb-hw .mb-hw__ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:16px;font-size:13px;font-weight:600;text-align:center;opacity:.45}
.mb-hw .mb-hw__d{margin:0;padding:0;font-size:16px;font-weight:400;line-height:1.65}
.mb-hw .mb-hw__d strong{font-size:inherit;font-weight:700}
.mb-hw__st{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;margin:30px 0 0;padding:0}
.mb-hw__si{display:flex;align-items:center;gap:16px;margin:0;padding:0;text-align:left}
.mb-hw__ring{position:relative;display:block;flex:none;width:76px;height:76px}
.mb-hw__ring svg{display:block;width:100%;height:100%}
.mb-hw__ring circle{fill:none;stroke-width:5;stroke-linecap:round}
.mb-hw__ring .mb-hw__rt{stroke:var(--mb-hw-nm);opacity:.22}
.mb-hw__ring .mb-hw__ra{stroke:var(--mb-hw-nm)}
.mb-hw .mb-hw__pc{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:'Libre Caslon Text',Georgia,serif;font-size:21px;font-weight:400;line-height:1;color:var(--mb-hw-nm)!important;-webkit-text-fill-color:var(--mb-hw-nm)!important}
.mb-hw__sim{display:block;flex:none;width:76px;height:76px;margin:0;padding:0;object-fit:contain;border:0;border-radius:0;box-shadow:none;filter:none}
.mb-hw .mb-hw__sx{margin:0;padding:0;font-size:15px;font-weight:500;line-height:1.45}
@media screen and (min-width:750px){
.mb-hw{padding-top:var(--mb-hw-pdd);padding-bottom:var(--mb-hw-pdd)}
.mb-hw .mb-hw__t{margin-bottom:40px;font-size:42px}
.mb-hw__cw{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:56px}
.mb-hw .mb-hw__d{font-size:19px}
.mb-hw__st{grid-template-columns:repeat(3,minmax(0,1fr));gap:32px;margin-top:48px}
.mb-hw__si{flex-direction:column;gap:14px;text-align:center}
.mb-hw__ring,.mb-hw__sim{width:96px;height:96px}
.mb-hw .mb-hw__pc{font-size:26px}
.mb-hw .mb-hw__sx{font-size:16px}
}
</style>

<div class="mb-hw" style="--mb-hw-tx:{{ mb_color_text }};--mb-hw-nm:{{ mb_color_num }};--mb-hw-bg:{{ mb_bg }};--mb-hw-r:{{ mb_radius }};--mb-hw-ratio:{{ mb_video_ratio }};--mb-hw-pdd:{{ mb_pad_d }};--mb-hw-pdm:{{ mb_pad_m }};--mb-hw-top:{{ mb_top }};--mb-hw-bottom:{{ mb_bottom }}">
<div class="mb-hw__in">
{%- if mb_title_1 != blank -%}<p class="mb-hw__t">{{ mb_title_1 }}{%- if mb_title_2 != blank -%}<br><em>{{ mb_title_2 }}</em>{%- endif -%}</p>{%- endif -%}
<div class="mb-hw__cw">
<div class="mb-hw__vw">
{%- if mb_video != blank -%}<video class="mb-hw__v" muted loop playsinline webkit-playsinline preload="none" aria-hidden="true" tabindex="-1" data-src="{{ mb_video }}"{% if mb_poster != blank %} poster="{{ mb_poster_src }}"{% endif %}></video>
{%- else -%}{%- if mb_poster != blank -%}<img class="mb-hw__v" src="{{ mb_poster_src }}" alt="" loading="lazy" decoding="async">{%- else -%}<span class="mb-hw__ph">Your video goes here</span>{%- endif -%}{%- endif -%}
</div>
<p class="mb-hw__d">{{ mb_text_html }}</p>
</div>
<div class="mb-hw__st">
{%- for mb_it in mb_items -%}
{%- assign mb_chk = mb_it | strip -%}
{%- if mb_chk != blank -%}
{%- assign mb_f = mb_it | split: '|||' -%}
{%- assign mb_num = mb_f[0] | strip | remove: '%' -%}
{%- assign mb_stx = mb_f[1] | strip -%}
{%- assign mb_sim = mb_f[2] | strip -%}
{%- assign mb_dash = mb_num | plus: 0 | at_most: 100 | times: 2.136 | round: 1 -%}
<div class="mb-hw__si">
{%- if mb_sim != blank -%}<img class="mb-hw__sim" src="{{ mb_sim }}" alt="" width="96" height="96" loading="lazy" decoding="async">
{%- elsif mb_num != blank -%}<span class="mb-hw__ring"><svg viewBox="0 0 80 80" aria-hidden="true" focusable="false"><circle class="mb-hw__rt" cx="40" cy="40" r="34"/><circle class="mb-hw__ra" cx="40" cy="40" r="34" stroke-dasharray="{{ mb_dash }} 213.6" transform="rotate(-90 40 40)"/></svg><span class="mb-hw__pc">{{ mb_num }}%</span></span>{%- endif -%}
{%- if mb_stx != blank -%}<p class="mb-hw__sx">{{ mb_stx }}</p>{%- endif -%}
</div>
{%- endif -%}
{%- endfor -%}
</div>
</div>
</div>

<script>
(function(){
function init(root){
if(root.getAttribute('data-on'))return;
root.setAttribute('data-on','1');
var v=root.querySelector('video.mb-hw__v');
if(!v)return;
v.muted=true;
var loaded=false;
function start(){
if(!loaded){loaded=true;v.src=v.getAttribute('data-src');v.setAttribute('preload','auto')}
var p=v.play();
if(p&&p.catch)p.catch(function(){});
}
if('IntersectionObserver' in window){
new IntersectionObserver(function(en){
for(var i=0;i<en.length;i++){if(en[i].isIntersecting){start()}else if(loaded){v.pause()}}
},{threshold:0.25}).observe(v);
}else{start()}
}
function all(){document.querySelectorAll('.mb-hw').forEach(init)}
all();
document.addEventListener('shopify:section:load',all);
})();
</script>
