{%- comment -%}
  EDIT YOUR CONTENT BELOW.
  mb_img: your own badge image URL (Content > Files > copy link). Leave it empty to use the built-in "days" seal.
  mb_days: the number shown in the built-in seal. Do not use a straight apostrophe (') in the text, use &#39; instead.
{%- endcomment -%}
{%- assign mb_img = '' -%}
{%- assign mb_days = '90' -%}
{%- assign mb_heading = '90-Day Money Back Guarantee' -%}
{%- assign mb_text = 'Try <b>Your Brand</b> completely risk-free for 90 days. If you&#39;re not 100% satisfied, we&#39;ll refund every penny, no questions asked. Replace this with your own guarantee wording.' -%}
{%- assign mb_btn = 'Try Risk-Free Today' -%}
{%- assign mb_link = '#MainContent' -%}
{%- assign q = '?' -%}{%- if mb_img contains '?' -%}{%- assign q = '&amp;' -%}{%- endif -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.page-width:has(>.mb-mbg){max-width:none;padding:0}
.mb-mbg{padding:72px 0;background:linear-gradient(341deg,rgba(124,69,39,1) 17%,rgba(159,89,51,1) 40.05%,rgba(159,89,51,1) 64.64%,rgba(124,69,39,1) 111.46%);font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:500;line-height:1.8;letter-spacing:.6px;text-align:center;color:rgba(18,18,18,.75)}
.mb-mbg__wrap{box-sizing:border-box;max-width:1400px;margin:0 auto;padding:0 12px}
.mb-mbg__in{display:flex;flex-direction:column;align-items:center;max-width:890px;margin:0 auto}
.mb-mbg__badge{flex-shrink:0;width:212px;height:212px;margin-bottom:4px}
.mb-mbg__badge img,.mb-mbg__badge svg{display:block;width:100%;height:100%}
.mb-mbg__badge img{object-fit:contain}
.mb-mbg__h{margin:0;padding:21px 0 0;font-family:Poppins,sans-serif;font-size:42px;font-style:normal;font-weight:400;line-height:100%;letter-spacing:-.42px;text-align:center;text-transform:capitalize;word-break:break-word;color:#fff}
.mb-mbg__t{margin:0;padding:16px 0 21px;font-size:18px;font-style:normal;font-weight:400;line-height:normal;letter-spacing:0;text-align:center;color:#fff}
.mb-mbg__btn{display:inline-block;box-sizing:border-box;width:397px;margin:0 auto;padding:16px;border:0;border-radius:44px;background:#fff;font-size:18px;font-style:normal;font-weight:600;line-height:110%;letter-spacing:-.32px;text-align:center;text-decoration:none;text-transform:capitalize;color:#8b4a1f;cursor:pointer;transition:transform .3s ease}
.mb-mbg__btn:hover{transform:scale(1.05)}
@media screen and (min-width:750px){
.mb-mbg{font-size:16px}
.mb-mbg__wrap{padding:0 50px}
}
@media screen and (max-width:767px){
.mb-mbg{padding:40px 0}
.mb-mbg__badge{width:210px;height:210px}
.mb-mbg__h{font-size:36px}
.mb-mbg__t{padding:10px 0 21px;font-size:16px;line-height:19px}
.mb-mbg__btn{width:100%;padding:14px 32px}
}
</style>

<section class="mb-mbg"><div class="mb-mbg__wrap"><div class="mb-mbg__in">
<div class="mb-mbg__badge">{%- if mb_img != blank -%}<img src="{{ mb_img }}{{ q }}width=400" srcset="{{ mb_img }}{{ q }}width=212 212w, {{ mb_img }}{{ q }}width=424 424w" sizes="212px" width="212" height="212" alt="Money Back Guarantee Badge" loading="lazy" decoding="async">{%- else -%}<svg viewBox="-3.3 -3.3 218.5 218.5" aria-hidden="true"><path d="M106.0 7.0L117.9 15.8L131.6 10.4L140.8 21.9L155.5 20.3L161.4 33.8L176.0 36.0L178.2 50.6L191.7 56.5L190.1 71.2L201.6 80.4L196.2 94.1L205.0 106.0L196.2 117.9L201.6 131.6L190.1 140.8L191.7 155.5L178.2 161.4L176.0 176.0L161.4 178.2L155.5 191.7L140.8 190.1L131.6 201.6L117.9 196.2L106.0 205.0L94.1 196.2L80.4 201.6L71.2 190.1L56.5 191.7L50.6 178.2L36.0 176.0L33.8 161.4L20.3 155.5L21.9 140.8L10.4 131.6L15.8 117.9L7.0 106.0L15.8 94.1L10.4 80.4L21.9 71.2L20.3 56.5L33.8 50.6L36.0 36.0L50.6 33.8L56.5 20.3L71.2 21.9L80.4 10.4L94.1 15.8Z" fill="#7C4527" stroke="#fff" stroke-width="3" stroke-linejoin="round"/><circle cx="106" cy="106" r="81.5" fill="#C47245" stroke="#fff" stroke-width="2.2"/><path d="M106 106m-62 0a62 62 0 0 1 124 0" id="mb-mbg-t" fill="none"/><path d="M106 106m-73 0a73 73 0 0 0 146 0" id="mb-mbg-b" fill="none"/><g fill="#fff" font-family="'Plus Jakarta Sans',sans-serif" font-weight="800" font-size="17.5" letter-spacing="1.7"><text text-anchor="middle"><textPath href="#mb-mbg-t" startOffset="50%">MONEY BACK</textPath></text><text text-anchor="middle"><textPath href="#mb-mbg-b" startOffset="50%">GUARANTEE</textPath></text><path d="M41.5 83.3L42.9 86.6L46.4 86.9L43.7 89.2L44.6 92.7L41.5 90.8L38.4 92.7L39.3 89.2L36.6 86.9L40.1 86.6ZM40.5 103.8L41.9 107.1L45.4 107.4L42.7 109.7L43.6 113.2L40.5 111.3L37.4 113.2L38.3 109.7L35.6 107.4L39.1 107.1ZM45.5 123.3L46.9 126.6L50.4 126.9L47.7 129.2L48.6 132.7L45.5 130.8L42.4 132.7L43.3 129.2L40.6 126.9L44.1 126.6ZM170.5 83.3L171.9 86.6L175.4 86.9L172.7 89.2L173.6 92.7L170.5 90.8L167.4 92.7L168.3 89.2L165.6 86.9L169.1 86.6ZM171.5 103.8L172.9 107.1L176.4 107.4L173.7 109.7L174.6 113.2L171.5 111.3L168.4 113.2L169.3 109.7L166.6 107.4L170.1 107.1ZM166.5 123.3L167.9 126.6L171.4 126.9L168.7 129.2L169.6 132.7L166.5 130.8L163.4 132.7L164.3 129.2L161.6 126.9L165.1 126.6Z"/></g><circle cx="106" cy="106" r="48.5" fill="#fff" stroke="#7C4527" stroke-width="2.4"/><g fill="#7C4527" font-family="'Plus Jakarta Sans',sans-serif" text-anchor="middle"><text x="106" y="107" font-size="40" font-weight="800" letter-spacing="-1">{{ mb_days }}</text><text x="106" y="130" font-size="18.5" font-weight="800">DAYS</text></g></svg>{%- endif -%}</div>
<h2 class="mb-mbg__h">{{ mb_heading }}</h2>
<p class="mb-mbg__t">{{ mb_text }}</p>
<a class="mb-mbg__btn" href="{{ mb_link }}">{{ mb_btn }}</a>
</div></div></section>
