{%- comment -%}
  Product title: "Berberine Metabolic Support Complex (500mg)".
  mb_title = the title text.
  mb_color = text colour (locked, so the theme cannot change it).
  mb_tag = h1 for a real page heading, or div if the page already has a heading elsewhere. It looks identical either way.
  mb_top / mb_top_mobile / mb_bottom / mb_bottom_mobile = space above and below (desktop / phone). Margins merge with neighbouring blocks.
  Do not use a straight apostrophe (') inside mb_title (use &#39; instead).
{%- endcomment -%}
{%- assign mb_title = 'Berberine Metabolic Support Complex (500mg)' -%}
{%- assign mb_color = '#121212' -%}
{%- assign mb_tag = 'h1' -%}
{%- assign mb_top = '10px' -%}
{%- assign mb_top_mobile = '6px' -%}
{%- assign mb_bottom = '12px' -%}
{%- assign mb_bottom_mobile = '16px' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.mb-tt{display:block;margin:var(--mb-tt-mt,10px) 0 var(--mb-tt-mb,12px);padding:0;font-family:Poppins,sans-serif;font-size:26px;font-style:normal;font-weight:600;line-height:1.25;letter-spacing:normal;text-align:left;text-transform:none;word-break:break-word}
@media screen and (max-width:749px){
.mb-tt{font-size:21px;margin-top:var(--mb-tt-mtm,6px);margin-bottom:var(--mb-tt-mbm,16px)}
}
</style>

<{{ mb_tag }} class="mb-tt" style="--mb-tt-mt:{{ mb_top }};--mb-tt-mtm:{{ mb_top_mobile }};--mb-tt-mb:{{ mb_bottom }};--mb-tt-mbm:{{ mb_bottom_mobile }};color:{{ mb_color }}!important;-webkit-text-fill-color:{{ mb_color }}!important">{{ mb_title }}</{{ mb_tag }}>
