{%- comment -%}
  Sale price row, exact copy of Metabolae's (price, crossed-out price, sale pill). Add as a Custom Liquid block on the PRODUCT page above the bundle bars.
  Prices follow the selected variant and the selected Kaching Bundles bar. mb_label = pill text. _d = desktop, _m = mobile. mb_kaching = false if no Kaching.
  mb_show_pill = false hides the black "Fall Sale - Save 63%" pill (only the price and the crossed-out price show). Set it to true to bring the pill back.
  If the Save % ever looks wrong with Kaching, add ?mbdebug=1 to the end of the product page address, press F12, open Console and send me what it prints.
  Do not use a straight apostrophe (') in the text, use &#39; instead.
{%- endcomment -%}
{%- assign mb_show_pill = false -%}
{%- assign mb_label = 'Fall Sale - Save' -%}
{%- assign mb_badge_bg = '#000000' -%}
{%- assign mb_badge_color = '#ffffff' -%}
{%- assign mb_badge_radius = '6px' -%}
{%- assign mb_badge_pv = '6px' -%}
{%- assign mb_badge_ph = '10px' -%}
{%- assign mb_badge_fs_d = '12px' -%}
{%- assign mb_badge_fs_m = '11px' -%}
{%- assign mb_badge_fw_d = '700' -%}
{%- assign mb_badge_fw_m = '700' -%}
{%- assign mb_price_color = '#000000' -%}
{%- assign mb_price_fs_d = '17px' -%}
{%- assign mb_price_fs_m = '17px' -%}
{%- assign mb_price_fw_d = '700' -%}
{%- assign mb_price_fw_m = '600' -%}
{%- assign mb_compare_color = '#444444' -%}
{%- assign mb_compare_fs_d = '15px' -%}
{%- assign mb_compare_fs_m = '15px' -%}
{%- assign mb_compare_fw_d = '600' -%}
{%- assign mb_compare_fw_m = '600' -%}
{%- assign mb_top = '16px' -%}
{%- assign mb_bottom = '16px' -%}
{%- assign mb_kaching = true -%}
{%- assign mb_demo_price = 5999 -%}
{%- assign mb_demo_compare = 17997 -%}

{%- if product -%}
  {%- assign mb_v = product.selected_or_first_available_variant -%}
  {%- assign mb_price = mb_v.price -%}
  {%- assign mb_compare = mb_v.compare_at_price | default: 0 -%}
{%- else -%}
  {%- assign mb_price = mb_demo_price -%}
  {%- assign mb_compare = mb_demo_compare -%}
{%- endif -%}
{%- assign mb_sale = false -%}
{%- if mb_compare > mb_price -%}{%- assign mb_sale = true -%}{%- endif -%}
{%- assign mb_pct = 0 -%}
{%- if mb_sale -%}{%- assign mb_pct = mb_compare | minus: mb_price | times: 100.0 | divided_by: mb_compare | round -%}{%- endif -%}
{%- assign bid = 'badge-sale-' | append: section.id -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<div
  id="{{ bid }}"
  class="bsw"
  style="
    --bs-badge-bg:         {{ mb_badge_bg }};
    --bs-badge-radius:     {{ mb_badge_radius }};
    --bs-badge-color:      {{ mb_badge_color }};
    --bs-badge-pv:         {{ mb_badge_pv }};
    --bs-badge-ph:         {{ mb_badge_ph }};
    --bs-badge-fs-d:       {{ mb_badge_fs_d }};
    --bs-badge-fs-m:       {{ mb_badge_fs_m }};
    --bs-badge-fw-d:       {{ mb_badge_fw_d }};
    --bs-badge-fw-m:       {{ mb_badge_fw_m }};
    --bs-price-color:      {{ mb_price_color }};
    --bs-price-fs-d:       {{ mb_price_fs_d }};
    --bs-price-fs-m:       {{ mb_price_fs_m }};
    --bs-price-fw-d:       {{ mb_price_fw_d }};
    --bs-price-fw-m:       {{ mb_price_fw_m }};
    --bs-compare-color:    {{ mb_compare_color }};
    --bs-compare-fs-d:     {{ mb_compare_fs_d }};
    --bs-compare-fs-m:     {{ mb_compare_fs_m }};
    --bs-compare-fw-d:     {{ mb_compare_fw_d }};
    --bs-compare-fw-m:     {{ mb_compare_fw_m }};
    --bs-mt:               {{ mb_top }};
    --bs-mb:               {{ mb_bottom }};
  "
  aria-live="polite"
  aria-atomic="true"
><div class="bsw__prices">
    <span class="bsw__price" data-badge-price>{{ mb_price | money }}</span>

    <span
      class="bsw__compare{% unless mb_sale %} bsw__compare--hidden{% endunless %}"
      data-badge-compare
    >{% if mb_sale %}{{ mb_compare | money }}{% endif %}</span>
  </div>{%- if mb_show_pill -%}<span
    class="bsw__pill{% unless mb_sale %} bsw__pill--hidden{% endunless %}"
    data-badge-pill
    aria-hidden="true"
  >
    <span data-badge-label>{{ mb_label }}</span>&nbsp;<span data-badge-pct>{{ mb_pct }}%</span>
  </span>{%- endif -%}
</div>

<style>
#{{ bid }} *,
#{{ bid }} *::before,
#{{ bid }} *::after {
box-sizing: border-box;
}
#{{ bid }}.bsw {
display: flex;
flex-wrap: wrap;
align-items: center;
gap: 8px;
margin: var(--bs-mt) 0 var(--bs-mb);
font-family: 'Plus Jakarta Sans', sans-serif;
font-weight: 500;
letter-spacing: .6px;
text-align: left;
}
#{{ bid }} .bsw__prices {
display: flex;
flex-wrap: wrap;
align-items: baseline;
gap: 6px;
}
#{{ bid }} .bsw__price {
color: var(--bs-price-color);
font-size: var(--bs-price-fs-m);
font-weight: var(--bs-price-fw-m);
line-height: 1.2;
}
#{{ bid }} .bsw__compare {
color: var(--bs-compare-color);
font-size: var(--bs-compare-fs-m);
font-weight: var(--bs-compare-fw-m);
text-decoration: line-through;
line-height: 1.2;
}
#{{ bid }} .bsw__compare--hidden {
display: none;
}
#{{ bid }} .bsw__pill {
display: inline-flex;
align-items: center;
background-color: var(--bs-badge-bg);
color: var(--bs-badge-color);
border-radius: var(--bs-badge-radius);
padding: var(--bs-badge-pv) var(--bs-badge-ph);
font-size: var(--bs-badge-fs-m);
font-weight: var(--bs-badge-fw-m);
line-height: 1;
white-space: nowrap;
transition: opacity 0.2s ease;
}
#{{ bid }} .bsw__pill--hidden {
display: none;
}
@media screen and (min-width: 750px) {
#{{ bid }} .bsw__price {
font-size: var(--bs-price-fs-d);
font-weight: var(--bs-price-fw-d);
}
#{{ bid }} .bsw__compare {
font-size: var(--bs-compare-fs-d);
font-weight: var(--bs-compare-fw-d);
}
#{{ bid }} .bsw__pill {
font-size: var(--bs-badge-fs-d);
font-weight: var(--bs-badge-fw-d);
}
}
</style>

<script>
(function () {
'use strict';
var wrap = document.getElementById('{{ bid }}');
if (!wrap) return;
var priceEl = wrap.querySelector('[data-badge-price]');
var compareEl = wrap.querySelector('[data-badge-compare]');
var pillEl = wrap.querySelector('[data-badge-pill]');
var pctEl = wrap.querySelector('[data-badge-pct]');
var DBG = /[?&]mbdebug=1/.test(location.search);
function log() { if (DBG && window.console) console.log.apply(console, ['[sale-badge]'].concat([].slice.call(arguments))); }
var variants = [{%- if product -%}{%- for v in product.variants -%}{"id":{{ v.id }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endif -%}];
var variantMap = {};
variants.forEach(function (v) { variantMap[v.id] = v; });
var moneyFmt = {{ shop.money_format | json }};
var kachingOn = false;
var lastKey = '';
function formatMoney(cents) {
var amount = (cents / 100).toFixed(2);
var amountNoD = String(Math.round(cents / 100));
var amountComma = amount.replace('.', ',');
return moneyFmt
.replace(/\{\{\s*amount\s*\}\}/g, amount)
.replace(/\{\{\s*amount_no_decimals\s*\}\}/g, amountNoD)
.replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amountComma)
.replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, amountNoD.replace('.', ','));
}
function parseToCents(str) {
var s = String(str || '').replace(/[^\d.,]/g, '');
if (!s) return 0;
if (/,\d{2}$/.test(s) && s.indexOf('.') === -1) {
s = s.replace(',', '.');
} else {
s = s.replace(/,/g, '');
}
return Math.round(parseFloat(s) * 100) || 0;
}
function amountOf(t) {
var m = String(t || '').match(/\d[\d.,]*/);
return m ? parseToCents(m[0]) : 0;
}
function updateBadgeFromCents(priceCents, compareAtCents) {
if (priceEl) priceEl.textContent = formatMoney(priceCents);
if (compareAtCents && compareAtCents > priceCents) {
var pct = Math.round((compareAtCents - priceCents) / compareAtCents * 100);
if (compareEl) {
compareEl.textContent = formatMoney(compareAtCents);
compareEl.classList.remove('bsw__compare--hidden');
}
if (pctEl) pctEl.textContent = pct + '%';
if (pillEl) {
pillEl.classList.remove('bsw__pill--hidden');
pillEl.setAttribute('aria-hidden', 'false');
}
} else {
if (compareEl) compareEl.classList.add('bsw__compare--hidden');
if (pillEl) {
pillEl.classList.add('bsw__pill--hidden');
pillEl.setAttribute('aria-hidden', 'true');
}
}
}
function updateBadge(variant) {
if (!variant) return;
if (kachingOn) { kSoon(0); return; }
lastKey = '';
updateBadgeFromCents(variant.price, variant.compare_at_price || 0);
}
function getVariant(id) {
return variantMap[parseInt(id, 10)] || null;
}
document.addEventListener('variant:changed', function (e) {
if (e.detail && e.detail.variant) updateBadge(e.detail.variant);
});
document.addEventListener('product:variantChanged', function (e) {
if (e.detail && e.detail.variant) updateBadge(e.detail.variant);
});
document.addEventListener('change', function (e) {
var el = e.target;
if (!el) return;
if (el.name === 'id') {
var v = getVariant(el.value);
if (v) updateBadge(v);
}
{%- if mb_kaching %}
if (el.name === 'selling_plan') {
kBurst();
}
{%- endif %}
});
var hiddenInput = document.querySelector(
'[data-product-form] input[name="id"], form[action*="/cart/add"] input[name="id"]'
);
if (hiddenInput) {
var lastHiddenVal = hiddenInput.value;
new MutationObserver(function () {
if (hiddenInput.value !== lastHiddenVal) {
lastHiddenVal = hiddenInput.value;
var v = getVariant(lastHiddenVal);
if (v) updateBadge(v);
}
}).observe(hiddenInput, { attributes: true, attributeFilter: ['value'] });
setInterval(function () {
if (hiddenInput.value !== lastHiddenVal) {
lastHiddenVal = hiddenInput.value;
var v = getVariant(lastHiddenVal);
if (v) updateBadge(v);
}
}, 200);
}
{%- if mb_kaching %}
/* Kaching Bundles: the selected bar is the only source of the price, the crossed-out price and the Save x%. */
var kRootEl = null;
var kObs = null;
function kRoot() {
return document.querySelector('.kaching-bundles') || document.querySelector('[class*="kaching-bundles"]');
}
function kBars(root) {
var l = [].slice.call(root.querySelectorAll('.kaching-bundles__bar'));
if (l.length) return l;
l = [].slice.call(root.querySelectorAll('[role="radio"], [role="radiogroup"] > *, label'));
return l.filter(function (b) { return /\d/.test(b.textContent || ''); });
}
function isSel(b) {
if (/--(selected|active|checked)(\s|$)|(^|\s)(is-)?(selected|active|checked)(\s|$)/.test(String(b.className || ''))) return true;
if (b.getAttribute('aria-checked') === 'true' || b.getAttribute('aria-selected') === 'true' || b.getAttribute('data-selected') === 'true') return true;
return !!b.querySelector('input:checked, [aria-checked="true"], [aria-selected="true"]');
}
function kSelected(bars) {
var i;
for (i = 0; i < bars.length; i++) { if (isSel(bars[i])) return bars[i]; }
if (bars.length > 2) {
var keys = bars.map(function (b) { var s = getComputedStyle(b); return s.borderTopColor + '|' + s.borderTopWidth + '|' + s.backgroundColor; });
var uniq = [];
for (i = 0; i < bars.length; i++) {
if (keys.filter(function (k) { return k === keys[i]; }).length === 1) uniq.push(bars[i]);
}
if (uniq.length === 1) return uniq[0];
}
return bars[0] || null;
}
function kRead(b) {
var pe = b.querySelector('.kaching-bundles__bar-price');
var ce = b.querySelector('.kaching-bundles__bar-full-price');
var p = pe ? amountOf(pe.innerText || pe.textContent) : 0;
var c = ce ? amountOf(ce.innerText || ce.textContent) : 0;
if (p > 0) return { p: p, c: c, how: 'classes' };
var els = b.querySelectorAll('*'), i, e, t, s, a;
p = 0; c = 0;
for (i = 0; i < els.length; i++) {
e = els[i];
if (e.children.length) continue;
t = (e.textContent || '').trim();
if (!t || t.length > 16 || !/\d/.test(t) || /save|off|each|per|free|%|\//i.test(t)) continue;
a = amountOf(t);
if (!a) continue;
s = getComputedStyle(e);
if (/line-through/.test(s.textDecorationLine || s.textDecoration || '')) { if (!c) c = a; } else if (!p) { p = a; }
}
return { p: p, c: c, how: 'scan' };
}
function kApply(why) {
var root = kRoot();
if (!root) return false;
var bars = kBars(root);
if (!bars.length) return false;
var sel = kSelected(bars);
var r = kRead(sel);
if (why !== 'poll') log(why, 'bars:', bars.length, 'selected #', bars.indexOf(sel), r);
if (!(r.p > 0)) return false;
kachingOn = true;
var key = r.p + '/' + r.c;
if (key === lastKey) return true;
lastKey = key;
updateBadgeFromCents(r.p, r.c);
return true;
}
function kSoon(delay) {
setTimeout(function () { kApply('event'); }, delay || 0);
}
function kBurst() {
kSoon(0); kSoon(80); kSoon(250); kSoon(600);
}
function kAttach() {
var root = kRoot();
if (!root) return false;
if (root !== kRootEl) {
if (kObs) kObs.disconnect();
kRootEl = root;
kObs = new MutationObserver(function () { kSoon(30); });
kObs.observe(root, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['class', 'checked', 'aria-checked', 'aria-selected', 'data-selected'] });
kApply('attach');
}
return true;
}
function inKaching(e) {
return e.target && e.target.closest && e.target.closest('[class*="kaching-bundles"]');
}
document.addEventListener('click', function (e) { if (inKaching(e)) kBurst(); }, true);
document.addEventListener('change', function (e) { if (inKaching(e)) kBurst(); }, true);
kAttach();
setInterval(function () { if (!document.hidden) { kAttach(); kApply('poll'); } }, 700);
['kaching:price:updated', 'kaching:bundle:selected', 'kaching:subscription:changed', 'kaching:subscription:toggled', 'kaching:autoship:changed', 'kaching:selling_plan:changed'].forEach(function (ev) {
document.addEventListener(ev, kBurst);
});
{%- endif %}
})();
</script>
