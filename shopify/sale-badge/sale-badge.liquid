{%- comment -%}
  Sale price row, exact copy of Metabolae's (price, crossed-out price, sale pill). Add as a Custom Liquid block on the PRODUCT page above the bundle bars.
  Prices follow the selected variant and the selected Kaching Bundles bar. mb_label = pill text. _d = desktop, _m = mobile. mb_kaching = false if no Kaching.
  Do not use a straight apostrophe (') in the text, use &#39; instead.
{%- endcomment -%}
{%- assign mb_label = 'Summer Sale - Save' -%}
{%- assign mb_badge_bg = '#943434' -%}
{%- assign mb_badge_color = '#ffffff' -%}
{%- assign mb_badge_radius = '6px' -%}
{%- assign mb_badge_pv = '6px' -%}
{%- assign mb_badge_ph = '10px' -%}
{%- assign mb_badge_fs_d = '12px' -%}
{%- assign mb_badge_fs_m = '11px' -%}
{%- assign mb_badge_fw_d = '700' -%}
{%- assign mb_badge_fw_m = '700' -%}
{%- assign mb_price_color = '#943434' -%}
{%- assign mb_price_fs_d = '17px' -%}
{%- assign mb_price_fs_m = '17px' -%}
{%- assign mb_price_fw_d = '700' -%}
{%- assign mb_price_fw_m = '600' -%}
{%- assign mb_compare_color = '#444444' -%}
{%- assign mb_compare_fs_d = '15px' -%}
{%- assign mb_compare_fs_m = '15px' -%}
{%- assign mb_compare_fw_d = '600' -%}
{%- assign mb_compare_fw_m = '600' -%}
{%- assign mb_top = '16px' -%}
{%- assign mb_bottom = '16px' -%}
{%- assign mb_kaching = true -%}
{%- assign mb_demo_price = 5999 -%}
{%- assign mb_demo_compare = 17997 -%}

{%- if product -%}
  {%- assign mb_v = product.selected_or_first_available_variant -%}
  {%- assign mb_price = mb_v.price -%}
  {%- assign mb_compare = mb_v.compare_at_price | default: 0 -%}
{%- else -%}
  {%- assign mb_price = mb_demo_price -%}
  {%- assign mb_compare = mb_demo_compare -%}
{%- endif -%}
{%- assign mb_sale = false -%}
{%- if mb_compare > mb_price -%}{%- assign mb_sale = true -%}{%- endif -%}
{%- assign mb_pct = 0 -%}
{%- if mb_sale -%}{%- assign mb_pct = mb_compare | minus: mb_price | times: 100.0 | divided_by: mb_compare | round -%}{%- endif -%}
{%- assign bid = 'badge-sale-' | append: section.id -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<div
  id="{{ bid }}"
  class="bsw"
  style="
    --bs-badge-bg:         {{ mb_badge_bg }};
    --bs-badge-radius:     {{ mb_badge_radius }};
    --bs-badge-color:      {{ mb_badge_color }};
    --bs-badge-pv:         {{ mb_badge_pv }};
    --bs-badge-ph:         {{ mb_badge_ph }};
    --bs-badge-fs-d:       {{ mb_badge_fs_d }};
    --bs-badge-fs-m:       {{ mb_badge_fs_m }};
    --bs-badge-fw-d:       {{ mb_badge_fw_d }};
    --bs-badge-fw-m:       {{ mb_badge_fw_m }};
    --bs-price-color:      {{ mb_price_color }};
    --bs-price-fs-d:       {{ mb_price_fs_d }};
    --bs-price-fs-m:       {{ mb_price_fs_m }};
    --bs-price-fw-d:       {{ mb_price_fw_d }};
    --bs-price-fw-m:       {{ mb_price_fw_m }};
    --bs-compare-color:    {{ mb_compare_color }};
    --bs-compare-fs-d:     {{ mb_compare_fs_d }};
    --bs-compare-fs-m:     {{ mb_compare_fs_m }};
    --bs-compare-fw-d:     {{ mb_compare_fw_d }};
    --bs-compare-fw-m:     {{ mb_compare_fw_m }};
    --bs-mt:               {{ mb_top }};
    --bs-mb:               {{ mb_bottom }};
  "
  aria-live="polite"
  aria-atomic="true"
><div class="bsw__prices">
    <span class="bsw__price" data-badge-price>{{ mb_price | money }}</span>

    <span
      class="bsw__compare{% unless mb_sale %} bsw__compare--hidden{% endunless %}"
      data-badge-compare
    >{% if mb_sale %}{{ mb_compare | money }}{% endif %}</span>
  </div><span
    class="bsw__pill{% unless mb_sale %} bsw__pill--hidden{% endunless %}"
    data-badge-pill
    aria-hidden="true"
  >
    <span data-badge-label>{{ mb_label }}</span>&nbsp;<span data-badge-pct>{{ mb_pct }}%</span>
  </span>
</div>

<style>
#{{ bid }} *,
#{{ bid }} *::before,
#{{ bid }} *::after {
box-sizing: border-box;
}
#{{ bid }}.bsw {
display: flex;
flex-wrap: wrap;
align-items: center;
gap: 8px;
margin: var(--bs-mt) 0 var(--bs-mb);
font-family: 'Plus Jakarta Sans', sans-serif;
font-weight: 500;
letter-spacing: .6px;
text-align: left;
}
#{{ bid }} .bsw__prices {
display: flex;
flex-wrap: wrap;
align-items: baseline;
gap: 6px;
}
#{{ bid }} .bsw__price {
color: var(--bs-price-color);
font-size: var(--bs-price-fs-m);
font-weight: var(--bs-price-fw-m);
line-height: 1.2;
}
#{{ bid }} .bsw__compare {
color: var(--bs-compare-color);
font-size: var(--bs-compare-fs-m);
font-weight: var(--bs-compare-fw-m);
text-decoration: line-through;
line-height: 1.2;
}
#{{ bid }} .bsw__compare--hidden {
display: none;
}
#{{ bid }} .bsw__pill {
display: inline-flex;
align-items: center;
background-color: var(--bs-badge-bg);
color: var(--bs-badge-color);
border-radius: var(--bs-badge-radius);
padding: var(--bs-badge-pv) var(--bs-badge-ph);
font-size: var(--bs-badge-fs-m);
font-weight: var(--bs-badge-fw-m);
line-height: 1;
white-space: nowrap;
transition: opacity 0.2s ease;
}
#{{ bid }} .bsw__pill--hidden {
display: none;
}
@media screen and (min-width: 750px) {
#{{ bid }} .bsw__price {
font-size: var(--bs-price-fs-d);
font-weight: var(--bs-price-fw-d);
}
#{{ bid }} .bsw__compare {
font-size: var(--bs-compare-fs-d);
font-weight: var(--bs-compare-fw-d);
}
#{{ bid }} .bsw__pill {
font-size: var(--bs-badge-fs-d);
font-weight: var(--bs-badge-fw-d);
}
}
</style>

<script>
(function () {
'use strict';
var wrap = document.getElementById('{{ bid }}');
if (!wrap) return;
var priceEl = wrap.querySelector('[data-badge-price]');
var compareEl = wrap.querySelector('[data-badge-compare]');
var pillEl = wrap.querySelector('[data-badge-pill]');
var pctEl = wrap.querySelector('[data-badge-pct]');
var variants = [{%- if product -%}{%- for v in product.variants -%}{"id":{{ v.id }},"price":{{ v.price }},"compare_at_price":{{ v.compare_at_price | default: 0 }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endif -%}];
var variantMap = {};
variants.forEach(function (v) { variantMap[v.id] = v; });
var moneyFmt = {{ shop.money_format | json }};
function formatMoney(cents) {
var amount = (cents / 100).toFixed(2);
var amountNoD = String(Math.round(cents / 100));
var amountComma = amount.replace('.', ',');
return moneyFmt
.replace(/\{\{\s*amount\s*\}\}/g, amount)
.replace(/\{\{\s*amount_no_decimals\s*\}\}/g, amountNoD)
.replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, amountComma)
.replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/g, amountNoD.replace('.', ','));
}
function parseToCents(str) {
var s = str.replace(/[^\d.,]/g, '');
if (!s) return 0;
if (/,\d{2}$/.test(s) && s.indexOf('.') === -1) {
s = s.replace(',', '.');
} else {
s = s.replace(/,/g, '');
}
return Math.round(parseFloat(s) * 100) || 0;
}
function updateBadgeFromCents(priceCents, compareAtCents) {
if (priceEl) priceEl.textContent = formatMoney(priceCents);
if (compareAtCents && compareAtCents > priceCents) {
var pct = Math.round((compareAtCents - priceCents) / compareAtCents * 100);
if (compareEl) {
compareEl.textContent = formatMoney(compareAtCents);
compareEl.classList.remove('bsw__compare--hidden');
}
pctEl.textContent = pct + '%';
pillEl.classList.remove('bsw__pill--hidden');
pillEl.setAttribute('aria-hidden', 'false');
} else {
if (compareEl) compareEl.classList.add('bsw__compare--hidden');
pillEl.classList.add('bsw__pill--hidden');
pillEl.setAttribute('aria-hidden', 'true');
}
}
function updateBadge(variant) {
if (!variant) return;
updateBadgeFromCents(variant.price, variant.compare_at_price || 0);
}
function getVariant(id) {
return variantMap[parseInt(id, 10)] || null;
}
document.addEventListener('variant:changed', function (e) {
if (e.detail && e.detail.variant) updateBadge(e.detail.variant);
});
document.addEventListener('product:variantChanged', function (e) {
if (e.detail && e.detail.variant) updateBadge(e.detail.variant);
});
document.addEventListener('change', function (e) {
var el = e.target;
if (!el) return;
if (el.name === 'id') {
var v = getVariant(el.value);
if (v) updateBadge(v);
}
{%- if mb_kaching %}
if (el.name === 'selling_plan') {
setTimeout(readKachingPrices, 250);
}
{%- endif %}
});
var hiddenInput = document.querySelector(
'[data-product-form] input[name="id"], form[action*="/cart/add"] input[name="id"]'
);
if (hiddenInput) {
var lastHiddenVal = hiddenInput.value;
new MutationObserver(function () {
if (hiddenInput.value !== lastHiddenVal) {
lastHiddenVal = hiddenInput.value;
var v = getVariant(lastHiddenVal);
if (v) updateBadge(v);
}
}).observe(hiddenInput, { attributes: true, attributeFilter: ['value'] });
setInterval(function () {
if (hiddenInput.value !== lastHiddenVal) {
lastHiddenVal = hiddenInput.value;
var v = getVariant(lastHiddenVal);
if (v) updateBadge(v);
}
}, 200);
}
{%- if mb_kaching %}
var _kTimer = null;
var _kLastPrice = -1;
var _kLastCompare = -1;
function getActiveKachingElements() {
var selBar = document.querySelector('.kaching-bundles__bar--selected, .kaching-bundles__bar--active');
if (selBar) {
var sbp = selBar.querySelector('.kaching-bundles__bar-price');
var sbfp = selBar.querySelector('.kaching-bundles__bar-full-price');
if (sbp && sbfp) return { barPrice: sbp, barFullPrice: sbfp };
}
var kachingWrap = document.querySelector('.kaching-bundles');
if (kachingWrap) {
var checked = kachingWrap.querySelector('input[type="radio"]:checked');
if (checked) {
var row = checked.parentElement;
while (row && row !== kachingWrap) {
var bp = row.querySelector('.kaching-bundles__bar-price');
var bfp = row.querySelector('.kaching-bundles__bar-full-price');
if (bp && bfp) return { barPrice: bp, barFullPrice: bfp };
row = row.parentElement;
}
}
}
var activeCandidates = [
'.kaching-bundles__bar--selected',
'.kaching-bundles__bar--active',
'.kaching-bundles__bar.is-selected',
'.kaching-bundles__bar.is-active',
'.kaching-bundles__bar.selected',
'.kaching-bundles__bar.active'
];
for (var i = 0; i < activeCandidates.length; i++) {
var activeRow = document.querySelector(activeCandidates[i]);
if (activeRow) {
var abp = activeRow.querySelector('.kaching-bundles__bar-price');
var abfp = activeRow.querySelector('.kaching-bundles__bar-full-price');
if (abp && abfp) return { barPrice: abp, barFullPrice: abfp };
}
}
return {
barPrice: document.querySelector('.kaching-bundles__bar-price'),
barFullPrice: document.querySelector('.kaching-bundles__bar-full-price')
};
}
function readKachingPrices() {
if (_kTimer) clearTimeout(_kTimer);
_kTimer = setTimeout(function () {
var els = getActiveKachingElements();
var barPrice = els.barPrice;
var barFullPrice = els.barFullPrice;
if (!barPrice || !barFullPrice) return;
var priceText = (barPrice.innerText || '').trim();
var fullPriceText = (barFullPrice.innerText || '').trim();
if (!priceText || !fullPriceText) return;
var priceCents = parseToCents(priceText);
var compareAtCents = parseToCents(fullPriceText);
if (priceCents <= 0 || compareAtCents <= 0) return;
if (priceCents === _kLastPrice && compareAtCents === _kLastCompare) return;
_kLastPrice = priceCents;
_kLastCompare = compareAtCents;
updateBadgeFromCents(priceCents, compareAtCents);
}, 50);
}
function attachKachingObserver() {
var barPrice = document.querySelector('.kaching-bundles__bar-price');
var barFullPrice = document.querySelector('.kaching-bundles__bar-full-price');
if (!barPrice || !barFullPrice) return false;
readKachingPrices();
var directObs = new MutationObserver(readKachingPrices);
directObs.observe(barPrice, { subtree: true, childList: true, characterData: true });
directObs.observe(barFullPrice, { subtree: true, childList: true, characterData: true });
var kachingRoot = (
document.querySelector('.kaching-bundles__bar-pricing') ||
document.querySelector('.kaching-bundles__bar-wrapper') ||
document.querySelector('.kaching-bundles') ||
document.querySelector('[id^="MainProduct"]') ||
document.querySelector('.product__info-container') ||
document.querySelector('.product-single') ||
document.querySelector('[data-product-form]') ||
document.querySelector('main')
);
if (kachingRoot) {
new MutationObserver(readKachingPrices)
.observe(kachingRoot, { subtree: true, childList: true, characterData: true });
}
var barsRoot = document.querySelector('.kaching-bundles__bars') || document.querySelector('.kaching-bundles');
if (barsRoot) {
new MutationObserver(readKachingPrices).observe(barsRoot, {
attributes: true,
attributeFilter: ['class', 'checked', 'aria-checked', 'aria-selected'],
subtree: true
});
}
return true;
}
document.addEventListener('click', function (e) {
if (e.target && e.target.closest && e.target.closest('.kaching-bundles')) setTimeout(readKachingPrices, 80);
}, true);
document.addEventListener('change', function (e) {
if (e.target && e.target.closest && e.target.closest('.kaching-bundles')) setTimeout(readKachingPrices, 80);
}, true);
if (!attachKachingObserver()) {
var _kPollN = 0;
var _kPoll = setInterval(function () {
_kPollN++;
if (attachKachingObserver() || _kPollN >= 50) {
clearInterval(_kPoll);
}
}, 100);
}
document.addEventListener('kaching:price:updated', readKachingPrices);
document.addEventListener('kaching:bundle:selected', readKachingPrices);
document.addEventListener('kaching:subscription:changed', readKachingPrices);
document.addEventListener('kaching:subscription:toggled', readKachingPrices);
document.addEventListener('kaching:autoship:changed', readKachingPrices);
document.addEventListener('kaching:selling_plan:changed', readKachingPrices);
{%- endif %}
})();
</script>
