{%- comment -%}
  Early Black Friday announcement bar with a countdown (copy of the pink-dot bar with white timer boxes), in plum.
  WHERE: Online Store > Themes > Customize > Header (top of the left list) > Add section > Custom Liquid, drag it to the very top, paste this in.
  In that Custom Liquid section set Top padding and Bottom padding to 0. Remove or hide your old announcement bar so you do not have two.
  EDIT YOUR CONTENT BELOW.
  mb_title = the big top line. mb_sub = the small line under it with the pulsing dot.
  mb_bg = bar background. mb_text = colour of the text (locked so the theme cannot change it).
  mb_dot = colour of the pulsing dot. mb_box = colour of the three timer boxes (the numbers inside use the bar background colour).
  mb_end = leave '' for an evergreen timer that starts again when it reaches zero,
  or set a real end date, e.g. '2026-11-27T23:59:59-05:00', to count down to it (it then stops at 00:00:00).
  mb_hours = length of the evergreen timer in hours.
  Do not use a straight apostrophe (') inside the text, use &#39; instead.
{%- endcomment -%}
{%- assign mb_title = 'Early Black Friday' -%}
{%- assign mb_sub = '50% Off + Free Gifts' -%}
{%- assign mb_bg = '#250812' -%}
{%- assign mb_text = '#ffffff' -%}
{%- assign mb_dot = '#F7B8CD' -%}
{%- assign mb_box = '#ffffff' -%}
{%- assign mb_end = '' -%}
{%- assign mb_hours = 12 -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"></noscript>

<style>
.page-width:has(>.mb-bf){max-width:none;padding:0}
div[class*="-padding"]:has(>.mb-bf){padding-top:0!important;padding-bottom:0!important}
.mb-bf{box-sizing:border-box;width:100%;margin:0;background:var(--mb-bf-bg)!important;border-bottom:1px solid rgba(255,255,255,.08);font-family:Poppins,sans-serif;font-weight:500}
.mb-bf *{box-sizing:border-box}
.mb-bf,.mb-bf *{color:var(--mb-bf-tx)!important;-webkit-text-fill-color:var(--mb-bf-tx)!important}
.mb-bf__in{display:flex;align-items:center;justify-content:center;gap:28px;max-width:1200px;min-height:62px;margin:0 auto;padding:8px 16px}
.mb-bf__txt{display:flex;flex-direction:column;align-items:flex-start;gap:3px;min-width:0}
.mb-bf__top,.mb-bf__sub{margin:0;padding:0;border:0;text-decoration:none}
.mb-bf__top{font-family:Poppins,sans-serif;font-size:18px;font-weight:700;line-height:1.15;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}
.mb-bf__sub{display:inline-flex;align-items:center;gap:7px;font-family:Poppins,sans-serif;font-size:13px;font-weight:600;line-height:1.2;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}
.mb-bf__dot{position:relative;display:block;flex:none;width:8px;height:8px;border-radius:50%;background:var(--mb-bf-dot)}
.mb-bf__dot::after{content:'';position:absolute;top:-4px;right:-4px;bottom:-4px;left:-4px;border-radius:50%;background:var(--mb-bf-dot);opacity:.35;animation:mbbfp 1.8s ease-out infinite}
@keyframes mbbfp{0%{transform:scale(.5);opacity:.35}100%{transform:scale(1.5);opacity:0}}
.mb-bf__cd{display:flex;align-items:flex-start;gap:4px;flex:none}
.mb-bf__blk{display:flex;flex-direction:column;align-items:center}
.mb-bf__num{display:flex;align-items:center;justify-content:center;width:34px;height:30px;border-radius:8px;background:var(--mb-bf-box)!important;font-size:17px;font-weight:700;line-height:1;font-variant-numeric:tabular-nums}
.mb-bf .mb-bf__num{color:var(--mb-bf-bg)!important;-webkit-text-fill-color:var(--mb-bf-bg)!important}
.mb-bf__lbl{margin-top:4px;font-size:10px;font-weight:500;line-height:1.2;opacity:.85}
.mb-bf__sep{width:10px;font-size:18px;font-weight:700;line-height:30px;text-align:center}
@media (prefers-reduced-motion:reduce){.mb-bf__dot::after{animation:none}}
@media screen and (max-width:640px){
.mb-bf__in{gap:14px;min-height:45px;padding:5px 8px}
.mb-bf__txt{gap:3px}
.mb-bf__top{font-size:clamp(11.5px,3.7vw,14px)}
.mb-bf__sub{gap:6px;font-size:10.5px}
.mb-bf__dot{width:7px;height:7px}
.mb-bf__cd{gap:3px}
.mb-bf__num{width:26px;height:22px;border-radius:6px;font-size:13px}
.mb-bf__lbl{margin-top:3px;font-size:8.5px}
.mb-bf__sep{width:8px;font-size:14px;line-height:22px}
}
@media screen and (max-width:374px){
.mb-bf__in{gap:10px;padding:5px 6px}
.mb-bf__sub{font-size:9.5px}
.mb-bf__cd{gap:2px}
.mb-bf__num{width:23px;height:20px;font-size:12px}
.mb-bf__lbl{font-size:8px}
.mb-bf__sep{width:6px;font-size:12px;line-height:20px}
}
</style>

<div class="mb-bf" style="--mb-bf-bg:{{ mb_bg }};--mb-bf-tx:{{ mb_text }};--mb-bf-dot:{{ mb_dot }};--mb-bf-box:{{ mb_box }}" data-end="{{ mb_end | escape }}" data-hours="{{ mb_hours }}">
<div class="mb-bf__in">
<div class="mb-bf__txt">
<p class="mb-bf__top">{{ mb_title }}</p>
{%- if mb_sub != blank -%}<span class="mb-bf__sub"><i class="mb-bf__dot" aria-hidden="true"></i>{{ mb_sub }}</span>{%- endif -%}
</div>
<div class="mb-bf__cd" role="timer" aria-label="Offer ends in">
<div class="mb-bf__blk"><span class="mb-bf__num" data-h>{% if mb_hours < 10 %}0{% endif %}{{ mb_hours }}</span><span class="mb-bf__lbl">Hours</span></div>
<div class="mb-bf__sep" aria-hidden="true">:</div>
<div class="mb-bf__blk"><span class="mb-bf__num" data-m>00</span><span class="mb-bf__lbl">Min</span></div>
<div class="mb-bf__sep" aria-hidden="true">:</div>
<div class="mb-bf__blk"><span class="mb-bf__num" data-s>00</span><span class="mb-bf__lbl">Sec</span></div>
</div>
</div>
</div>

<script>
(function(){
function init(root){
if(root.getAttribute('data-on'))return;
root.setAttribute('data-on','1');
var h=root.querySelector('[data-h]'),m=root.querySelector('[data-m]'),s=root.querySelector('[data-s]');
if(!h||!m||!s)return;
var hrs=parseFloat(root.getAttribute('data-hours'));if(!(hrs>0))hrs=12;
var D=hrs*36e5,K='mb_bf_timer_end',E=Date.parse(root.getAttribute('data-end')||''),fixed=E==E,end=fixed?E:0,t,ph,pm,ps;
if(!fixed){try{end=+localStorage.getItem(K)||0}catch(e){}if(end-Date.now()>D)end=0}
function reset(){end=Date.now()+D;try{localStorage.setItem(K,end)}catch(e){}}
function p(n){return n<10?'0'+n:''+n}
function tick(){
clearTimeout(t);
if(!root.isConnected)return;
var left=end-Date.now();
if(left<=0){if(fixed)left=0;else{reset();left=D-1}}
var q=left/1e3|0,a=p(q/3600|0),b=p(q%3600/60|0),c=p(q%60);
if(a!==ph)h.textContent=ph=a;
if(b!==pm)m.textContent=pm=b;
if(c!==ps)s.textContent=ps=c;
if(!document.hidden&&left>0)t=setTimeout(tick,left%1e3+5);
}
if(!fixed&&end<=Date.now())reset();
document.addEventListener('visibilitychange',tick);
tick();
}
document.querySelectorAll('.mb-bf').forEach(init);
document.addEventListener('shopify:section:load',function(){document.querySelectorAll('.mb-bf').forEach(init)});
})();
</script>
