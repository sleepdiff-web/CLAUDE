{%- comment -%}
  EDIT YOUR CONTENT BELOW. One bullet per entry, put @@ on its own line between bullets.
  Add or remove bullets freely. Do not use a straight apostrophe (') inside the text (use &#39; instead).
  mb_icon      = optional image URL for the tick (any square image, shown 16px wide). Leave '' to use the built-in round tick.
  mb_icon_color = colour of the built-in round tick.
  mb_text_color = colour of the bullet text.
{%- endcomment -%}
{%- assign mb_icon = '' -%}
{%- assign mb_icon_color = '#c47245' -%}
{%- assign mb_text_color = '#444444' -%}
{%- capture mb_data -%}
Restores Insulin Sensitivity
@@
Stabilizes Blood Sugar Levels
@@
Supports Blood Pressure Naturally
@@
Supports Steady Energy
{%- endcapture -%}
{%- assign mb_items = mb_data | split: '@@' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.mb-sp{display:flex;flex-direction:column;margin:0;font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:500;line-height:1.8;letter-spacing:.6px;text-align:left}
.mb-sp__it{display:flex;align-items:center;margin:0 0 12px}
.mb-sp__ic{display:block;flex:none;width:16px;height:auto;margin:0 10px 0 0;color:var(--mb-sp-ic,#c47245)}
.mb-sp__t{display:flex;align-items:center;width:100%;font-size:15px;line-height:1.2;color:var(--mb-sp-tx,#444)}
</style>

{%- capture mb_svg -%}
<svg class="mb-sp__ic" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="8" fill="currentColor"/><path d="M4.6 8.4l2.6 2.4 4.6-5.4" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcapture -%}
<div class="mb-sp" role="list" style="--mb-sp-ic:{{ mb_icon_color }};--mb-sp-tx:{{ mb_text_color }}">
{%- for it in mb_items -%}
<div class="mb-sp__it" role="listitem">
{%- if mb_icon != blank -%}<img class="mb-sp__ic" src="{{ mb_icon }}" width="16" height="16" alt="" loading="lazy" decoding="async">{%- else -%}{{ mb_svg }}{%- endif -%}
<div class="mb-sp__t"><span>{{ it | strip }}</span></div></div>
{%- endfor -%}
</div>
