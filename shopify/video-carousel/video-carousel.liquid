<section class="mb-vc" style="--mb-vc-ac:{{ mb_accent }};--mb-vc-hc:{{ mb_heading_color }};--mb-vc-sc:{{ mb_sub_color }};background:{{ mb_bg }}!important">
  <div class="mb-vc__hd"><h2 class="mb-vc__h">{{ mb_heading }}</h2><p class="mb-vc__sh">{{ mb_sub }}</p></div>
  <div class="mb-vc__tw">
    <div class="mb-vc__tk" aria-live="polite">
{%- for mb_item in mb_items -%}
{%- assign mb_f = mb_item | split: '|||' -%}
{%- assign mb_vid = mb_f[0] | strip -%}
{%- assign mb_pic = mb_f[1] | strip -%}
{%- assign mb_alt = mb_f[2] | strip -%}
{%- assign mb_type = 'mp4' -%}
{%- if mb_vid contains 'youtu' -%}{%- assign mb_type = 'youtube' -%}{%- elsif mb_vid contains 'vimeo' -%}{%- assign mb_type = 'vimeo' -%}{%- endif -%}
{%- assign mb_q = '?' -%}{%- if mb_pic contains '?' -%}{%- assign mb_q = '&amp;' -%}{%- endif %}
<div class="mb-vc__card" data-video-url="{{ mb_vid }}" data-video-type="{{ mb_type }}" role="group" aria-label="{{ forloop.index }} / {{ forloop.length }}"><div class="mb-vc__ci"><img class="mb-vc__th" src="{{ mb_pic }}{{ mb_q }}width=400" alt="{{ mb_alt | escape }}" loading="lazy" width="400"><div class="mb-vc__ov"></div><div class="mb-vc__pl"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg></div></div></div>
{%- endfor %}
    </div>
  </div>
  <div class="mb-vc__dots"></div>
  <div class="mb-vc__ars">
    <button type="button" class="mb-vc__ar mb-vc__prev" aria-label="Previous slide">&lsaquo;</button>
    <button type="button" class="mb-vc__ar mb-vc__next" aria-label="Next slide">&rsaquo;</button>
  </div>
