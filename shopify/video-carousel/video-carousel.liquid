<style>
.page-width:has(>.mb-vc){max-width:none;padding:0}
.mb-vc,.mb-vc *,.mb-vc *::before,.mb-vc *::after{box-sizing:border-box}
.mb-vc{display:block;margin:0;padding:72px 0 32px;overflow:hidden;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-size:15px;font-weight:500;line-height:1.8;letter-spacing:.6px;text-align:left}
@media screen and (min-width:750px){.mb-vc{font-size:16px}}
.mb-vc .mb-vc__hd{margin-bottom:36px;padding:0 20px;text-align:center}
.mb-vc .mb-vc__h{margin:0 0 10px;padding:0;font-family:Poppins,system-ui,sans-serif;font-size:clamp(26px,3.5vw,36px);font-style:normal;font-weight:400!important;line-height:1.2;letter-spacing:.6px;text-align:center;text-transform:none;color:var(--mb-vc-hc)!important;-webkit-text-fill-color:var(--mb-vc-hc)!important}
.mb-vc .mb-vc__h em{font-style:normal;color:var(--mb-vc-ac)!important;-webkit-text-fill-color:var(--mb-vc-ac)!important}
.mb-vc .mb-vc__sh{margin:0;padding:0;font-size:15px;font-style:normal!important;font-weight:400!important;line-height:1.5;letter-spacing:.6px;text-align:center;text-transform:none;color:var(--mb-vc-sc)!important;-webkit-text-fill-color:var(--mb-vc-sc)!important}
.mb-vc .mb-vc__sh strong{font-weight:700!important}
.mb-vc .mb-vc__tw{position:relative;max-width:1200px;margin:0 auto;overflow:hidden}
.mb-vc .mb-vc__tw.is-init{touch-action:pan-y}
.mb-vc .mb-vc__tk{display:flex;gap:12px;margin:0;padding:12px;transition-property:transform}
.mb-vc .mb-vc__card{position:relative;flex:0 0 auto;width:200px;overflow:hidden;border-radius:12px;background:#111;box-shadow:0 4px 16px rgba(0,0,0,.12);cursor:pointer;transition:transform .25s ease,box-shadow .25s ease}
@media screen and (min-width:1024px){.mb-vc .mb-vc__tw.is-init .mb-vc__card{width:auto}}
.mb-vc .mb-vc__card:hover{transform:scale(1.03);box-shadow:0 8px 28px rgba(0,0,0,.2)}
.mb-vc .mb-vc__ci{position:relative;width:100%;aspect-ratio:9 / 16;overflow:hidden;background:#000}
.mb-vc .mb-vc__th{display:block;width:100%;max-width:none;height:100%;border:0;object-fit:cover;transition:transform .4s ease}
.mb-vc .mb-vc__card:hover .mb-vc__th{transform:scale(1.05)}
.mb-vc .mb-vc__pl{position:absolute;top:50%;left:50%;z-index:2;display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:50%;box-shadow:0 4px 16px rgba(0,0,0,.25);transform:translate(-50%,-50%);transition:transform .2s ease,background-color .2s ease;background:var(--mb-vc-ac)!important}
.mb-vc .mb-vc__pl svg{width:20px;height:20px;margin-left:3px}
.mb-vc .mb-vc__pl svg,.mb-vc .mb-vc__pl svg *{fill:#fff!important;stroke:none!important}
.mb-vc .mb-vc__card:hover .mb-vc__pl{transform:translate(-50%,-50%) scale(1.12)}
.mb-vc .mb-vc__ov{position:absolute;inset:0;z-index:1;display:block!important;background:linear-gradient(to bottom,rgba(0,0,0,.05) 60%,rgba(0,0,0,.45) 100%)}
.mb-vc .mb-vc__dots{display:flex!important;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;margin:24px 0 0;padding:0 20px}
.mb-vc .mb-vc__dot{flex-shrink:0;width:8px;height:8px;margin:0;padding:0;border:none;border-radius:50%;cursor:pointer;transition:background-color .25s ease,width .25s ease,border-radius .25s ease;background:#d9d9d9!important}
.mb-vc .mb-vc__dot.is-on{width:24px;border-radius:4px;background:var(--mb-vc-ac)!important}
.mb-vc .mb-vc__ars{display:flex;justify-content:center;gap:12px;margin-top:20px}
.mb-vc .mb-vc__ar{display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:1.5px solid #d9d9d9;border-radius:50%;font-size:18px;cursor:pointer;transition:border-color .2s ease,background .2s ease;background:none!important;color:#1a1a1a!important;-webkit-text-fill-color:#1a1a1a!important}
.mb-vc .mb-vc__ar:hover{border-color:var(--mb-vc-ac);color:var(--mb-vc-ac)!important;-webkit-text-fill-color:var(--mb-vc-ac)!important}
.mb-vc .mb-vc__ar:disabled{opacity:.35!important;border-color:#d9d9d9!important;color:#8c8c8c!important;-webkit-text-fill-color:#8c8c8c!important;cursor:default!important;background:none!important}
