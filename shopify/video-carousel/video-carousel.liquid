.mb-vc .mb-vc__iv{display:block;width:100%;max-width:none;height:100%;border:none;object-fit:cover}
.mb-vc .mb-vc__ic{position:absolute;inset:0;z-index:5;pointer-events:none}
.mb-vc .mb-vc__ipo{position:absolute;top:50%;left:50%;display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:50%;opacity:0;transform:translate(-50%,-50%);transition:opacity .3s ease;pointer-events:auto;cursor:pointer;background:rgba(0,0,0,.5)!important}
.mb-vc .mb-vc__ipo svg{width:24px;height:24px}
.mb-vc .mb-vc__imb{position:absolute;right:12px;bottom:12px;z-index:6;display:flex;align-items:center;justify-content:center;width:32px;height:32px;border:none;border-radius:50%;cursor:pointer;pointer-events:auto;background:rgba(0,0,0,.6)!important}
.mb-vc .mb-vc__imb svg{width:16px;height:16px}
.mb-vc .mb-vc__ipo svg,.mb-vc .mb-vc__ipo svg *,.mb-vc .mb-vc__imb svg,.mb-vc .mb-vc__imb svg *{fill:#fff!important;stroke:none!important}
@media screen and (max-width:767px){
.mb-vc{padding-top:30px!important;padding-bottom:30px!important}
.mb-vc .mb-vc__hd{margin-bottom:18px!important}
.mb-vc .mb-vc__card{width:calc((100vw - 32px - 8px) / 3.5)}
.mb-vc .mb-vc__h{font-size:22px!important;font-weight:400!important;white-space:nowrap!important}
.mb-vc .mb-vc__pl{width:32px!important;height:32px!important;box-shadow:0 2px 8px rgba(0,0,0,.2)!important}
.mb-vc .mb-vc__pl svg{width:12px!important;height:12px!important;margin-left:2px!important}
.mb-vc .mb-vc__ars{gap:8px!important;margin-top:14px!important}
.mb-vc .mb-vc__ar{width:32px!important;height:32px!important;font-size:14px!important}
}
