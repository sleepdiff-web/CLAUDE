{%- comment -%}
  Selling Out Fast — urgency progress bar + countdown timer.
  Drop this file in your theme's /sections folder, then add it via
  Theme Customizer → Add section → "Selling out fast".
  Works as a standalone section or can be pasted into product-form.liquid.
{%- endcomment -%}

{%- liquid
  assign percent = section.settings.sold_percentage
  assign sold_text = section.settings.sold_label | replace: '{percent}', percent
-%}

<div
  class="sof"
  id="sof-{{ section.id }}"
  data-sof
  data-type="{{ section.settings.countdown_type }}"
  data-hours="{{ section.settings.evergreen_hours }}"
  data-minutes="{{ section.settings.evergreen_minutes }}"
  data-fixed="{{ section.settings.fixed_datetime }}"
  data-hide-expired="{{ section.settings.hide_when_expired }}"
  data-key="sof-end-{{ section.id }}"
>
  {%- if section.settings.heading != blank -%}
    <p class="sof__heading">{{ section.settings.heading }}</p>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p class="sof__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <div
    class="sof__track"
    role="progressbar"
    aria-label="{{ section.settings.heading | default: 'Selling out fast' }}"
    aria-valuenow="{{ percent }}"
    aria-valuemin="0"
    aria-valuemax="100"
  >
    <div class="sof__fill" style="width: {{ percent }}%;"></div>
  </div>

  <div class="sof__meta">
    <span class="sof__sold">{{ sold_text }}</span>
    <span class="sof__timer">
      {{ section.settings.ends_in_label }}
      <span class="sof__clock" data-sof-clock>--:--:--</span>
    </span>
  </div>
</div>

{% style %}
  #sof-{{ section.id }} {
    --sof-bar-color: {{ section.settings.bar_color }};
    --sof-track-color: {{ section.settings.track_color }};
    --sof-heading-color: {{ section.settings.heading_color }};
    --sof-text-color: {{ section.settings.text_color }};
    --sof-timer-color: {{ section.settings.timer_color }};

    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    font-family: inherit;
  }

  #sof-{{ section.id }} .sof__heading {
    margin: 0 0 4px;
    font-size: clamp(15px, 1.6vw, 17px);
    font-weight: 700;
    color: var(--sof-heading-color);
    line-height: 1.3;
  }

  #sof-{{ section.id }} .sof__subheading {
    margin: 0 0 14px;
    font-size: clamp(13px, 1.4vw, 14px);
    color: var(--sof-text-color);
    line-height: 1.4;
  }

  #sof-{{ section.id }} .sof__track {
    width: 100%;
    height: 8px;
    border-radius: 999px;
    background: var(--sof-track-color);
    overflow: hidden;
  }

  #sof-{{ section.id }} .sof__fill {
    height: 100%;
    border-radius: 999px;
    background: var(--sof-bar-color);
    transition: width 0.4s ease;
  }

  #sof-{{ section.id }} .sof__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 10px;
    font-size: clamp(13px, 1.4vw, 14px);
  }

  #sof-{{ section.id }} .sof__sold {
    color: var(--sof-text-color);
  }

  #sof-{{ section.id }} .sof__timer {
    font-weight: 700;
    color: var(--sof-timer-color);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  #sof-{{ section.id }} .sof__clock {
    font-variant-numeric: tabular-nums;
  }

  @media screen and (max-width: 749px) {
    #sof-{{ section.id }} .sof__meta {
      font-size: 13px;
    }
  }
{% endstyle %}

<script>
  (function () {
    var root = document.getElementById('sof-{{ section.id }}');
    if (!root || root.dataset.sofInit) return;
    root.dataset.sofInit = '1';

    var clockEl = root.querySelector('[data-sof-clock]');
    var type = root.dataset.type;
    var storageKey = root.dataset.key;
    var endTime;

    function pad(n) {
      return String(n).padStart(2, '0');
    }

    function getEvergreenEndTime() {
      var hours = parseInt(root.dataset.hours, 10) || 0;
      var minutes = parseInt(root.dataset.minutes, 10) || 0;
      var durationMs = (hours * 3600 + minutes * 60) * 1000;

      try {
        var stored = sessionStorage.getItem(storageKey);
        if (stored) {
          var storedEnd = parseInt(stored, 10);
          if (!isNaN(storedEnd) && storedEnd > Date.now()) {
            return storedEnd;
          }
        }
        var newEnd = Date.now() + durationMs;
        sessionStorage.setItem(storageKey, String(newEnd));
        return newEnd;
      } catch (e) {
        // sessionStorage unavailable (private mode, etc.) — fall back to a
        // fresh countdown every load.
        return Date.now() + durationMs;
      }
    }

    function getFixedEndTime() {
      var raw = root.dataset.fixed;
      if (!raw) return Date.now();
      var parsed = new Date(raw.trim().replace(' ', 'T'));
      return isNaN(parsed.getTime()) ? Date.now() : parsed.getTime();
    }

    endTime = type === 'fixed' ? getFixedEndTime() : getEvergreenEndTime();

    function render() {
      var remaining = endTime - Date.now();

      if (remaining <= 0) {
        clockEl.textContent = '00:00:00';
        clearInterval(timerId);
        if (root.dataset.hideExpired === 'true') {
          root.style.display = 'none';
        }
        return;
      }

      var totalSeconds = Math.floor(remaining / 1000);
      var hrs = Math.floor(totalSeconds / 3600);
      var mins = Math.floor((totalSeconds % 3600) / 60);
      var secs = totalSeconds % 60;

      clockEl.textContent = pad(hrs) + ':' + pad(mins) + ':' + pad(secs);
    }

    render();
    var timerId = setInterval(render, 1000);
  })();
</script>

{% schema %}
{
  "name": "Selling out fast",
  "tag": "section",
  "class": "shopify-section--selling-out-fast",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selling out fast"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Due to high demand, limited quantities available."
    },
    {
      "type": "text",
      "id": "sold_label",
      "label": "Sold label",
      "info": "Use {percent} as a placeholder for the sold percentage.",
      "default": "{percent}% sold"
    },
    {
      "type": "text",
      "id": "ends_in_label",
      "label": "Timer label",
      "default": "Ends in"
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "range",
      "id": "sold_percentage",
      "label": "Percent sold",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 89
    },
    {
      "type": "header",
      "content": "Countdown timer"
    },
    {
      "type": "select",
      "id": "countdown_type",
      "label": "Timer type",
      "options": [
        { "value": "evergreen", "label": "Evergreen (resets each new visitor session)" },
        { "value": "fixed", "label": "Fixed end date/time" }
      ],
      "default": "evergreen"
    },
    {
      "type": "range",
      "id": "evergreen_hours",
      "label": "Evergreen: hours",
      "min": 0,
      "max": 71,
      "step": 1,
      "default": 5,
      "info": "Only used when timer type is Evergreen."
    },
    {
      "type": "range",
      "id": "evergreen_minutes",
      "label": "Evergreen: minutes",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 2,
      "info": "Only used when timer type is Evergreen."
    },
    {
      "type": "text",
      "id": "fixed_datetime",
      "label": "Fixed: end date/time",
      "info": "Only used when timer type is Fixed. Format: YYYY-MM-DDTHH:MM, e.g. 2026-08-25T23:59 (visitor's local time).",
      "default": ""
    },
    {
      "type": "checkbox",
      "id": "hide_when_expired",
      "label": "Hide section when the timer reaches zero",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Progress bar fill",
      "default": "#c2911f"
    },
    {
      "type": "color",
      "id": "track_color",
      "label": "Progress bar track",
      "default": "#E5E7EB"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading text",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#4B5563"
    },
    {
      "type": "color",
      "id": "timer_color",
      "label": "Timer text",
      "default": "#1B5E3C"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 300,
      "max": 1400,
      "step": 10,
      "unit": "px",
      "default": 900
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Selling out fast"
    }
  ]
}
{% endschema %}
