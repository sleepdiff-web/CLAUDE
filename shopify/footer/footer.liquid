{%- comment -%}
  EDIT YOUR CONTENT BELOW.
  mb_logo: your logo image URL (Content > Files > copy link). Leave it empty to show your brand name as text.
  Links: one per line as  label | url  with @@ on its own line between links.
  Do not use | or a straight apostrophe (') inside the text (use &#39; instead).
  Payment icons and the copyright line fill in automatically from your store settings.
{%- endcomment -%}
{%- assign mb_brand = 'Your Brand' -%}
{%- assign mb_logo = '' -%}
{%- assign mb_tagline = 'Your tagline goes here. One short line about your brand.' -%}
{%- assign mb_email = 'support@yourstore.com' -%}
{%- assign mb_hours = 'Here for you 24/7. Evenings and weekends too.' -%}
{%- assign mb_phone = '(000) 000-0000' -%}
{%- assign mb_phone_link = '+10000000000' -%}
{%- assign mb_phone_note = 'Phone support available 8am to 4pm ET, Monday to Saturday. Outside these hours, leave a message and we&#39;ll call you back.' -%}
{%- assign mb_h1 = 'Quick Links' -%}
{%- capture mb_links1 -%}
Home | /
@@
Contact | /pages/contact
@@
Track My Order | /pages/track-my-order
{%- endcapture -%}
{%- assign mb_h2 = 'Policies' -%}
{%- capture mb_links2 -%}
Privacy Policy | /policies/privacy-policy
@@
Terms of Service | /policies/terms-of-service
@@
Refund Policy | /policies/refund-policy
@@
Shipping Policy | /policies/shipping-policy
{%- endcapture -%}
{%- assign mb_nl_heading = 'Join Our Email List' -%}
{%- assign mb_nl_text = 'Get our sale alerts, special offers, and simple tips. Nothing else.' -%}
{%- assign mb_nl_placeholder = 'Email address' -%}
{%- assign mb_nl_button = 'Sign Up' -%}
{%- assign mb_nl_fine = 'Unsubscribe anytime, no hard feelings.' -%}
{%- assign mb_nl_thanks = 'Thanks for subscribing!' -%}
{%- assign mb_disclosure = 'These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.' -%}
{%- assign mb_payments = true -%}
{%- assign mb_list1 = mb_links1 | split: '@@' -%}
{%- assign mb_list2 = mb_links2 | split: '@@' -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.page-width:has(>.mb-ft){max-width:none;padding:0}
.mb-ft{font-family:'Plus Jakarta Sans',sans-serif;font-size:15px;font-weight:500;line-height:1.8;letter-spacing:.6px}
@media screen and (min-width:750px){.mb-ft{font-size:16px}}
.mb-ft{background-color:#2b1c13;color:#fdf2e9;padding-top:30px;padding-bottom:0px}
@media screen and (min-width:750px){.mb-ft{padding-top:40px;padding-bottom:0px}}
.mb-ft .mb-ft__inner{max-width:1280px;margin:0 auto;padding:0 24px}
.mb-ft .mb-ft__grid{display:grid;grid-template-columns:1fr;grid-template-areas:"brand" "explore" "goodtoknow" "subscribe";gap:40px;text-align:left}
@media screen and (min-width:750px){.mb-ft .mb-ft__grid{grid-template-columns:minmax(240px,300px) 1fr 1fr minmax(280px,320px);grid-template-areas:"brand explore goodtoknow subscribe";column-gap:48px;align-items:start}}
.mb-ft .mb-ft__tagline p,.mb-ft .mb-ft__contact-hours p,.mb-ft .mb-ft__callback p,.mb-ft .mb-ft__newsletter-heading p,.mb-ft .mb-ft__newsletter-subtext p,.mb-ft .mb-ft__newsletter-fineprint p,.mb-ft .mb-ft__newsletter-success p,.mb-ft .mb-ft__link-heading p{margin:0}
.mb-ft .mb-ft__tagline a,.mb-ft .mb-ft__contact-hours a,.mb-ft .mb-ft__callback a,.mb-ft .mb-ft__newsletter-heading a,.mb-ft .mb-ft__newsletter-subtext a,.mb-ft .mb-ft__newsletter-fineprint a,.mb-ft .mb-ft__newsletter-success a,.mb-ft .mb-ft__link-heading a{color:#c47245;text-decoration:underline}
.mb-ft .mb-ft__tagline a:hover,.mb-ft .mb-ft__contact-hours a:hover,.mb-ft .mb-ft__callback a:hover,.mb-ft .mb-ft__newsletter-heading a:hover,.mb-ft .mb-ft__newsletter-subtext a:hover,.mb-ft .mb-ft__newsletter-fineprint a:hover,.mb-ft .mb-ft__newsletter-success a:hover,.mb-ft .mb-ft__link-heading a:hover{opacity:0.85}
.mb-ft .mb-ft__brand{grid-area:brand}
.mb-ft .mb-ft__logo-img{max-width:220px;width:100%;height:auto;display:inline-block}
.mb-ft .mb-ft__logo-text{font-size:22px;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;margin:0;color:#fdf2e9}
.mb-ft .mb-ft__tagline{margin:10px 0 0;font-size:13px;font-style:italic;line-height:1.6;color:#c9b8ab}
.mb-ft .mb-ft__brand-divider{border:none;border-top:1px solid #46362a;margin:18px 0}
.mb-ft .mb-ft__contact{display:flex;flex-direction:column;gap:10px}
.mb-ft .mb-ft__contact-row{display:flex;align-items:flex-start;gap:10px}
.mb-ft .mb-ft__contact-icon{flex-shrink:0;width:15px;height:15px;margin-top:2px;color:#c47245}
.mb-ft .mb-ft__contact a{font-size:14px;color:#c9b8ab;text-decoration:none;line-height:1.5}
.mb-ft .mb-ft__contact a:hover{color:#c47245}
.mb-ft .mb-ft__contact-hours{font-size:14px;line-height:1.5;color:#c9b8ab}
.mb-ft .mb-ft__callback{margin-top:16px;font-size:13px;line-height:1.55;color:#c9b8ab}
.mb-ft .mb-ft__col-explore{grid-area:explore}
.mb-ft .mb-ft__col-goodtoknow{grid-area:goodtoknow}
.mb-ft .mb-ft__link-heading{font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;margin:0 0 16px;color:#fdf2e9}
.mb-ft .mb-ft__rich-links p{margin:0 0 10px;font-size:14px;line-height:1.5;color:#c9b8ab}
.mb-ft .mb-ft__rich-links p:last-child{margin-bottom:0}
.mb-ft .mb-ft__rich-links a{color:#c9b8ab;text-decoration:none;transition:color 0.2s ease}
.mb-ft .mb-ft__rich-links a:hover{color:#c47245}
.mb-ft .mb-ft__rich-links strong{font-weight:700}
.mb-ft .mb-ft__subscribe{grid-area:subscribe}
@media screen and (min-width:750px){.mb-ft .mb-ft__subscribe{border-left:1px solid #46362a;padding-left:40px}
.mb-ft .mb-ft__col-explore,.mb-ft .mb-ft__col-goodtoknow,.mb-ft .mb-ft__subscribe{padding-top:12px}}
.mb-ft .mb-ft__newsletter-heading{font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;margin:0 0 10px;color:#fdf2e9}
.mb-ft .mb-ft__newsletter-subtext{font-size:14px;line-height:1.6;margin:0 0 18px;color:#c9b8ab}
.mb-ft .mb-ft__newsletter-form{display:flex;align-items:center;background-color:#ffffff;border-radius:999px;padding:6px 6px 6px 20px;gap:8px;max-width:420px}
.mb-ft .mb-ft__newsletter-form input[type="email"]{flex:1 1 auto;border:none;background:transparent;outline:none;font-size:15px;color:#1a1a1a;min-width:0}
.mb-ft .mb-ft__newsletter-form input[type="email"]::placeholder{color:#1a1a1a;opacity:0.55}
.mb-ft .mb-ft__newsletter-btn{flex-shrink:0;border:none;cursor:pointer;background-color:#c47245;color:#ffffff;font-size:14px;font-weight:700;padding:12px 22px;border-radius:999px;transition:opacity 0.2s ease,transform 0.2s ease}
.mb-ft .mb-ft__newsletter-btn:hover{opacity:0.9;transform:scale(1.02)}
.mb-ft .mb-ft__newsletter-fineprint{font-size:12px;line-height:1.5;margin-top:12px;color:#c9b8ab;opacity:0.8}
.mb-ft .mb-ft__newsletter-success{font-size:14px;margin-top:12px;color:#c47245}
.mb-ft .mb-ft__divider{border:none;border-top:1px solid #46362a;margin:44px 0}
.mb-ft .mb-ft__disclosure{font-size:12px;line-height:1.6;color:#c9b8ab;max-width:640px;margin:0;text-align:left}
.mb-ft .mb-ft__disclosure p{margin:0 0 6px}
.mb-ft .mb-ft__disclosure p:last-child{margin-bottom:0}
@media screen and (min-width:750px){.mb-ft .mb-ft__disclosure{max-width:100%}}
@media screen and (max-width:749px){.mb-ft .mb-ft__divider{margin:32px 0}
.mb-ft .mb-ft__newsletter-form{background-color:transparent;flex-direction:column;align-items:stretch;gap:12px;padding:0;border-radius:0;max-width:100%}
.mb-ft .mb-ft__newsletter-form input[type="email"]{width:100%;background-color:#ffffff;border:1.5px solid rgba(0,0,0,0.18);border-radius:999px;padding:14px 20px;box-sizing:border-box}
.mb-ft .mb-ft__newsletter-btn{width:100%;padding:14px 20px}}
@media screen and (min-width:750px) and (max-width:847px){.mb-ft .mb-ft__grid{grid-template-columns:1fr 1fr;grid-template-areas:"brand subscribe" "explore goodtoknow";row-gap:40px}}
.mb-ft .mb-ft__bottom{padding-top:30px;text-align:center}
.mb-ft .mb-ft__pay{display:flex;flex-wrap:wrap;justify-content:center;margin:10px 0 0;padding:0;list-style:none}
.mb-ft .mb-ft__pay li{display:flex;align-items:center;padding:5px}
.mb-ft .mb-ft__pay svg{display:block;width:38px;height:24px}
.mb-ft .mb-ft__copy{margin:10px 0 0;font-size:12px;line-height:1.7;letter-spacing:.7px;color:#c9b8ab;opacity:.75}
.mb-ft .mb-ft__copy a{color:inherit;text-decoration:none}
</style>

<footer class="mb-ft"><div class="mb-ft__inner"><div class="mb-ft__grid">
<div class="mb-ft__brand">{%- if mb_logo != blank -%}<img class="mb-ft__logo-img" src="{{ mb_logo }}{% if mb_logo contains '?' %}&amp;{% else %}?{% endif %}width=400" alt="{{ mb_brand | escape }}" loading="lazy" decoding="async" width="220">{%- else -%}<p class="mb-ft__logo-text">{{ mb_brand }}</p>{%- endif -%}
<div class="mb-ft__tagline"><p>{{ mb_tagline }}</p></div><hr class="mb-ft__brand-divider">
<div class="mb-ft__contact">
<div class="mb-ft__contact-row"><svg class="mb-ft__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16v12H4z"/><path d="M4 7l8 6 8-6"/></svg><a href="mailto:{{ mb_email }}">{{ mb_email }}</a></div>
<div class="mb-ft__contact-row"><svg class="mb-ft__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg><div class="mb-ft__contact-hours"><p>{{ mb_hours }}</p></div></div>
</div>
<div class="mb-ft__contact-row mb-ft__callback"><svg class="mb-ft__contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div><p><a href="tel:{{ mb_phone_link }}">{{ mb_phone }}</a><br>{{ mb_phone_note }}</p></div></div></div>
<div class="mb-ft__col-explore"><div class="mb-ft__link-heading"><p>{{ mb_h1 }}</p></div><div class="mb-ft__rich-links">{%- for l in mb_list1 -%}{%- assign lf = l | split: '|' -%}<p><a href="{{ lf[1] | strip }}">{{ lf[0] | strip }}</a></p>{%- endfor -%}</div></div>
<div class="mb-ft__col-goodtoknow"><div class="mb-ft__link-heading"><p>{{ mb_h2 }}</p></div><div class="mb-ft__rich-links">{%- for l in mb_list2 -%}{%- assign lf = l | split: '|' -%}<p><a href="{{ lf[1] | strip }}">{{ lf[0] | strip }}</a></p>{%- endfor -%}</div></div>
<div class="mb-ft__subscribe"><div class="mb-ft__newsletter-heading"><p>{{ mb_nl_heading }}</p></div><div class="mb-ft__newsletter-subtext"><p>{{ mb_nl_text }}</p></div>
{%- form 'customer', id: 'mb-ft-form' -%}
<input type="hidden" name="contact[tags]" value="newsletter">
<div class="mb-ft__newsletter-form"><input type="email" name="contact[email]" placeholder="{{ mb_nl_placeholder }}" required aria-label="{{ mb_nl_placeholder }}"><button type="submit" class="mb-ft__newsletter-btn">{{ mb_nl_button }}</button></div>
{%- if form.posted_successfully? -%}<div class="mb-ft__newsletter-success"><p>{{ mb_nl_thanks }}</p></div>{%- endif -%}
{%- if form.errors -%}<div class="mb-ft__newsletter-success"><p>{{ form.errors | default_errors }}</p></div>{%- endif -%}
{%- endform -%}
<div class="mb-ft__newsletter-fineprint"><p>{{ mb_nl_fine }}</p></div></div>
</div><hr class="mb-ft__divider">
<div class="mb-ft__disclosure"><p><strong>Disclosure:</strong> <em>{{ mb_disclosure }}</em></p></div></div>
<div class="mb-ft__bottom">
{%- if mb_payments and shop.enabled_payment_types.size > 0 -%}<ul class="mb-ft__pay" role="list" aria-label="Payment methods">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>{%- endfor -%}</ul>{%- endif -%}
<p class="mb-ft__copy">&copy; {{ 'now' | date: '%Y' }}, <a href="{{ routes.root_url }}">{{ shop.name }}</a></p>
</div></footer>
