<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400&display=swap" rel="stylesheet">

<style>
  /* Full-width: remove the theme's page-width container around this block */
  .page-width:has(> .marquee-wrapper) { max-width: none; padding: 0; }

  /* Desktop */
  .marquee-wrapper { display: flex; align-items: center; box-sizing: border-box; width: 100%; height: 26px; overflow: hidden; background: #C47245; }
  .marquee-track { display: flex; align-items: center; flex-shrink: 0; width: max-content; color: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; animation: marquee-scroll 20s linear infinite; will-change: transform; }
  .marquee-item { display: flex; align-items: center; flex-shrink: 0; gap: 6px; padding: 0 50px; white-space: nowrap; }
  .marquee-icon { display: block; flex-shrink: 0; width: auto; height: 14px; }
  .marquee-text { margin: 0; font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: 0.2px; text-transform: none; color: #FFFFFF; }

  /* One set of 4 messages = 12.5% of the track (the set is repeated 8x so wide screens never run out) */
  @keyframes marquee-scroll { from { transform: translateX(0); } to { transform: translateX(-12.5%); } }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }

  /* Mobile */
  @media screen and (max-width: 749px) {
    .marquee-wrapper { height: 28px; }
    .marquee-item { padding: 0 25px; }
    .marquee-text { font-size: 12px; line-height: 18px; letter-spacing: 0.3px; }
  }
</style>

<div class="marquee-wrapper">
  <div class="marquee-track">
    {%- for i in (1..8) -%}

      <div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        <svg class="marquee-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 .9 1.4 3v4.2c0 3 2.3 5.1 5.6 6.1 3.3-1 5.6-3.1 5.6-6.1V3L7 .9Z"/><path d="m4.4 7.1 2 2 3.3-3.800"/></svg>
        <span class="marquee-text">90-Day Money-Back Guarantee</span>
      </div>

      <div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        <svg class="marquee-icon" width="11" height="14" viewBox="0 0 11 14" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><g transform="translate(5.5 7) rotate(60)"><path d="M-5.6 0-2.7-2.8H4.6a1 1 0 0 1 1 1v3.6a1 1 0 0 1-1 1H-2.7ZM-2.7-.9a.9.9 0 1 0 0 1.800.9.9 0 0 0 0-1.800Z"/></g></svg>
        <span class="marquee-text">Subscribe &amp; Save</span>
      </div>

      <div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        <svg class="marquee-icon" width="13" height="14" viewBox="0 0 13 14" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="4.2" r="2.2"/><path d="M.9 12.9c0-2.5 1.8-4.3 4.1-4.3s4.1 1.8 4.1 4.3Z"/><circle cx="10" cy="7" r="1.6" fill="currentColor" stroke="none"/><path d="M7.4 12.9c.1-1.7 1.2-2.9 2.6-2.9s2.5 1.2 2.6 2.9Z" fill="currentColor" stroke="none"/></svg>
        <span class="marquee-text">Buy 2 Get 1 Free</span>
      </div>

      <div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        <svg class="marquee-icon" width="13" height="14" viewBox="0 0 13 14" fill="currentColor" fill-rule="evenodd" aria-hidden="true"><path d="M6.5 0.5 L7.3 0.8 L8.1 1.2 L8.7 1.6 L9.5 1.8 L10.3 2.0 L11.1 2.4 L11.5 3.2 L11.7 4.0 L11.9 4.8 L12.3 5.4 L12.7 6.2 L12.9 7.0 L12.7 7.8 L12.3 8.6 L11.9 9.2 L11.7 10.0 L11.5 10.8 L11.1 11.6 L10.3 12.0 L9.5 12.2 L8.7 12.4 L8.1 12.8 L7.3 13.2 L6.5 13.4 L5.7 13.2 L4.9 12.8 L4.3 12.4 L3.5 12.2 L2.7 12.0 L1.9 11.6 L1.5 10.8 L1.3 10.0 L1.1 9.2 L0.7 8.6 L0.3 7.8 L0.0 7.0 L0.3 6.2 L0.7 5.4 L1.1 4.8 L1.3 4.0 L1.5 3.2 L1.9 2.4 L2.7 2.0 L3.5 1.8 L4.3 1.6 L4.9 1.2 L5.7 0.8ZM4.6 3.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM8.4 7.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM8.9 3.5l.9.7-4.6 6.3-.9-.7 4.6-6.3Z"/></svg>
        <span class="marquee-text">Up To 70% Off</span>
      </div>

    {%- endfor -%}
  </div>
</div>
