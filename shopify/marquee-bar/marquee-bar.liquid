<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Poppins:wght@400;500;600&display=swap"></noscript>

<style>
.page-width:has(>.marquee-wrapper){max-width:none;padding:0}
.marquee-wrapper{box-sizing:border-box;width:100%;overflow:hidden;padding:4px 0;background:#c47245;font-family:'Plus Jakarta Sans',system-ui,sans-serif;font-weight:500;letter-spacing:.6px;contain:content}
.marquee-track{display:flex;align-items:center;width:max-content;color:#fff;animation:marquee-scroll 8.2s linear infinite;will-change:transform}
.marquee-item{display:flex;align-items:center;flex-shrink:0;gap:4px;padding:0 25px;white-space:nowrap}
.marquee-icon{display:block;flex-shrink:0;width:14px;height:14px}
.marquee-text{margin:0;font-size:11.4px;font-weight:400;line-height:20px;text-transform:none;color:#fff}
@keyframes marquee-scroll{to{transform:translateX(calc(-100%/6))}}
@media screen and (min-width:768px){.marquee-item{padding:0 50px}}
@media screen and (min-width:770px){.marquee-text{font-size:13.3px}}
</style>

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
<g id="mq-shield" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"><path d="M7 .9 1.4 3v4.2c0 3 2.3 5.1 5.6 6.1 3.3-1 5.6-3.1 5.6-6.1V3L7 .9Z"/><path d="m4.4 7.1 2 2 3.3-3.8"/></g>
<g id="mq-tag" fill="currentColor" fill-rule="evenodd"><g transform="translate(7 7) rotate(60)"><path d="M-5.6 0-2.7-2.8H4.6a1 1 0 0 1 1 1v3.6a1 1 0 0 1-1 1H-2.7ZM-2.7-.9a.9.9 0 1 0 0 1.8.9.9 0 0 0 0-1.8Z"/></g></g>
<g id="mq-people" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" transform="translate(.5 0)"><circle cx="5" cy="4.2" r="2.2"/><path d="M.9 12.9c0-2.5 1.8-4.3 4.1-4.3s4.1 1.8 4.1 4.3Z"/><circle cx="10" cy="7" r="1.6" fill="currentColor" stroke="none"/><path d="M7.4 12.9c.1-1.7 1.2-2.9 2.6-2.9s2.5 1.2 2.6 2.9Z" fill="currentColor" stroke="none"/></g>
<g id="mq-badge" fill="currentColor" fill-rule="evenodd" transform="translate(.5 0)"><path d="M6.5.5 8.1 1.2 9.5 1.8 11.1 2.4 11.7 4 12.3 5.4 12.9 7 12.3 8.6 11.7 10 11.1 11.6 9.5 12.2 8.1 12.8 6.5 13.4 4.9 12.8 3.5 12.2 1.9 11.6 1.3 10 .7 8.6 0 7 .7 5.4 1.3 4 1.9 2.4 3.5 1.8 4.9 1.2ZM4.6 3.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM8.4 7.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM8.9 3.5l.9.7-4.6 6.3-.9-.7 4.6-6.3Z"/></g>
</defs></svg>

<div class="marquee-wrapper"><div class="marquee-track">
{%- for i in (1..6) -%}
<div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}><svg class="marquee-icon" viewBox="0 0 14 14" aria-hidden="true"><use href="#mq-shield"/></svg><span class="marquee-text">90-Day Money-Back Guarantee</span></div>
<div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}><svg class="marquee-icon" viewBox="0 0 14 14" aria-hidden="true"><use href="#mq-tag"/></svg><span class="marquee-text">Subscribe &amp; Save</span></div>
<div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}><svg class="marquee-icon" viewBox="0 0 14 14" aria-hidden="true"><use href="#mq-people"/></svg><span class="marquee-text">Buy 2 Get 1 Free</span></div>
<div class="marquee-item"{% unless forloop.first %} aria-hidden="true"{% endunless %}><svg class="marquee-icon" viewBox="0 0 14 14" aria-hidden="true"><use href="#mq-badge"/></svg><span class="marquee-text">Up To 70% Off</span></div>
{%- endfor -%}
</div></div>

<script>
(function(){
var w=document.currentScript.previousElementSibling,t=w&&w.firstElementChild;
if(!t||t.children.length<5)return;
function set(){var P=t.children[4].offsetLeft-t.children[0].offsetLeft;if(P>0)t.style.animationDuration=(32*P/w.clientWidth)+'s'}
set();
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(set);
var rt;addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(set,150)},{passive:true});
})();
</script>
